{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "* 0-3 3-30/3 * *"
  ],
  "updateNotScheduled": false,
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 1,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "lockFileMaintenance": {
    "enabled": false,
    "schedule": [
      "* 0-3 3-30/3 * *"
    ],
    "updateNotScheduled": false
  },
  "packageRules": [
    {
      "description": "Collect all ordinary dependency updates into one scheduled batch; retain inherited per-update review and release-age rules.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "Dependency update batch",
      "groupSlug": "dependency-update-batch",
      "schedule": [
        "* 0-3 3-30/3 * *"
      ],
      "timezone": "Etc/UTC",
      "updateNotScheduled": false,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false
    }
  ]
}
