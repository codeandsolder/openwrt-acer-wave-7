@@ -2559,6 +2568,19 @@
 	/* secondary is link[1] */
 	if (mld->link_num > 1)
 		mld->secondary_id = mld->link[1].wlan_id;
+
+	/* Lab experiment: the firmware's primary MLD role may describe
+	 * the hardware band rather than the over-air association link.
+	 * Keep setup WLAN ID and all host-side link/key ownership intact.
+	 */
+	if (is_mt7925(&mvif->phy->dev->mt76) &&
