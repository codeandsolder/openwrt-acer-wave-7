+	    band0 != U16_MAX && band1 != U16_MAX && band0 != band1) {
+		if (le16_to_cpu(mld->link[1].wlan_id) == band0)
+			swap(mld->link[0], mld->link[1]);
+		mld->primary_id = cpu_to_le16(band0);
+		mld->secondary_id = cpu_to_le16(band1);
+	}
 	for (i = 0; i < mld->link_num; i++)
 		trace_mt7925_lab_sta_mld_slot(mlink ? mlink->wcid.idx : U16_MAX,
 			le16_to_cpu(mld->primary_id), le16_to_cpu(mld->secondary_id),
