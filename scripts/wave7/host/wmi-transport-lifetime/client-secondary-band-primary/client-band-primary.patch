--- a/mt7925/mcu.c
+++ b/mt7925/mcu.c
@@ -2506,6 +2506,7 @@
 	struct mt792x_link_sta *pri_mlink;
 	struct sta_rec_mld *mld;
 	unsigned int i, cnt = 0;
+	u16 band0 = U16_MAX, band1 = U16_MAX;
 	struct tlv *tlv;
 
 	tlv = mt76_connac_mcu_add_tlv(skb, STA_REC_MLD, sizeof(*mld));
@@ -2545,6 +2546,14 @@
 
 		mconf = mt792x_vif_to_link(mvif, i);
 		bss_idx = mconf->mt76.idx;
+		switch (READ_ONCE(mconf->mt76.band_idx)) {
+		case 0:
+			band0 = mlink_i->wcid.idx;
+			break;
+		case 1:
+			band1 = mlink_i->wcid.idx;
+			break;
+		}
 
 		/* insertion sort by bss_idx, at most 3 links */
