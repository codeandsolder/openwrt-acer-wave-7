+static int mt7925_lab_mld_decode(const u8 *data, size_t len,
+				 struct mt7925_lab_mld_record *record)
+{
+	const struct tlv *tlv;
+	u32 rem;
+	bool found = false;
+
+	static_assert(sizeof(*record) == 196);
+	static_assert(sizeof(record->link[0]) == 90);
+	static_assert(offsetof(struct mt7925_lab_mld_record, link) == 16);
+	if (len < 4 || len - 4 > U32_MAX)
+		return -EPROTO;
+	rem = len - 4;
+	tlv = (const void *)(data + 4);
+	while (rem) {
+		u16 size;
+
+		if (!mt7925_mcu_tlv_valid(tlv, rem))
+			return -EPROTO;
+		size = le16_to_cpu(tlv->len);
+		if (le16_to_cpu(tlv->tag) == 2) {
+			if (found || size != sizeof(*tlv) + sizeof(*record))
+				return -EPROTO;
+			memcpy(record, tlv + 1, sizeof(*record));
+			if (record->index != 0)
+				return -EPROTO;
+			found = true;
+		}
+		rem -= size;
+		tlv = (const void *)((const u8 *)tlv + size);
+	}
+	return found ? 0 : -ENODATA;
+}
+
+int mt7925_lab_mld_get_record(struct mt792x_dev *dev,
+			     struct mt7925_lab_mld_record *record)
+{
+	struct {
+		u8 reserved[4];
+		__le16 tag, len;
+		__le32 index;
+	} __packed req = {
+		.tag = cpu_to_le16(2),
+		.len = cpu_to_le16(8),
+		.index = cpu_to_le32(0),
+	};
+	struct sk_buff *skb = NULL;
+	int ret;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!is_mt7925(&dev->mt76) || !mt76_is_mmio(&dev->mt76))
+		return -EOPNOTSUPP;
+	ret = mt76_mcu_send_and_get_msg(&dev->mt76,
+					MCU_WM_UNI_CMD_QUERY(MLO),
+					&req, sizeof(req), true, &skb);
+	if (!ret)
+		ret = skb ? mt7925_lab_mld_decode(skb->data, skb->len, record) :
+			-ENODATA;
 	dev_kfree_skb(skb);
 	return ret;
 }
