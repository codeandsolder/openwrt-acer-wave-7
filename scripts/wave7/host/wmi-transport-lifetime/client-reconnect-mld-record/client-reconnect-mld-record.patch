+static void mt7925_lab_mld_snapshot(struct mt792x_dev *dev,
+				    struct ieee80211_vif *vif, u8 stage)
+{
+	struct mt7925_lab_mld_record r;
+	unsigned int i;
+	int ret;
+
+	if (!trace_mt7925_lab_mld_record_result_enabled() ||
+	    vif->type != NL80211_IFTYPE_STATION ||
+	    !ieee80211_vif_is_mld(vif))
+		return;
+
+	ret = mt7925_lab_mld_get_record(dev, &r);
+	trace_mt7925_lab_mld_record_result(stage, ret);
+	if (ret)
+		return;
+	trace_mt7925_lab_mld_record(stage, r.state, r.index,
+		le16_to_cpu(r.mld), le16_to_cpu(r.primary),
+		le16_to_cpu(r.secondary), r.all_str, r.str_bitmap,
+		r.emlsr_bitmap, r.active_count, r.active_bitmap);
+	for (i = 0; i < ARRAY_SIZE(r.link); i++) {
+		const struct mt7925_lab_mld_record_link *l = &r.link[i];
+
+		trace_mt7925_lab_mld_record_link(stage, i, l->active,
+			l->suspended, l->parent, l->band, le16_to_cpu(l->wcid));
+	}
+}
