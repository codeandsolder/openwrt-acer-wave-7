--- a/mt7925/main.c
+++ b/mt7925/main.c
@@ -3090,10 +3090,31 @@
 				goto out;
 		}
 		if (add) {
+			struct mt792x_vif *mvif = (void *)vif->drv_priv;
 			struct mt7925_set_links_key_iter it = {
 				.sta = sta,
 				.links = add,
 			};
+			unsigned int link_id;
+
+			/* Like BSS_CHANGED_ASSOC for the setup link, explicitly
+			 * configure each new link's group receive STAREC before
+			 * installing keys. Hardware-translated group frames have
+			 * no peer WCID and cannot use mac80211's 802.3 RX path.
+			 */
+			for_each_set_bit(link_id, &add, IEEE80211_MLD_MAX_NUM_LINKS) {
+				struct mt792x_link_sta *owner;
+
+				owner = mt792x_sta_to_link(&mvif->sta, link_id);
+				if (!owner || owner->wcid.sta) {
+					err = -EINVAL;
+					goto out;
+				}
+				err = mt7925_mcu_sta_update(dev, NULL, vif, owner,
+							   true, MT76_STA_INFO_STATE_ASSOC);
+				if (err)
+					goto out;
+			}
 
 			ieee80211_iter_keys(hw, vif, mt7925_set_links_key_iter,
 					     &it);
