+/* Program MLD membership before negotiating the affiliated ROC bands.
+ * Do not rewrite BASIC, timing, keys or the existing primary STAREC.
+ */
+int mt7925_mcu_presetup_bss_mld(struct mt792x_dev *dev,
+			       struct ieee80211_bss_conf *link_conf)
+{
+	struct mt792x_bss_conf *mconf = mt792x_link_conf_to_mconf(link_conf);
+	struct sk_buff *skb;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!mconf->dev_active || !link_conf->chanreq.oper.chan)
+		return -EINVAL;
+	skb = __mt7925_mcu_alloc_bss_req(&dev->mt76, &mconf->mt76,
+					 sizeof(struct bss_req_hdr) +
+					 sizeof(struct bss_mld_tlv));
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+
+	mt7925_mcu_bss_mld_tlv(skb, link_conf);
+	return mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				    MCU_UNI_CMD(BSS_INFO_UPDATE), true);
+}
