+/* Management metadata only. The skb cookie correlates host submission and
+ * actual firmware completion without requesting additional TX statuses.
+ */
+TRACE_EVENT(mt7925_lab_mgmt_txd,
+	TP_PROTO(const void *cookie, u16 fc, u16 seq, u8 requested,
+		 u16 wcid, u8 link, u8 band, const u8 *addresses,
+		 const __le32 *txd),
+	TP_ARGS(cookie, fc, seq, requested, wcid, link, band, addresses, txd),
+	TP_STRUCT__entry(
+		__field(const void *, cookie)
+		__field(u16, fc)
+		__field(u16, seq)
+		__field(u8, requested)
+		__field(u16, wcid)
+		__field(u8, link)
+		__field(u8, band)
+		__array(u8, addresses, 18)
+		__array(u32, txd, 6)
+	),
+	TP_fast_assign(
+		__entry->cookie = cookie;
+		__entry->fc = fc;
+		__entry->seq = seq;
+		__entry->requested = requested;
+		__entry->wcid = wcid;
+		__entry->link = link;
+		__entry->band = band;
+		memcpy(__entry->addresses, addresses, 18);
+		__entry->txd[0] = le32_to_cpu(txd[0]);
+		__entry->txd[1] = le32_to_cpu(txd[1]);
+		__entry->txd[2] = le32_to_cpu(txd[2]);
+		__entry->txd[3] = le32_to_cpu(txd[3]);
+		__entry->txd[4] = le32_to_cpu(txd[5]) & 0xffff;
+		__entry->txd[5] = le32_to_cpu(txd[6]);
+	),
+	TP_printk("cookie=%p fc=0x%04x seq=%u requested=%u wcid=%u link=%u band=%u a1=%pM a2=%pM a3=%pM d0=%08x d1=%08x d2=%08x d3=%08x d5=%08x d6=%08x",
+		  __entry->cookie, __entry->fc, __entry->seq,
+		  __entry->requested, __entry->wcid, __entry->link,
+		  __entry->band, __entry->addresses, __entry->addresses + 6,
+		  __entry->addresses + 12, __entry->txd[0], __entry->txd[1],
+		  __entry->txd[2], __entry->txd[3], __entry->txd[4],
+		  __entry->txd[5])
+);
+
