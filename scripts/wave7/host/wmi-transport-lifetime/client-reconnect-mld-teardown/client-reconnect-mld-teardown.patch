+/* Explicit group teardown while the firmware peer and BSS still exist.
+ * Vendor nicUniCmdMldStaTeardown sends this standalone tag.
+ */
+int mt7925_mcu_sta_mld_teardown(struct mt792x_dev *dev,
+			       struct mt792x_bss_conf *mconf,
+			       struct mt792x_link_sta *mlink)
+{
+	struct sk_buff *skb;
+	int ret;
+
+	skb = __mt76_connac_mcu_alloc_sta_req(&dev->mt76, &mconf->mt76,
+					      &mlink->wcid,
+					      MT7925_STA_UPDATE_MAX_SIZE);
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+
+	mt76_connac_mcu_add_tlv(skb, STA_REC_MLD_OFF, sizeof(struct tlv));
+	ret = mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				    MCU_UNI_CMD(STA_REC_UPDATE), true);
+	trace_mt7925_lab_sta_mld_teardown(mlink->wcid.idx, mconf->mt76.idx, ret);
+	return ret;
+}
