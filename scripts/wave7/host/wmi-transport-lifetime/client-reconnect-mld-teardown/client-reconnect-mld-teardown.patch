+/* Tear down the complete group once, addressed to its firmware primary.
+ * Partial link removal must not tear down the surviving group's state.
+ */
+static int mt7925_sta_mld_teardown(struct mt792x_dev *dev,
+				  struct ieee80211_vif *vif,
+				  struct mt792x_sta *msta)
+{
+	unsigned long links = msta->valid_links;
+	struct mt792x_vif *mvif = msta->vif;
+	struct mt792x_link_sta *primary;
+	struct mt792x_bss_conf *mconf;
+	unsigned int link;
+	u8 band0 = IEEE80211_LINK_UNSPECIFIED;
+	u8 band1 = IEEE80211_LINK_UNSPECIFIED;
+	u8 primary_id = msta->deflink_id;
+	int ret;
+
+	/* Match the two-band role ordering in mt7925_mcu_sta_mld_tlv,
+	 * preserving the distinct over-air setup link.
+	 */
+	if (is_mt7925(&dev->mt76) && hweight16(links) == 2) {
+		for_each_set_bit(link, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+			mconf = mt792x_vif_to_link(mvif, link);
+			if (!mconf || !mt792x_sta_to_link(msta, link))
+				return -ENOLINK;
+			if (mconf->mt76.band_idx == 0)
+				band0 = link;
+			else if (mconf->mt76.band_idx == 1)
+				band1 = link;
+		}
+		if (band0 != IEEE80211_LINK_UNSPECIFIED &&
+		    band1 != IEEE80211_LINK_UNSPECIFIED)
+			primary_id = band0;
+	}
+	if (primary_id >= IEEE80211_MLD_MAX_NUM_LINKS ||
+	    !(links & BIT(primary_id)))
+		return -ENOLINK;
+
+	mconf = mt792x_vif_to_link(mvif, primary_id);
+	primary = mt792x_sta_to_link(msta, primary_id);
+	if (!mconf || !primary || !primary->wcid.sta)
+		return -ENOLINK;
+
+	mt7925_lab_wtbl_snapshot(dev, vif, msta, MT7925_LAB_WTBL_PRE_TEARDOWN);
+	ret = mt7925_mcu_sta_mld_teardown(dev, mconf, primary);
+	mt7925_lab_wtbl_snapshot(dev, vif, msta, MT7925_LAB_WTBL_POST_TEARDOWN);
+	return ret;
+}
