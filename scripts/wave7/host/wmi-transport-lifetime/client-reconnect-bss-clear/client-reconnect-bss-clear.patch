+/* Vendor cnmStaFreeAllStaByNetwork sends STA_REC_REMOVE action BSS
+ * after network deactivation. The WLAN index is ignored for this action.
+ * This is not a device-wide purge.
+ */
+int mt7925_lab_sta_clear_bss(struct mt792x_dev *dev,
+			    struct mt792x_bss_conf *mconf)
+{
+	struct sta_req_hdr *hdr;
+	struct sta_rec_remove *rem;
+	struct sk_buff *skb;
+	int ret;
+
+	if (WARN_ON_ONCE(mconf->dev_active))
+		return -EBUSY;
+
+	skb = __mt76_connac_mcu_alloc_sta_req(&dev->mt76, &mconf->mt76,
+					      NULL, MT7925_STA_UPDATE_MAX_SIZE);
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+
+	hdr = (void *)skb->data;
+	hdr->wlan_idx_lo = to_wcid_lo(0x7ff);
+	hdr->wlan_idx_hi = to_wcid_hi(0x7ff);
+	rem = (void *)mt76_connac_mcu_add_tlv(skb, STA_REC_REMOVE,
+					     sizeof(*rem));
+	rem->action = 1; /* STA_REC_CMD_ACTION_BSS */
+	ret = mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				    MCU_UNI_CMD(STA_REC_UPDATE), true);
+	trace_mt7925_lab_sta_result(0x7ff, mconf->mt76.idx,
+				    mconf->link_id, false, MT76_STA_INFO_STATE_NONE, ret);
+	return ret;
+}
