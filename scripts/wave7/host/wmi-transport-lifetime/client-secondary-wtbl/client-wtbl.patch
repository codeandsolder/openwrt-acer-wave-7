+/* MT7925 LWTBL peer metadata only (no key table or packet numbers). */
+TRACE_EVENT(mt7925_lab_wtbl_peer,
+	TP_PROTO(u8 stage, u16 wcid, u8 link, u8 bss, u8 host_band,
+		 u32 dw0, u32 dw1, u32 cipher, u32 dw28, u32 mld),
+	TP_ARGS(stage, wcid, link, bss, host_band, dw0, dw1, cipher, dw28, mld),
+	TP_STRUCT__entry(
+		__field(u8, stage)
+		__field(u16, wcid)
+		__field(u8, link)
+		__field(u8, bss)
+		__field(u8, host_band)
+		__field(u32, dw0)
+		__field(u32, dw1)
+		__field(u32, cipher)
+		__field(u32, dw28)
+		__field(u32, mld)
+	),
+	TP_fast_assign(
+		__entry->stage = stage;
+		__entry->wcid = wcid;
+		__entry->link = link;
+		__entry->bss = bss;
+		__entry->host_band = host_band;
+		__entry->dw0 = dw0;
+		__entry->dw1 = dw1;
+		__entry->cipher = cipher;
+		__entry->dw28 = dw28;
+		__entry->mld = mld;
+	),
+	TP_printk("stage=%u wcid=%u link=%u bss=%u host_band=%u dw0=0x%08x dw1=0x%08x cipher=%u dw28=0x%08x mld=%u",
+		  __entry->stage, __entry->wcid, __entry->link, __entry->bss,
+		  __entry->host_band, __entry->dw0, __entry->dw1,
+		  __entry->cipher, __entry->dw28, __entry->mld)
+);
