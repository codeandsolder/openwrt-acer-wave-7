+enum mt7925_lab_wtbl_stage {
+	MT7925_LAB_WTBL_KEY = 1,
+	MT7925_LAB_WTBL_PRE_REFRESH,
+	MT7925_LAB_WTBL_POST_REFRESH,
+	MT7925_LAB_WTBL_POST_ADD,
+	MT7925_LAB_WTBL_POST_ASSOC,
+	MT7925_LAB_WTBL_POST_MLD,
+	MT7925_LAB_WTBL_POST_KEYS,
+};
+
+/*
+ * MT7925 CODA wf_ds_lwtbl.h: DW0/1 peer address and MUAR/band,
+ * DW2 bits 20:16 cipher, DW28 related peer indices and bands,
+ * DW29 bits 21:16 own MLD ID. Never access UWTBL or key memory.
+ * All supported MT7925 WCIDs are in LWTBL group zero, including
+ * those read by the concurrent TX completion polling path.
+ */
+static void
+mt7925_lab_wtbl_snapshot(struct mt792x_dev *dev, struct ieee80211_vif *vif,
+			struct mt792x_sta *msta, u8 stage)
+{
+	unsigned long links = msta->valid_links;
+	unsigned int link;
+
+	if (!trace_mt7925_lab_wtbl_peer_enabled() ||
+	    !is_mt7925(&dev->mt76) || !mt76_is_mmio(&dev->mt76) ||
+	    !ieee80211_vif_is_mld(vif))
+		return;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	for_each_set_bit(link, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		struct mt792x_bss_conf *mconf;
+		struct mt792x_link_sta *mlink;
+		u32 addr, dw0, dw1, cipher, dw28, mld;
+		u16 idx;
+
+		mlink = mt792x_sta_to_link(msta, link);
+		mconf = mt792x_vif_to_link(msta->vif, link);
+		if (!mlink || !mconf || !mlink->wcid.sta)
+			continue;
+		idx = mlink->wcid.idx;
+		if (idx >= MT792x_WTBL_SIZE)
+			continue;
+		addr = mt7925_mac_wtbl_lmac_addr(dev, idx, 0);
+		dw0 = mt76_rr(dev, addr);
+		dw1 = mt76_rr(dev, addr + 4);
+		cipher = FIELD_GET(GENMASK(20, 16), mt76_rr(dev, addr + 8));
+		dw28 = mt76_rr(dev, addr + 28 * 4);
+		mld = FIELD_GET(GENMASK(21, 16), mt76_rr(dev, addr + 29 * 4));
+		trace_mt7925_lab_wtbl_peer(stage, idx, link, mconf->mt76.idx,
+					  mconf->mt76.band_idx, dw0, dw1,
+					  cipher, dw28, mld);
+	}
+}
