+/* Vendor nicUniCmdSetBssMld uses this standalone BSS_INFO_MLD format.
+ * A detached BSS carries its own identity, not its former group address.
+ */
+int mt7925_lab_bss_detach_active(struct mt792x_dev *dev,
+				struct ieee80211_bss_conf *link_conf,
+				struct mt792x_bss_conf *mconf)
+{
+	struct mt76_connac_bss_mld_tlv *mld;
+	struct sk_buff *skb;
+	int ret;
+
+	skb = __mt7925_mcu_alloc_bss_req(&dev->mt76, &mconf->mt76,
+					 sizeof(struct bss_req_hdr) + sizeof(*mld));
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+	mld = (void *)mt76_connac_mcu_add_tlv(skb, UNI_BSS_INFO_MLD,
+					     sizeof(*mld));
+	mld->group_mld_id = 0xff;
+	mld->own_mld_id = mconf->mt76.idx + 32;
+	mld->remap_idx = 0xff;
+	mld->link_id = 0xff;
+	memcpy(mld->mac_addr, link_conf->addr, ETH_ALEN);
+	ret = mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				    MCU_UNI_CMD(BSS_INFO_UPDATE), true);
+	trace_mt7925_lab_group_detach_active(mconf->mt76.idx,
+					     link_conf->link_id,
+					     mconf->dev_active, ret);
+	return ret;
+}
