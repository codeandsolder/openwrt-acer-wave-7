+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	struct mt792x_bss_conf *mconf;
+	struct sk_buff *skb;
+
+	mconf = mt792x_vif_to_link(mvif, mlink->wcid.link_id);
