+/* Lab-only MAC-header metadata; never capture frame bodies. */
+TRACE_EVENT(mt7925_lab_rx_header,
+	TP_PROTO(u16 wcid, u16 freq, u16 fc, u16 seq, u8 raw_bss,
+			 u8 cm, u8 sec, const u8 *ra, const u8 *ta, const u8 *a3),
+	TP_ARGS(wcid, freq, fc, seq, raw_bss, cm, sec, ra, ta, a3),
+	TP_STRUCT__entry(
+		__field(u16, wcid)
+		__field(u16, freq)
+		__field(u16, fc)
+		__field(u16, seq)
+		__field(u8, raw_bss)
+		__field(u8, cm)
+		__field(u8, sec)
+		__array(u8, ra, 6)
+		__array(u8, ta, 6)
+		__array(u8, a3, 6)
+	),
+	TP_fast_assign(
+		__entry->wcid = wcid;
+		__entry->freq = freq;
+		__entry->fc = fc;
+		__entry->seq = seq;
+		__entry->raw_bss = raw_bss;
+		__entry->cm = cm;
+		__entry->sec = sec;
+		memcpy(__entry->ra, ra, 6);
+		memcpy(__entry->ta, ta, 6);
+		memcpy(__entry->a3, a3, 6);
+	),
+	TP_printk("wcid=%u freq=%u fc=0x%04x seq=%u raw_bss=%u cm=%u sec=%u ra=%pM ta=%pM a3=%pM",
+			  __entry->wcid, __entry->freq, __entry->fc, __entry->seq,
+			  __entry->raw_bss, __entry->cm, __entry->sec,
+			  __entry->ra, __entry->ta, __entry->a3)
