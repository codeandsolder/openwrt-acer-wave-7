+TRACE_EVENT(mt7925_lab_tx_descriptor,
+	TP_PROTO(u16 wcid, u8 link, u8 band, u8 tgid, u16 wlan_idx,
+		 u8 pid, bool protect, bool pairwise, u8 keyidx,
+		 u16 active, u32 length),
+	TP_ARGS(wcid, link, band, tgid, wlan_idx, pid, protect, pairwise,
+		keyidx, active, length),
+	TP_STRUCT__entry(
+		__field(u16, wcid)
+		__field(u8, link)
+		__field(u8, band)
+		__field(u8, tgid)
+		__field(u16, wlan_idx)
+		__field(u8, pid)
+		__field(bool, protect)
+		__field(bool, pairwise)
+		__field(u8, keyidx)
+		__field(u16, active)
+		__field(u32, length)
+	),
+	TP_fast_assign(
+		__entry->wcid = wcid;
+		__entry->link = link;
+		__entry->band = band;
+		__entry->tgid = tgid;
+		__entry->wlan_idx = wlan_idx;
+		__entry->pid = pid;
+		__entry->protect = protect;
+		__entry->pairwise = pairwise;
+		__entry->keyidx = keyidx;
+		__entry->active = active;
+		__entry->length = length;
+	),
+	TP_printk("wcid=%u link=%u band=%u tgid=%u wlan_idx=%u pid=%u protect=%u pairwise=%u keyidx=%u active=%x length=%u",
+		  __entry->wcid, __entry->link, __entry->band, __entry->tgid,
+		  __entry->wlan_idx, __entry->pid, __entry->protect,
+		  __entry->pairwise, __entry->keyidx, __entry->active,
+		  __entry->length)
+);
+
