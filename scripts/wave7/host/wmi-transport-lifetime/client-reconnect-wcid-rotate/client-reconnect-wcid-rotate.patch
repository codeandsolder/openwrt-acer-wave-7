-	idx = mt76_wcid_alloc(dev->mt76.wcid_mask, MT792x_WTBL_STA - 1);
+	idx = mt7925_lab_alloc_peer_wcid(mdev, vif);
 	if (idx < 0)
 		return -ENOSPC;
 
