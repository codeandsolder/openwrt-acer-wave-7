+/* Lab-only allocation discriminator. Keep the first lifetime's ordinary
+ * first-fit order, then cycle through legal free peer slots without
+ * retaining a reservation or altering normal free/unwind paths.
+ */
+static int mt7925_lab_alloc_peer_wcid(struct mt76_dev *mdev,
+				    struct ieee80211_vif *vif)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	const unsigned int limit = MT792x_WTBL_STA - 1;
+	unsigned int i, idx;
+
+	if (!is_mt7925(mdev) || vif->type != NL80211_IFTYPE_STATION ||
+	    !ieee80211_vif_is_mld(vif))
+		return mt76_wcid_alloc(mdev->wcid_mask, limit);
+
+	lockdep_assert_held(&mdev->mutex);
+	for (i = 0; i < limit; i++) {
+		idx = (mvif->lab_next_peer_wcid + i) % limit;
+		if (mdev->wcid_mask[idx / 32] & BIT(idx % 32))
+			continue;
+		mdev->wcid_mask[idx / 32] |= BIT(idx % 32);
+		mvif->lab_next_peer_wcid = (idx + 1) % limit;
+		return idx;
+	}
+
+	return -1;
+}
+
 /* Allocate and publish the wcid only; no MCU command is sent.
  * On failure the caller unwinds with mt7925_mac_link_sta_free_wcid().
  */
