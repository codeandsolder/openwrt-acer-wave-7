+/* Keep the host count until hardware submission (or disposal) completes.
+ * A flush checks this before the hardware queues/token count.
+ */
+static inline void mt76_host_tx_get(struct mt76_phy *phy)
+{
+	atomic_inc(&phy->host_tx_pending);
+}
+
+static inline void mt76_host_tx_put(struct mt76_phy *phy)
+{
+	if (atomic_dec_and_test(&phy->host_tx_pending))
+		wake_up(&phy->dev->tx_wait);
+}
