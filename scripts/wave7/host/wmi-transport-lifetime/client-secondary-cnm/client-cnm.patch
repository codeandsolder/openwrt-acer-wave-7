+/* A guarded, read-only probe for firmware query compatibility. */
+static int mt7925_lab_cnm_show(struct seq_file *s, void *unused)
+{
+	struct mt792x_dev *dev = s->private;
+	struct mt7925_lab_cnm_info *info;
+	unsigned int i;
+	int ret;
+
+	info = kzalloc(sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return -ENOMEM;
+	mt792x_mutex_acquire(dev);
+	ret = mt7925_lab_cnm_get_info(dev, info);
+	mt792x_mutex_release(dev);
+	if (ret)
+		goto out;
+	seq_printf(s, "CNM_GET_INFO count=%u\n", info->count);
+	for (i = 0; i < info->count; i++) {
+		const struct mt7925_lab_cnm_bss *b = &info->bss[i];
+
+		seq_printf(s, "bss=%u type=%u inuse=%u active=%u connected=%u channel=%u band=%u omac=%u omac_band=%u tx_nss=%u rx_nss=%u\n",
+			   i, b->type, b->inuse, b->active, b->connected,
+			   b->channel, b->band, b->omac, b->omac_band,
+			   b->tx_nss, b->rx_nss);
+	}
+out:
+	kfree(info);
+	return ret;
+}
