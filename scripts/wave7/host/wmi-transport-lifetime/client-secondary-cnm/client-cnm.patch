+/* Vendor gen4m 6bceb1b8e344: CNM GET_INFO, BSS_INFO event tag 2.
+ * Validate the complete TLV stream before publishing any BSS metadata.
+ */
+static int
+mt7925_lab_cnm_decode(const u8 *data, size_t len,
+		      struct mt7925_lab_cnm_info *info)
+{
+	const struct tlv *tlv;
+	bool found = false;
+	u32 rem;
+
+	if (len < 4 || len - 4 > U32_MAX)
+		return -EPROTO;
+
+	rem = len - 4;
+	tlv = (const void *)(data + 4);
+	while (rem) {
+		u16 size;
+
+		if (!mt7925_mcu_tlv_valid(tlv, rem))
+			return -EPROTO;
+		size = le16_to_cpu(tlv->len);
+		if (le16_to_cpu(tlv->tag) == 2) {
+			const u8 *payload = (const u8 *)tlv + sizeof(*tlv);
+			u8 count;
+
+			if (found || size < sizeof(*tlv) + 4)
+				return -EPROTO;
+			count = payload[0];
+			if (size != sizeof(*tlv) + 4 +
+				    count * sizeof(info->bss[0]))
+				return -EPROTO;
+			info->count = count;
+			memcpy(info->bss, payload + 4,
+			       count * sizeof(info->bss[0]));
+			found = true;
+		}
+		rem -= size;
+		tlv = (const void *)((const u8 *)tlv + size);
+	}
+	return found ? 0 : -ENODATA;
+}
+
+int mt7925_lab_cnm_get_info(struct mt792x_dev *dev,
+			   struct mt7925_lab_cnm_info *info)
+{
+	struct {
+		u8 reserved[4];
+		__le16 tag, len;
+	} __packed req = {
+		.tag = cpu_to_le16(2),
+		.len = cpu_to_le16(sizeof(struct tlv)),
+	};
+	struct sk_buff *skb = NULL;
+	int ret;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!is_mt7925(&dev->mt76) || !mt76_is_mmio(&dev->mt76))
+		return -EOPNOTSUPP;
+
+	ret = mt76_mcu_send_and_get_msg(&dev->mt76,
+					MCU_WM_UNI_CMD_QUERY(ROC),
+					&req, sizeof(req), true, &skb);
+	if (!ret)
+		ret = skb ? mt7925_lab_cnm_decode(skb->data, skb->len, info) :
+			    -ENODATA;
+	dev_kfree_skb(skb);
+	return ret;
+}
