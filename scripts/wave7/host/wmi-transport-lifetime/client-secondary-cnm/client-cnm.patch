+static int mt7925_lab_cnm_snapshot(struct mt792x_dev *dev,
+				  struct ieee80211_vif *vif, u8 stage)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	struct mt7925_lab_cnm_info *info;
+	unsigned long links = mvif->valid_links;
+	unsigned int link;
+	int ret;
+
+	if (!trace_mt7925_lab_cnm_bss_enabled() ||
+	    vif->type != NL80211_IFTYPE_STATION ||
+	    !ieee80211_vif_is_mld(vif))
+		return 0;
+
+	info = kzalloc(sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return -ENOMEM;
+	ret = mt7925_lab_cnm_get_info(dev, info);
+	trace_mt7925_lab_cnm_result(stage, ret, ret ? 0 : info->count);
+	if (ret)
+		goto out;
+
+	for_each_set_bit(link, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		struct mt792x_bss_conf *mconf = mt792x_vif_to_link(mvif, link);
+		const struct mt7925_lab_cnm_bss *b;
+		u8 idx;
+
+		if (!mconf)
+			continue;
+		idx = mconf->mt76.idx;
+		if (idx >= info->count) {
+			ret = -EPROTO;
+			break;
+		}
+		b = &info->bss[idx];
+		trace_mt7925_lab_cnm_bss(stage, idx, mconf->mt76.band_idx,
+					b->inuse, b->active, b->connected,
+					b->channel, b->band, b->omac,
+					b->omac_band, b->tx_nss, b->rx_nss);
+	}
+out:
+	kfree(info);
+	return ret;
+}
