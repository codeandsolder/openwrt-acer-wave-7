--- a/station.c
+++ b/station.c
@@ -513,7 +513,18 @@
 	 * the kernel starts sending station notifications.
 	 */
 
+	if (!tb[NL80211_ATTR_MAC] || !tb[NL80211_ATTR_IFINDEX]) {
+		fprintf(stderr, "sta identity missing!\n");
+		return NL_SKIP;
+	}
+
 	if (!tb[NL80211_ATTR_STA_INFO]) {
+		if (tb[NL80211_ATTR_MLO_LINKS]) {
+			mac_addr_n2a(mac_addr, nla_data(tb[NL80211_ATTR_MAC]));
+			if_indextoname(nla_get_u32(tb[NL80211_ATTR_IFINDEX]), dev);
+			printf("Station links %s (on %s)", mac_addr, dev);
+			goto print_links;
+		}
 		fprintf(stderr, "sta stats missing!\n");
 		return NL_SKIP;
 	}
@@ -654,6 +665,7 @@
 
 	printf("\n\tcurrent time:\t%llu ms\n", now_ms);
 
+print_links:
 	/* print link specific fields */
 	if (tb[NL80211_ATTR_MLO_LINKS]) {
 		int ret = 0;
@@ -1074,9 +1086,15 @@
 			       int argc, char **argv,
 			       enum id_input id)
 {
-	register_handler(print_sta_handler, *argv);
+	if (argc == 1 && !strcmp(argv[0], "--links")) {
+		if (nla_put_flag(msg, NL80211_ATTR_STA_DUMP_LINK_STATS))
+			return -ENOBUFS;
+		register_handler(print_sta_handler, NULL);
+	} else {
+		register_handler(print_sta_handler, *argv);
+	}
 	return 0;
 }
-COMMAND(station, dump, "[-v]",
+COMMAND(station, dump, "[-v|--links]",
 	NL80211_CMD_GET_STATION, NLM_F_DUMP, CIB_NETDEV, handle_station_dump,
 	"List all stations known, e.g. the AP on managed interfaces");
