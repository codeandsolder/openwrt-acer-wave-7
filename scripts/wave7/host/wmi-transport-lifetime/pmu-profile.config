# Merge into a separate Wave 7 diagnostic build's OpenWrt .config, then
# make defconfig. Verify these symbols remain enabled after resolution.
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y
