+++ b/mt7925/mac.c
@@ -868,6 +868,17 @@
 	}
 
 	mt7925_p2p_txwi_override(dev, txwi, skb);
+
+	/* Descriptor intent at enqueue, before firmware chooses the band.
+	 * Trace only per-peer station skbs; no payload or address capture.
+	 */
+	if (vif && vif->type == NL80211_IFTYPE_STATION && wcid->sta &&
+	    trace_mt7925_lab_tx_route_enabled())
+		trace_mt7925_lab_tx_route(
+			wcid->idx, wcid->link_id, wcid->link_valid,
+			mvif ? mvif->band_idx : MT792x_BAND_AUTO,
+			FIELD_GET(MT_TXD1_TGID, le32_to_cpu(txwi[1])),
+			ieee80211_vif_is_mld(vif), pid, is_8023, skb->len);
 }
