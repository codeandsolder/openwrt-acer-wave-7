+/* Experimental postscan MLO link re-acquisition. The firmware can report
+ * TXS on a different hardware band for a short interval after a background
+ * scan even when host TXD and active-links are unchanged. Reassert the
+ * current multi-link selection before reporting scan completion. Do not
+ * tear down stations, keys or BSS state, or preempt an unrelated ROC.
+ */
+static void
+mt7925_postscan_mlo_reacquire_iter(void *priv, u8 *mac,
+				   struct ieee80211_vif *vif)
+{
+	struct mt792x_dev *dev = priv;
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	u16 active, valid;
+	int ret;
+
+	if (vif->type != NL80211_IFTYPE_STATION ||
+	    !ieee80211_vif_is_mld(vif) || !READ_ONCE(vif->cfg.assoc))
+		return;
+
+	active = READ_ONCE(vif->active_links);
+	valid = READ_ONCE(mvif->valid_links);
+	if (hweight16(active) < 2 || (active & ~valid) ||
+	    (active & ~READ_ONCE(vif->valid_links)) ||
+	    mvif->bss_conf.link_id >= IEEE80211_MLD_MAX_NUM_LINKS ||
+	    !(active & BIT(mvif->bss_conf.link_id)))
+		return;
+
+	mt792x_mutex_acquire(dev);
+	if (test_bit(MT76_STATE_ROC, &dev->phy.mt76->state))
+		ret = -EBUSY;
+	else
+		ret = mt7925_set_mlo_roc(&dev->phy, &mvif->bss_conf, active);
+	mt792x_mutex_release(dev);
+	trace_mt7925_lab_postscan_roc(valid, active,
+				      mvif->bss_conf.link_id, ret);
+}
+
 void mt7925_scan_work(struct work_struct *work)
 {
