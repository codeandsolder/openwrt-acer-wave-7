+/* Select the physical MLO link per packet, not per TXQ. The TXQ's
+ * WCID is the primary even when an skb should leave on another link.
+ * Keep the chosen WCID RCU-protected through descriptor preparation.
+ */
+static int
+mt76_txq_send_one(struct mt76_phy *phy, struct ieee80211_txq *txq,
+		  struct sk_buff *skb, struct mt76_wcid *wcid,
+		  enum mt76_txq_id qid, bool *stop)
+{
+	struct mt76_dev *dev = phy->dev;
+	struct mt76_queue *q = phy->q_tx[qid];
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	int idx;
+
+	rcu_read_lock();
+	if (dev->drv->select_txq_wcid) {
+		struct mt76_wcid *selected;
+
+		selected = dev->drv->select_txq_wcid(dev, txq, skb, wcid);
+		if (selected)
+			wcid = selected;
+	}
+
+	if (!(wcid->tx_info & MT_WCID_TX_INFO_SET))
+		ieee80211_get_tx_rates(txq->vif, txq->sta, skb,
+				       info->control.rates, 1);
+
+	spin_lock(&q->lock);
+	idx = __mt76_tx_queue_skb(phy, qid, skb, wcid, txq->sta, stop);
+	spin_unlock(&q->lock);
+	rcu_read_unlock();
+
+	return idx;
+}
