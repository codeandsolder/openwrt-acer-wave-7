+/* Lab discriminator: attempt user data over a truly active secondary
+ * peer without touching mac80211 MLD association or firmware membership.
+ * Called from the common TXQ enqueue path under RCU. Only the observed
+ * two-link 5 GHz-primary lab geometry is selected here.
+ */
+struct mt76_wcid *
+mt7925_select_txq_wcid(struct mt76_dev *dev, struct ieee80211_txq *txq,
+		       struct sk_buff *skb, struct mt76_wcid *default_wcid)
+{
+	struct ieee80211_vif *vif = txq->vif;
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct mt792x_link_sta *secondary;
+	struct mt792x_sta *msta;
+
+	if (!txq->sta || !vif ||
+	    vif->type != NL80211_IFTYPE_STATION ||
+	    !ieee80211_vif_is_mld(vif) ||
+	    !(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) ||
+	    skb->len < ETH_HLEN ||
+	    !is_unicast_ether_addr(skb->data) ||
+	    skb->protocol == cpu_to_be16(ETH_P_PAE) ||
+	    ((const struct ethhdr *)skb->data)->h_proto ==
+	    cpu_to_be16(ETH_P_PAE))
+		return default_wcid;
+
+	msta = (void *)txq->sta->drv_priv;
+	if (msta->deflink_id != 1 ||
+	    default_wcid != &msta->deflink.wcid ||
+	    (READ_ONCE(msta->valid_links) & GENMASK(1, 0)) !=
+	    GENMASK(1, 0) ||
+	    (READ_ONCE(vif->active_links) & GENMASK(1, 0)) !=
+	    GENMASK(1, 0))
+		return default_wcid;
+
+	secondary = rcu_dereference(msta->link[0]);
+	if (!secondary || !secondary->wcid.link_valid ||
+	    test_bit(MT_WCID_FLAG_PS, &secondary->wcid.flags))
+		return default_wcid;
+
+	info->control.flags = u32_replace_bits(info->control.flags, 0,
+					       IEEE80211_TX_CTRL_MLO_LINK);
+	return &secondary->wcid;
+}
+EXPORT_SYMBOL_GPL(mt7925_select_txq_wcid);
