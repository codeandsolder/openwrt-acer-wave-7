--- a/drivers/net/wireless/mediatek/mt76/mt7925/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/main.c
@@ -2689,6 +2689,36 @@
 	err = mt7925_mac_sta_add_links(dev, vif, sta, add);
 	if (err < 0)
 		goto out;
+
+	/* Lab variant: connect the newly registered BSS without changing
+	 * its STATE_NONE STAREC or refreshing the primary MLD membership.
+	 */
+	if (vif->type == NL80211_IFTYPE_STATION &&
+	    ieee80211_vif_is_mld(vif)) {
+		unsigned int link_id;
+
+		for_each_set_bit(link_id, &add, IEEE80211_MLD_MAX_NUM_LINKS) {
+			struct ieee80211_bss_conf *link_conf;
+			struct ieee80211_link_sta *link_sta;
+			struct mt792x_bss_conf *mconf;
+
+			if (link_id == ((struct mt792x_vif *)vif->drv_priv)->deflink_id)
+				continue;
+
+			link_conf = mt792x_vif_to_bss_conf(vif, link_id);
+			link_sta = mt792x_sta_to_link_sta(vif, sta, link_id);
+			if (!link_conf || !link_sta) {
+				err = -EINVAL;
+				goto out;
+			}
+
+			mconf = mt792x_link_conf_to_mconf(link_conf);
+			err = mt7925_mcu_add_bss_info(&dev->phy, mconf->mt76.ctx,
+						      link_conf, link_sta, true);
+			if (err)
+				goto out;
+		}
+	}
 
 out:
 	mt792x_mutex_release(dev);
