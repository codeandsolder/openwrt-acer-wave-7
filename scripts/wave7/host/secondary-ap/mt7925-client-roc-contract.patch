+static int
+mt7925_roc_geometry(const struct cfg80211_chan_def *chandef,
+		    struct roc_acquire_tlv *req)
+{
+	int center, center2 = 0, primary40 = 0;
+	u8 bw, band;
+
+	if (!cfg80211_chandef_valid(chandef))
+		return -EINVAL;
+	switch (chandef->width) {
+	case NL80211_CHAN_WIDTH_20_NOHT:
+	case NL80211_CHAN_WIDTH_20:
+	case NL80211_CHAN_WIDTH_40:
+		bw = MT7925_CW_20_40MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_80:
+		bw = MT7925_CW_80MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_160:
+		bw = MT7925_CW_160MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_80P80:
+		bw = MT7925_CW_80P80MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_5:
+		bw = MT7925_CW_5MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_10:
+		bw = MT7925_CW_10MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_320:
+		bw = MT7925_CW_320MHZ;
+		break;
+	default:
+		return -EINVAL;
+	}
+	switch (chandef->chan->band) {
+	case NL80211_BAND_2GHZ:
+		band = 1;
+		break;
+	case NL80211_BAND_5GHZ:
+		band = 2;
+		break;
+	case NL80211_BAND_6GHZ:
+		band = 3;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	center = ieee80211_frequency_to_channel(chandef->center_freq1);
+	if (chandef->center_freq2)
+		center2 = ieee80211_frequency_to_channel(chandef->center_freq2);
+
+	/* SCO describes the secondary 20 MHz channel in the primary
+	 * forty, not the location relative to the entire 80/160/320.
+	 */
+	switch (chandef->width) {
+	case NL80211_CHAN_WIDTH_40:
+	case NL80211_CHAN_WIDTH_80:
+	case NL80211_CHAN_WIDTH_160:
+	case NL80211_CHAN_WIDTH_80P80:
+	case NL80211_CHAN_WIDTH_320:
+		primary40 = cfg80211_chandef_primary(chandef,
+						    NL80211_CHAN_WIDTH_40, NULL);
+		if (primary40 < 0)
+			return -EINVAL;
+		break;
+	default:
+		break;
+	}
+
+	req->band = band;
+	req->control_channel = chandef->chan->hw_value;
+	req->bw = req->bw_from_ap = bw;
+	req->center_chan = req->center_chan_from_ap = center;
+	req->center_chan2 = req->center_chan2_from_ap = center2;
+	req->sco = !primary40 ? 0 :
+		   chandef->chan->center_freq < primary40 ? 1 : 3;
+	return 0;
+}
