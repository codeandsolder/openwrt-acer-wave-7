--- a/drivers/net/wireless/mediatek/mt76/mt7925/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/main.c
@@ -2671,6 +2671,48 @@
 /* Re-send each link's BSS_INFO after its STATE_NONE STAREC, then raise
  * every link to STATE_ASSOC, primary first.
  */
+/* Reprogram only the secondary DEV_INFO address context after its
+ * granted DBDC band is known. Do not deactivate the shared primary OMAC
+ * or touch the already-published BSS and peer records.
+ */
+static int mt7925_lab_refresh_dev_band(struct mt792x_dev *dev,
+				      struct ieee80211_bss_conf *link_conf,
+				      struct mt792x_bss_conf *mconf)
+{
+	struct {
+		u8 omac_idx;
+		u8 band_idx;
+		__le16 pad;
+		struct {
+			__le16 tag;
+			__le16 len;
+			u8 active;
+			u8 link_idx;
+			u8 omac_addr[ETH_ALEN];
+		} __packed tlv;
+	} __packed req = {
+		.omac_idx = mconf->mt76.omac_idx,
+		.band_idx = mconf->mt76.band_idx,
+		.tlv = {
+			.tag = cpu_to_le16(DEV_INFO_ACTIVE),
+			.len = cpu_to_le16(sizeof(req.tlv)),
+			.active = true,
+			.link_idx = mconf->mt76.link_idx,
+		},
+	};
+	int ret;
+
+	if (req.band_idx == MT792x_BAND_AUTO || req.band_idx > 2)
+		return -EINVAL;
+
+	memcpy(req.tlv.omac_addr, link_conf->addr, ETH_ALEN);
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_UNI_CMD(DEV_INFO_UPDATE),
+			       &req, sizeof(req), true);
+	trace_mt7925_lab_dev_rebind(mconf->mt76.idx, link_conf->link_id,
+				   req.omac_idx, req.band_idx, req.tlv.link_idx, ret);
+	return ret;
+}
+
 static int mt7925_mac_multi_links_sta_assoc(struct mt76_dev *mdev,
 					    struct ieee80211_vif *vif,
 					    struct ieee80211_sta *sta,
@@ -2717,6 +2759,10 @@
 		if (!link_conf || !link_sta)
 			continue;
 		mconf = mt792x_link_conf_to_mconf(link_conf);
+
+		err = mt7925_lab_refresh_dev_band(dev, link_conf, mconf);
+		if (err)
+			return err;
 
 		err = mt7925_mcu_add_bss_info(&dev->phy, mconf->mt76.ctx,
 					      link_conf, link_sta, true);
--- a/drivers/net/wireless/mediatek/mt76/mt7925/lab_trace.h
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/lab_trace.h
@@ -320,6 +320,30 @@
 	),
 	TP_printk("wcid=%u bss=%u link=%u enabled=%u state=%u result=%d",
 		  __entry->wcid, __entry->bss, __entry->link, __entry->enabled, __entry->state, __entry->result)
+);
+
+TRACE_EVENT(mt7925_lab_dev_rebind,
+	TP_PROTO(u8 bss, u8 link, u8 omac, u8 band, u8 fwlink, int result),
+	TP_ARGS(bss, link, omac, band, fwlink, result),
+	TP_STRUCT__entry(
+		__field(u8, bss)
+		__field(u8, link)
+		__field(u8, omac)
+		__field(u8, band)
+		__field(u8, fwlink)
+		__field(int, result)
+	),
+	TP_fast_assign(
+		__entry->bss = bss;
+		__entry->link = link;
+		__entry->omac = omac;
+		__entry->band = band;
+		__entry->fwlink = fwlink;
+		__entry->result = result;
+	),
+	TP_printk("bss=%u link=%u omac=%u band=%u fwlink=%u result=%d",
+		  __entry->bss, __entry->link, __entry->omac, __entry->band,
+		  __entry->fwlink, __entry->result)
 );
 
 TRACE_EVENT(mt7925_lab_sta_mld_update,
