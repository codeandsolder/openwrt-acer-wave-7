+		__entry->link = link;
+		__entry->allowed = allowed;
+		__entry->ticket = ticket;
+	),
+	TP_printk("wcid=%u link=%u allowed=%u ticket=%llu",
+		  __entry->wcid, __entry->link, __entry->allowed,
+		  __entry->ticket)
+);
+
+TRACE_EVENT(mt7925_lab_credit_refund,
+	TP_PROTO(u64 ticket, bool restored),
+	TP_ARGS(ticket, restored),
+	TP_STRUCT__entry(
+		__field(u64, ticket)
+		__field(bool, restored)
+	),
+	TP_fast_assign(
+		__entry->ticket = ticket;
+		__entry->restored = restored;
+	),
+	TP_printk("ticket=%llu restored=%u", __entry->ticket,
+		  __entry->restored)
+);
+
 #endif
 
