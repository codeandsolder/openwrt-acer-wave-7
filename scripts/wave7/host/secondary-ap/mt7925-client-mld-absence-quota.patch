+#ifndef __MT792X_ABSENCE_H
+#define __MT792X_ABSENCE_H
+
+/* Called under the device's absence lock. Identity pointers are only compared,
+ * never dereferenced. The fifth index is the reserved P2P device BSS.
+ */
+#define MT792X_ABSENCE_SLOTS (MT792x_MAX_INTERFACES + 1)
+
+struct mt792x_absence_slot {
+	const void *identity;
+	const void *owner;
+	unsigned int link;
+	u32 epoch;
+	u8 quota;
+	bool active;
+	bool absent;
+};
+
+struct mt792x_absence_state {
+	struct mt792x_absence_slot slots[MT792X_ABSENCE_SLOTS];
+	bool paused;
+};
+
+static inline void
+mt792x_absence_clear(struct mt792x_absence_slot *slot)
+{
+	slot->epoch++;
+	slot->quota = 0;
+	slot->absent = false;
+}
+
+static inline void
+mt792x_absence_register(struct mt792x_absence_state *state, unsigned int bss,
+		       const void *identity, const void *owner, unsigned int link)
+{
+	struct mt792x_absence_slot *slot;
+
+	if (bss >= MT792X_ABSENCE_SLOTS)
+		return;
+	slot = &state->slots[bss];
+	mt792x_absence_clear(slot);
+	slot->identity = identity;
+	slot->owner = owner;
+	slot->link = link;
+	slot->active = false;
+}
+
+static inline void
+mt792x_absence_unregister(struct mt792x_absence_state *state, unsigned int bss,
+			 const void *identity)
+{
+	struct mt792x_absence_slot *slot;
+
+	if (bss >= MT792X_ABSENCE_SLOTS)
+		return;
+	slot = &state->slots[bss];
+	if (slot->identity != identity)
+		return;
+	mt792x_absence_clear(slot);
+	slot->identity = NULL;
+	slot->owner = NULL;
+	slot->active = false;
+}
+
+static inline void
+mt792x_absence_unregister_owner(struct mt792x_absence_state *state,
+			       const void *owner)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT792X_ABSENCE_SLOTS; i++)
+		if (state->slots[i].identity && state->slots[i].owner == owner)
+			mt792x_absence_unregister(state, i, state->slots[i].identity);
+}
+
+static inline void
+mt792x_absence_activate(struct mt792x_absence_state *state, unsigned int bss,
+		       const void *identity, bool active)
+{
+	struct mt792x_absence_slot *slot;
+
+	if (bss >= MT792X_ABSENCE_SLOTS)
+		return;
+	slot = &state->slots[bss];
+	if (slot->identity != identity)
+		return;
+	if (!active)
+		mt792x_absence_clear(slot);
+	slot->active = active;
+}
+
+static inline bool
+mt792x_absence_announce(struct mt792x_absence_state *state, unsigned int bss,
+		       bool absent, u8 quota)
+{
+	struct mt792x_absence_slot *slot;
+
+	if (state->paused || bss >= MT792X_ABSENCE_SLOTS)
+		return false;
+	slot = &state->slots[bss];
+	if (!slot->identity)
+		return false;
+	/* Each event replaces the budget, including repeated absence events. */
+	slot->epoch++;
+	slot->absent = absent;
+	slot->quota = quota;
+	return true;
+}
+
+/* Four-byte BSS header followed by a validated complete TLV stream.
+ * Return false without mutating outputs on missing/duplicate/malformed INFO.
+ */
+static inline bool
+mt792x_absence_decode(const u8 *p, unsigned int len, unsigned int *bss,
+		       bool *absent, u8 *quota)
+{
+	unsigned int index;
+	bool found = false, a = false;
+	u8 q = 0;
+
+	if (len < 4)
+		return false;
+	index = p[0];
+	if (index >= MT792X_ABSENCE_SLOTS)
+		return false;
+	p += 4;
+	len -= 4;
+	while (len) {
+		u16 tag, size;
+
+		if (len < 4)
+			return false;
+		tag = p[0] | (u16)p[1] << 8;
+		size = p[2] | (u16)p[3] << 8;
+		if (size < 4 || size > len)
+			return false;
+		if (tag == 0) {
+			if (found || size != 8 || p[4] > 1)
+				return false;
+			found = true;
+			a = p[4];
+			q = p[5];
+		}
+		p += size;
+		len -= size;
+	}
+	if (!found)
+		return false;
+	*bss = index;
+	*absent = a;
+	*quota = q;
+	return true;
+}
+
+static inline void
+mt792x_absence_reset(struct mt792x_absence_state *state, bool paused)
+{
+	unsigned int i;
+
+	state->paused = paused;
+	for (i = 0; i < MT792X_ABSENCE_SLOTS; i++) {
+		mt792x_absence_clear(&state->slots[i]);
+		state->slots[i].active = false;
+	}
+}
+
+/* The firmware routes ordinary MLO traffic via its primary station record.
+ * Only charge the target BSS when the whole active MLD is absent. Unobserved
+ * states start as present, as in the vendor's zero-initialized absence bitmap.
+ * A ticket is consumed at admission, before dequeue, and may be refunded
+ * only against the same firmware announcement and BSS incarnation.
+ */
+static inline bool
+mt792x_absence_reserve(struct mt792x_absence_state *state, const void *owner,
+		      unsigned int link, bool mld, u64 *ticket)
+{
+	struct mt792x_absence_slot *target = NULL;
+	unsigned int i, bss = 0;
+
+	*ticket = 0;
+	if (state->paused)
+		return true;
+	for (i = 0; i < MT792X_ABSENCE_SLOTS; i++) {
+		struct mt792x_absence_slot *slot = &state->slots[i];
+
+		if (!slot->active || slot->owner != owner)
+			continue;
+		if (slot->link == link) {
+			target = slot;
+			bss = i;
+		}
+		if (mld && !slot->absent)
+			return true;
+	}
+	if (!target || !target->absent)
+		return true;
+	if (!target->quota)
+		return false;
+	target->quota--;
+	*ticket = ((u64)target->epoch << 8) | (bss + 1);
+	return true;
+}
+
+static inline bool
+mt792x_absence_refund(struct mt792x_absence_state *state, u64 ticket)
+{
+	unsigned int bss = (ticket & 0xff);
+	struct mt792x_absence_slot *slot;
+
+	if (!bss || bss > MT792X_ABSENCE_SLOTS)
+		return false;
+	slot = &state->slots[bss - 1];
+	if (!slot->identity || !slot->active || !slot->absent ||
+	    slot->epoch != (u32)(ticket >> 8) || slot->quota == 255)
+		return false;
+	slot->quota++;
+	return true;
+}
+
+#endif
