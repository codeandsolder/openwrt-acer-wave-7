diff --git a/drivers/net/wireless/mediatek/mt76/mt7925/absence.c b/drivers/net/wireless/mediatek/mt76/mt7925/absence.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/absence.c
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#include "mt7925.h"
+#include "mcu.h"
+#include "lab_trace.h"
+
+void mt7925_absence_bind(struct mt792x_dev *dev, struct mt792x_bss_conf *mconf,
+			 unsigned int link_id)
+{
+	spin_lock_bh(&dev->absence_lock);
+	mt792x_absence_register(&dev->absence, mconf->mt76.idx, mconf,
+				mconf->vif, link_id);
+	spin_unlock_bh(&dev->absence_lock);
+}
+
+void mt7925_absence_unbind(struct mt792x_dev *dev, struct mt792x_bss_conf *mconf)
+{
+	spin_lock_bh(&dev->absence_lock);
+	mt792x_absence_unregister(&dev->absence, mconf->mt76.idx, mconf);
+	spin_unlock_bh(&dev->absence_lock);
+	mt76_worker_schedule(&dev->mt76.tx_worker);
+}
+
+void mt7925_absence_unbind_owner(struct mt792x_dev *dev, struct mt792x_vif *mvif)
+{
+	spin_lock_bh(&dev->absence_lock);
+	mt792x_absence_unregister_owner(&dev->absence, mvif);
+	spin_unlock_bh(&dev->absence_lock);
+	mt76_worker_schedule(&dev->mt76.tx_worker);
+}
+
+void mt7925_absence_set_active(struct mt792x_dev *dev,
+			      struct mt792x_bss_conf *mconf, bool active)
+{
+	spin_lock_bh(&dev->absence_lock);
+	mt792x_absence_activate(&dev->absence, mconf->mt76.idx, mconf, active);
+	spin_unlock_bh(&dev->absence_lock);
+	mt76_worker_schedule(&dev->mt76.tx_worker);
+}
+
+void mt7925_absence_set_reset(struct mt792x_dev *dev, bool paused)
+{
+	spin_lock_bh(&dev->absence_lock);
+	mt792x_absence_reset(&dev->absence, paused);
+	spin_unlock_bh(&dev->absence_lock);
+}
+
+void mt7925_absence_event(struct mt792x_dev *dev, struct sk_buff *skb)
+{
+	unsigned int bss;
+	bool absent, changed;
+	u8 quota;
+
+	if (skb->len < sizeof(struct mt7925_mcu_rxd) ||
+	    !mt792x_absence_decode(skb->data + sizeof(struct mt7925_mcu_rxd),
+				   skb->len - sizeof(struct mt7925_mcu_rxd),
+				   &bss, &absent, &quota))
+		return;
+	spin_lock_bh(&dev->absence_lock);
+	changed = mt792x_absence_announce(&dev->absence, bss, absent, quota);
+	spin_unlock_bh(&dev->absence_lock);
+
+	/* Presence of any MLD member or a new quota can release a queue.
+	 * Schedule after releasing the lock, never block MCU RX on tx locks.
+	 */
+	if (changed && (!absent || quota))
+		mt76_worker_schedule(&dev->mt76.tx_worker);
+}
+
+bool mt7925_tx_data_reserve(struct mt76_dev *mdev, struct mt76_wcid *wcid,
+			   u64 *ticket)
+{
+	struct mt792x_dev *dev = container_of(mdev, struct mt792x_dev, mt76);
+	struct ieee80211_sta *sta = wcid_to_sta(wcid);
+	struct ieee80211_vif *vif;
+	struct mt792x_sta *msta;
+	bool allowed;
+
+	*ticket = 0;
+	if (!sta || sta->tdls)
+		return true;
+	msta = (void *)sta->drv_priv;
+	if (!msta->vif)
+		return true;
+	vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+
+	/* STA uplink data uses the firmware's peer-wide MLD station record.
+	 * AP power-save release, TDLS and NAN are separate scheduling domains.
+	 */
+	if (vif->type != NL80211_IFTYPE_STATION)
+		return true;
+
+	spin_lock_bh(&dev->absence_lock);
+	allowed = mt792x_absence_reserve(&dev->absence, msta->vif, wcid->link_id,
+					wcid->link_valid, ticket);
+	trace_mt7925_lab_credit(wcid->idx, wcid->link_id, allowed, *ticket);
+	spin_unlock_bh(&dev->absence_lock);
+	return allowed;
+}
+EXPORT_SYMBOL_GPL(mt7925_tx_data_reserve);
+
+void mt7925_tx_data_refund(struct mt76_dev *mdev, u64 ticket)
+{
+	struct mt792x_dev *dev = container_of(mdev, struct mt792x_dev, mt76);
+	bool restored;
+
+	spin_lock_bh(&dev->absence_lock);
+	restored = mt792x_absence_refund(&dev->absence, ticket);
+	trace_mt7925_lab_credit_refund(ticket, restored);
+	spin_unlock_bh(&dev->absence_lock);
+}
+EXPORT_SYMBOL_GPL(mt7925_tx_data_refund);
