--- a/drivers/net/wireless/mediatek/mt76/mt7925/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/main.c
@@ -2715,6 +2715,26 @@
 			mconf = mt792x_link_conf_to_mconf(link_conf);
 			err = mt7925_mcu_add_bss_info(&dev->phy, mconf->mt76.ctx,
 						      link_conf, link_sta, true);
+			if (err)
+				goto out;
+		}
+
+		/* Refresh only the existing primary STAREC with the two-link
+		 * membership. The secondary STAREC remains STATE_NONE.
+		 */
+		if (add) {
+			struct mt792x_sta *msta = (void *)sta->drv_priv;
+			struct mt792x_link_sta *primary;
+			struct ieee80211_link_sta *link_sta;
+
+			primary = mt792x_sta_to_link(msta, msta->deflink_id);
+			link_sta = mt792x_sta_to_link_sta(vif, sta, msta->deflink_id);
+			if (!primary || !link_sta) {
+				err = -EINVAL;
+				goto out;
+			}
+			err = mt7925_mcu_sta_update(dev, link_sta, vif, primary,
+						    true, MT76_STA_INFO_STATE_ASSOC);
 			if (err)
 				goto out;
 		}
