+/* Lab experiment: change only MLD membership of an existing STAREC. */
+int mt7925_mcu_sta_mld_update(struct mt792x_dev *dev,
+			      struct ieee80211_vif *vif,
+			      struct ieee80211_sta *sta,
+			      struct mt792x_link_sta *mlink)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	struct mt792x_bss_conf *mconf;
+	struct sk_buff *skb;
+	int ret;
+
+	mconf = mt792x_vif_to_link(mvif, mlink->wcid.link_id);
+	if (!mconf)
+		return -EINVAL;
+
+	skb = __mt76_connac_mcu_alloc_sta_req(&dev->mt76, &mconf->mt76,
+					      &mlink->wcid,
+					      MT7925_STA_UPDATE_MAX_SIZE);
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+
+	mt7925_mcu_sta_mld_tlv(skb, vif, sta, mlink);
+	ret = mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				    MCU_UNI_CMD(STA_REC_UPDATE), true);
+	trace_mt7925_lab_sta_mld_update(mlink->wcid.idx, mconf->mt76.idx, ret);
+	return ret;
+}
