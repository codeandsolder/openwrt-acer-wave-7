+TRACE_EVENT(mt7925_lab_rxdesc,
+	TP_PROTO(u32 word1, u32 word2, u32 word3, u32 length, int result, u16 resolved_wcid, u8 link, u8 valid, u8 sta, u16 freq, u8 encap),
+	TP_ARGS(word1, word2, word3, length, result, resolved_wcid, link, valid, sta, freq, encap),
+	TP_STRUCT__entry(
+		__field(u32, word1)
+		__field(u32, word2)
+		__field(u32, word3)
+		__field(u32, length)
+		__field(int, result)
+		__field(u16, resolved_wcid)
+		__field(u8, link)
+		__field(u8, valid)
+		__field(u8, sta)
+		__field(u16, freq)
+		__field(u8, encap)
+	),
+	TP_fast_assign(
+		__entry->word1 = word1;
+		__entry->word2 = word2;
+		__entry->word3 = word3;
+		__entry->length = length;
+		__entry->result = result;
+		__entry->resolved_wcid = resolved_wcid;
+		__entry->link = link;
+		__entry->valid = valid;
+		__entry->sta = sta;
+		__entry->freq = freq;
+		__entry->encap = encap;
+	),
+	TP_printk("word1=%u word2=%u word3=%u length=%u result=%d resolved_wcid=%u link=%u valid=%u sta=%u freq=%u encap=%u",
+		  __entry->word1, __entry->word2, __entry->word3, __entry->length, __entry->result, __entry->resolved_wcid, __entry->link, __entry->valid, __entry->sta, __entry->freq, __entry->encap)
+);
+
+TRACE_EVENT(mt7925_lab_rx_frame,
+	TP_PROTO(u16 wcid, u16 freq, u16 fc, u8 raw_bss, u8 encap, u8 u2m, u8 data),
+	TP_ARGS(wcid, freq, fc, raw_bss, encap, u2m, data),
+	TP_STRUCT__entry(
+		__field(u16, wcid)
+		__field(u16, freq)
+		__field(u16, fc)
+		__field(u8, raw_bss)
+		__field(u8, encap)
+		__field(u8, u2m)
+		__field(u8, data)
+	),
+	TP_fast_assign(
+		__entry->wcid = wcid;
+		__entry->freq = freq;
+		__entry->fc = fc;
+		__entry->raw_bss = raw_bss;
+		__entry->encap = encap;
+		__entry->u2m = u2m;
+		__entry->data = data;
+	),
+	TP_printk("wcid=%u freq=%u fc=%u raw_bss=%u encap=%u u2m=%u data=%u",
+		  __entry->wcid, __entry->freq, __entry->fc, __entry->raw_bss, __entry->encap, __entry->u2m, __entry->data)
+);
+
 #endif
 
