+					status->freq, fc,
+					FIELD_GET(MT_RXD2_NORMAL_BSSID, word2),
+					encap,
+					FIELD_GET(MT_RXD3_NORMAL_ADDR_TYPE, word3) ==
+					MT_RXD3_NORMAL_U2M,
+					!(word2 & MT_RXD2_NORMAL_NDATA));
+			}
 			mt76_rx(&dev->mt76, q, skb);
 			return;
 		}
 		fallthrough;
+	}
 	default:
