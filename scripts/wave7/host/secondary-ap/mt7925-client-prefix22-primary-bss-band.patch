+/* A grant can move an already-connected primary to another DBDC band.
+ * Refresh only BASIC, without changing station membership, keys or timing.
+ */
+int mt7925_mcu_refresh_peer_band(struct mt792x_phy *phy,
+				 struct ieee80211_bss_conf *link_conf,
+				 struct ieee80211_link_sta *link_sta)
+{
+	struct mt792x_dev *dev = phy->dev;
+	struct mt792x_bss_conf *mconf = mt792x_link_conf_to_mconf(link_conf);
+	struct mt792x_vif *mvif = mconf->vif;
+	struct mt792x_sta *msta = (void *)link_sta->sta->drv_priv;
+	struct mt792x_link_sta *peer, *owner;
+	struct sk_buff *skb;
+	u8 band_idx = READ_ONCE(mconf->mt76.band_idx);
+	u16 bmc;
+	int err;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (band_idx == mconf->peer_bss_band ||
+	    band_idx >= MT792x_BAND_ALL ||
+	    mconf->peer_bss_band >= MT792x_BAND_ALL)
+		return 0;
+
+	peer = mt792x_sta_to_link(msta, link_sta->link_id);
+	owner = mt792x_sta_to_link(&mvif->sta, mconf->link_id);
+	if (!peer || !owner || !mconf->dev_active ||
+	    link_conf->link_id != mconf->link_id ||
+	    link_sta->link_id != mconf->link_id ||
+	    (!mconf->mt76.ctx && !link_conf->chanreq.oper.chan))
+		return -EINVAL;
+
+	bmc = mconf->bmc_valid ? mconf->bmc.wcid.idx : owner->wcid.idx;
+	skb = __mt7925_mcu_alloc_bss_req(&dev->mt76, &mconf->mt76,
+					 MT7925_BSS_UPDATE_MAX_SIZE);
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+
+	band_idx = mt7925_mcu_bss_basic_tlv(skb, link_conf, link_sta,
+					    mconf->mt76.ctx, phy->mt76, bmc,
+					    peer->wcid.idx, true);
+	err = mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				    MCU_UNI_CMD(BSS_INFO_UPDATE), true);
+	trace_mt7925_lab_bss_result(mconf->mt76.idx, link_conf->link_id,
+				   peer->wcid.idx, true, err);
+	if (!err)
+		mconf->peer_bss_band = band_idx;
+	return err;
+}
