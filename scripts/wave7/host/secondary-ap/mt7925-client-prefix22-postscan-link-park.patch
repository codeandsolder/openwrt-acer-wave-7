+/* Diagnostic: do not scan with multiple active MLD links. A scan on
+ * this MT7925/Atheros AP pair repeatedly causes firmware to send
+ * primary-link TX on the secondary RF band a second later.
+ * Iterate live VIFs rather than holding a pointer across a scan.
+ */
+static void
+mt7925_scan_restore_links_iter(void *data, u8 *mac,
+			       struct ieee80211_vif *vif)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	u16 saved = xchg(&mvif->scan_saved_active_links, 0);
+	u16 active = READ_ONCE(vif->active_links);
+
+	if (!saved)
+		return;
+	if (vif->type == NL80211_IFTYPE_STATION &&
+	    ieee80211_vif_is_mld(vif) && READ_ONCE(vif->cfg.assoc) &&
+	    !(saved & ~READ_ONCE(vif->valid_links)) &&
+	    mvif->bss_conf.link_id < IEEE80211_MLD_MAX_NUM_LINKS &&
+	    active == BIT(mvif->bss_conf.link_id)) {
+		ieee80211_set_active_links_async(vif, saved);
+		trace_mt7925_lab_scan_link_park(1, active, saved, 0);
+	} else {
+		trace_mt7925_lab_scan_link_park(2, active, saved, -ENOLINK);
+	}
+}
