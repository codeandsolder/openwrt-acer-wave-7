diff --git a/drivers/net/wireless/mediatek/mt76/mt7925/lab_trace.h b/drivers/net/wireless/mediatek/mt76/mt7925/lab_trace.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/lab_trace.h
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM mt7925_lab
+
+#if !defined(__MT7925_LAB_TRACE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define __MT7925_LAB_TRACE_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(mt7925_lab_mcu_rx,
+	TP_PROTO(u8 eid, u8 seq, u8 option, u8 ext_eid, u32 length),
+	TP_ARGS(eid, seq, option, ext_eid, length),
+
+	TP_STRUCT__entry(
+		__field(u8, eid)
+		__field(u8, seq)
+		__field(u8, option)
+		__field(u8, ext_eid)
+		__field(u32, length)
+	),
+
+	TP_fast_assign(
+		__entry->eid = eid;
+		__entry->seq = seq;
+		__entry->option = option;
+		__entry->ext_eid = ext_eid;
+		__entry->length = length;
+	),
+
+	TP_printk("eid=%u seq=%u option=%u ext_eid=%u length=%u",
+		  __entry->eid, __entry->seq, __entry->option, __entry->ext_eid, __entry->length)
+);
+
+TRACE_EVENT(mt7925_lab_roc,
+	TP_PROTO(u8 bss, u8 token, u8 expected, u8 status, u8 type, u8 rfband, u8 channel, u8 dbdcband,
+		 u32 duration),
+	TP_ARGS(bss, token, expected, status, type, rfband, channel, dbdcband, duration),
+
+	TP_STRUCT__entry(
+		__field(u8, bss)
+		__field(u8, token)
+		__field(u8, expected)
+		__field(u8, status)
+		__field(u8, type)
+		__field(u8, rfband)
+		__field(u8, channel)
+		__field(u8, dbdcband)
+		__field(u32, duration)
+	),
+
+	TP_fast_assign(
+		__entry->bss = bss;
+		__entry->token = token;
+		__entry->expected = expected;
+		__entry->status = status;
+		__entry->type = type;
+		__entry->rfband = rfband;
+		__entry->channel = channel;
+		__entry->dbdcband = dbdcband;
+		__entry->duration = duration;
+	),
+
+	TP_printk("bss=%u token=%u expected=%u status=%u type=%u rfband=%u channel=%u dbdcband=%u duration=%u",
+		  __entry->bss, __entry->token, __entry->expected, __entry->status, __entry->type,
+		  __entry->rfband, __entry->channel, __entry->dbdcband, __entry->duration)
+);
+
+TRACE_EVENT(mt7925_lab_mbmc,
+	TP_PROTO(u16 tag, u8 enabled, u8 band),
+	TP_ARGS(tag, enabled, band),
+
+	TP_STRUCT__entry(
+		__field(u16, tag)
+		__field(u8, enabled)
+		__field(u8, band)
+	),
+
+	TP_fast_assign(
+		__entry->tag = tag;
+		__entry->enabled = enabled;
+		__entry->band = band;
+	),
+
+	TP_printk("tag=%u enabled=%u band=%u",
+		  __entry->tag, __entry->enabled, __entry->band)
+);
+
+TRACE_EVENT(mt7925_lab_scan_req,
+	TP_PROTO(u8 seq, u8 bss, u8 flags, u8 type, u32 channels, u32 first_freq),
+	TP_ARGS(seq, bss, flags, type, channels, first_freq),
+
+	TP_STRUCT__entry(
+		__field(u8, seq)
+		__field(u8, bss)
+		__field(u8, flags)
+		__field(u8, type)
+		__field(u32, channels)
+		__field(u32, first_freq)
+	),
+
+	TP_fast_assign(
+		__entry->seq = seq;
+		__entry->bss = bss;
+		__entry->flags = flags;
+		__entry->type = type;
+		__entry->channels = channels;
+		__entry->first_freq = first_freq;
+	),
+
+	TP_printk("seq=%u bss=%u flags=%u type=%u channels=%u first_freq=%u",
+		  __entry->seq, __entry->bss, __entry->flags, __entry->type, __entry->channels,
+		  __entry->first_freq)
+);
+
+TRACE_EVENT(mt7925_lab_scan_tlv,
+	TP_PROTO(u16 tag, u16 length, bool scanning),
+	TP_ARGS(tag, length, scanning),
+
+	TP_STRUCT__entry(
+		__field(u16, tag)
+		__field(u16, length)
+		__field(bool, scanning)
+	),
+
+	TP_fast_assign(
+		__entry->tag = tag;
+		__entry->length = length;
+		__entry->scanning = scanning;
+	),
+
+	TP_printk("tag=%u length=%u scanning=%u",
+		  __entry->tag, __entry->length, __entry->scanning)
+);
+
+TRACE_EVENT(mt7925_lab_txfree,
+	TP_PROTO(u16 wcid, u32 count, u32 status),
+	TP_ARGS(wcid, count, status),
+
+	TP_STRUCT__entry(
+		__field(u16, wcid)
+		__field(u32, count)
+		__field(u32, status)
+	),
+
+	TP_fast_assign(
+		__entry->wcid = wcid;
+		__entry->count = count;
+		__entry->status = status;
+	),
+
+	TP_printk("wcid=%u count=%u status=%u",
+		  __entry->wcid, __entry->count, __entry->status)
+);
+
+TRACE_EVENT(mt7925_lab_txs,
+	TP_PROTO(u16 wcid, u32 pid, u32 word0),
+	TP_ARGS(wcid, pid, word0),
+
+	TP_STRUCT__entry(
+		__field(u16, wcid)
+		__field(u32, pid)
+		__field(u32, word0)
+	),
+
+	TP_fast_assign(
+		__entry->wcid = wcid;
+		__entry->pid = pid;
+		__entry->word0 = word0;
+	),
+
+	TP_printk("wcid=%u pid=%u word0=%u",
+		  __entry->wcid, __entry->pid, __entry->word0)
+);
+
+#endif
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH .
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE lab_trace
+
+#include <trace/define_trace.h>
