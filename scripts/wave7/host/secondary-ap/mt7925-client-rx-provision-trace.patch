+				wcid ? wcid->idx : 0xffff,
+				wcid ? wcid->link_id : 0xff,
+				wcid && wcid->link_valid, wcid && wcid->sta,
+				ret ? 0 : status->freq,
+				!ret && !!(status->flag & RX_FLAG_8023));
