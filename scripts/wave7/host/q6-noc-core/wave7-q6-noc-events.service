[Unit]
Description=Archive naturally occurring Wave7 Q6 NoC fatal logs (read-only SSH)
After=network-online.target

[Service]
Type=simple
ExecStart=/home/jan/scripts/wave7/q6-noc-core/watch-noc-events.sh --run
Restart=on-failure
RestartSec=12
Nice=10
UMask=0077
Environment=WAVE7_NOC_POLL_SECONDS=8

[Install]
WantedBy=default.target
