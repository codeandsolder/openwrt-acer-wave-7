 				 RTL8365MB_SDS_REG_LINK_STATUS, &status);
 	if (ret) {
+		mb->sds_rx_health.valid = false;
 		dev_err_ratelimited(priv->dev,
 				    "failed to read SerDes link status: %pe\n",
 				    ERR_PTR(ret));
 		goto rearm;
 	}
 	if (status & RTL8365MB_SDS_LINK_STATUS_LINK_MASK) {
-		/* Latched: end the episode, keep watching for a later loss. */
+		/* A link bit is not proof of frame integrity. Use the slow
+		 * poll cadence for corrupt-only ingress, even after an edge.
+		 */
 		WRITE_ONCE(mb->sds_relatch_count, 0);
 		delay = RTL8365MB_D_SDS_HEALTHCHECK_INTERVAL;
-		goto rearm;
-	}
-
+		if (!rtl8365mb_sds_rx_unhealthy(mb))
+			goto rearm;
+
+		attempts = 1;
+		goto park_lane;
+	}
+
+	mb->sds_rx_health.valid = false;
 	attempts = READ_ONCE(mb->sds_relatch_count);
 	if (!attempts) {
 		dev_warn(priv->dev,
@@ -1878,6 +2010,9 @@
 		 */
 		delay = RTL8365MB_D_SDS_HEALTHCHECK_INTERVAL;
 
+park_lane:
+	/* Never compare post-edge samples to the pre-edge baseline. */
+	mb->sds_rx_health.valid = false;
 	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
 				 RTL8365MB_D_SDS_MISC_CFG_MASK, park);
 	if (ret) {
@@ -3175,19 +3310,11 @@
 	spin_unlock(&p->stats_lock);
 }
 
