 /* Family D uses the SDS13 indirect window for its MAC6 SerDes. */
 #define RTL8365MB_D_SDS_EXT0_INDEX			13
+/* Undocumented recovery controls used by the stock RTL8367D DW8051.
+ * Names describe the observed pulse sequence, not a claimed bit meaning.
+ */
+#define RTL8365MB_D_SDS_RECOVERY_OUTER_REG	0x003f
+#define RTL8365MB_D_SDS_RECOVERY_OUTER_MASK	BIT(5)
+#define RTL8365MB_D_SDS_RECOVERY_INNER_REG	0x0400
+#define RTL8365MB_D_SDS_RECOVERY_INNER_MASK	BIT(2)
+#define RTL8365MB_D_SDS_RECOVERY_OUTER		BIT(0)
+#define RTL8365MB_D_SDS_RECOVERY_INNER		BIT(1)
 #define RTL8365MB_D_FIBER_CFG2_REG			0x13E8
 #define   RTL8365MB_D_FIBER_CFG2_RX_DISABLE_MASK	GENMASK(7, 6)
 #define   RTL8365MB_D_FIBER_CFG2_RX_DISABLE_SDS0	BIT(6)
@@ -377,10 +386,9 @@
