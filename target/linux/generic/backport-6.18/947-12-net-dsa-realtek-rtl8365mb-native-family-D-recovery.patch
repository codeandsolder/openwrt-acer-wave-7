+static int rtl8365mb_sds_read(struct realtek_priv *priv, u8 index,
+			      u16 addr, u16 *data)
+{
+	struct rtl8365mb *mb = priv->chip_data;
+
+	guard(mutex)(&mb->sds_lock);
+	return rtl8365mb_sds_read_locked(priv, index, addr, data);
+}
+
+/* The 0x6642 stock DW8051 checks SDS 0x003d bit 4 twice, then
+ * asserts SDS 0x003f bit 5, pulses 0x0400 bit 2, and releases bit 5.
+ * The MDIO transport can return an error after a write reached the
+ * device. Mark a control pending before the first assertion write;
+ * release it in reverse order even on an ambiguous write failure.
+ * Preserve unrelated bits on every write.
+ */
+static int rtl8365mb_d_sds_recovery_step(struct rtl8365mb *mb, u16 reg,
+					 u16 mask, unsigned int pending,
+					 bool assert)
+{
+	struct realtek_priv *priv = mb->priv;
+	u16 value;
+	int ret;
+
+	lockdep_assert_held(&mb->sds_lock);
+
+	ret = rtl8365mb_sds_read_locked(priv, RTL8365MB_D_SDS_EXT0_INDEX,
+					reg, &value);
+	if (ret)
+		return ret;
+
+	if (assert) {
+		mb->sds_recovery_pending |= pending;
+		value |= mask;
+	} else {
+		value &= ~mask;
+	}
+
+	ret = rtl8365mb_sds_write_locked(priv, RTL8365MB_D_SDS_EXT0_INDEX,
+					 reg, value);
+	if (!ret && !assert)
+		mb->sds_recovery_pending &= ~pending;
 
-out_unlock:
-	mutex_unlock(&mb->sds_lock);
 	return ret;
 }
 
+static int rtl8365mb_d_sds_recovery_clear_locked(struct rtl8365mb *mb)
+{
+	int ret;
+
+	if (mb->sds_recovery_pending & RTL8365MB_D_SDS_RECOVERY_INNER) {
+		ret = rtl8365mb_d_sds_recovery_step(mb,
+						    RTL8365MB_D_SDS_RECOVERY_INNER_REG,
+						    RTL8365MB_D_SDS_RECOVERY_INNER_MASK,
+						    RTL8365MB_D_SDS_RECOVERY_INNER, false);
+		if (ret)
+			return ret;
+	}
+
+	if (mb->sds_recovery_pending & RTL8365MB_D_SDS_RECOVERY_OUTER)
+		return rtl8365mb_d_sds_recovery_step(mb,
+						     RTL8365MB_D_SDS_RECOVERY_OUTER_REG,
+						     RTL8365MB_D_SDS_RECOVERY_OUTER_MASK,
+						     RTL8365MB_D_SDS_RECOVERY_OUTER, false);
+
+	return 0;
+}
+
+static int rtl8365mb_d_sds_recovery_finish_locked(struct rtl8365mb *mb)
+{
+	int i, ret;
+
+	for (i = 0; i < RTL8365MB_D_SDS_RESTORE_TRIES; i++) {
+		ret = rtl8365mb_d_sds_recovery_clear_locked(mb);
+		if (!ret)
+			return 0;
+		if (i < RTL8365MB_D_SDS_RESTORE_TRIES - 1)
+			usleep_range(1000, 2000);
+	}
+
+	dev_err_ratelimited(mb->priv->dev,
+			    "SerDes recovery controls still pending: %pe\n",
+			    ERR_PTR(ret));
+	return ret;
+}
+
+static int rtl8365mb_d_sds_recovery_finish(struct rtl8365mb *mb)
+{
+	guard(mutex)(&mb->sds_lock);
+	return rtl8365mb_d_sds_recovery_finish_locked(mb);
+}
+
+static int rtl8365mb_d_sds_recovery_pulse(struct rtl8365mb *mb)
+{
+	int ret, cleanup;
+
+	/* Do not allow another indirect transaction to interleave with
+	 * this entire four-step pulse, not just its individual accesses.
+	 */
+	guard(mutex)(&mb->sds_lock);
+
+	ret = rtl8365mb_d_sds_recovery_finish_locked(mb);
+	if (ret)
+		return ret;
+
+	ret = rtl8365mb_d_sds_recovery_step(mb,
+					    RTL8365MB_D_SDS_RECOVERY_OUTER_REG,
+					    RTL8365MB_D_SDS_RECOVERY_OUTER_MASK,
+					    RTL8365MB_D_SDS_RECOVERY_OUTER, true);
+	if (!ret)
+		ret = rtl8365mb_d_sds_recovery_step(mb,
+						    RTL8365MB_D_SDS_RECOVERY_INNER_REG,
+						    RTL8365MB_D_SDS_RECOVERY_INNER_MASK,
+						    RTL8365MB_D_SDS_RECOVERY_INNER, true);
+
+	cleanup = rtl8365mb_d_sds_recovery_finish_locked(mb);
+	return ret ?: cleanup;
+}
