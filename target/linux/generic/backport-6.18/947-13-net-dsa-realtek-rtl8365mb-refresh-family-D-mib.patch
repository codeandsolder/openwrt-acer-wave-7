+	u32 i;
+
+	/* RTL8367D stock code changes the selected SRAM row before requesting
+	 * it again. Writing the same address may leave the old latch intact.
+	 * Use another row within the same port, including for its last row.
+	 * The caller holds mib_lock across both transactions.
+	 */
+	if (verify) {
+		ret = regmap_read(priv->map, RTL8365MB_MIB_ADDRESS_REG, &val);
+		if (ret)
+			return ret;
+		if (val == addr) {
+			u32 other = offset >= RTL8365MB_MIB_ADDRESS_PORT_OFFSET - 4 ?
+				    addr - 1 : addr + 1;
+
+			ret = rtl8365mb_mib_select(priv, other, true);
+			if (ret)
+				return ret;
+		}
+	}
+
+	ret = rtl8365mb_mib_select(priv, addr, verify);
+	if (ret)
+		return ret;
 
