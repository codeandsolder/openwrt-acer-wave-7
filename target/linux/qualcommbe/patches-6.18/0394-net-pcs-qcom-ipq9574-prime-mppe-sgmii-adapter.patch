From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] net: pcs: qcom-ipq9574: prime MPPE SGMII adapter

The IPQ5332 MPPE path needs the SGMII channel adapter reset released
before the PCS can consume the external PHY's in-band status word.
Qualcomm SSDK performs this reset after enabling the port clocks during
its PHY-driven link-up sequence.

Phylink cannot reach pcs_link_up() in this state because in-band mode
requires PCS carrier first, creating a circular dependency on MPPE.
Prime the adapter after configuring in-band SGMII so PCS status can
resolve normally. Add bounded diagnostics for bring-up.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/pcs/pcs-qcom-ipq9574.c
+++ b/drivers/net/pcs/pcs-qcom-ipq9574.c
@@ -190,8 +190,13 @@
 
 	state->link = !!(val & PCS_MII_LINK_STS);
 
-	if (!state->link)
+	if (!state->link) {
+		if (qpcs->mppe)
+			dev_info_ratelimited(qpcs->dev,
+					     "MPPE SGMII waiting for link: sts=%#x\n",
+					     val);
 		return;
+	}
 
 	switch (FIELD_GET(PCS_MII_STS_SPEED_MASK, val)) {
 	case PCS_MII_STS_SPEED_1000:
@@ -554,6 +559,7 @@
 				unsigned int neg_mode,
 				phy_interface_t interface)
 {
+	unsigned int misc2, mode, ctrl, sts;
 	int ret;
 
 	/* Configure the PCS mode if required */
@@ -565,11 +571,43 @@
 
 	/* Set AN mode or force mode */
 	if (neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED)
-		return regmap_clear_bits(qpcs->regmap,
-					 PCS_MII_CTRL(index), PCS_MII_FORCE_MODE);
+		ret = regmap_clear_bits(qpcs->regmap,
+					PCS_MII_CTRL(index), PCS_MII_FORCE_MODE);
 	else
-		return regmap_set_bits(qpcs->regmap,
-				       PCS_MII_CTRL(index), PCS_MII_FORCE_MODE);
+		ret = regmap_set_bits(qpcs->regmap,
+				      PCS_MII_CTRL(index), PCS_MII_FORCE_MODE);
+	if (ret)
+		return ret;
+
+	/* MPPE's vendor link-up sequence enables the UNIPHY/MAC clocks,
+	 * waits 10 ms and then pulses the channel adapter reset before it
+	 * consumes SGMII in-band status. With phylink in in-band mode,
+	 * pcs_link_up() cannot provide that pulse: phylink waits for the
+	 * PCS link bit before calling pcs_link_up(), leaving MPPE stuck in
+	 * a reset-before-link / link-before-reset dependency.
+	 *
+	 * Prime the adapter here so PCS_MII_STS can receive the PHY's SGMII
+	 * status word. Keep this MPPE-only; IPQ9574 does not need the quirk.
+	 */
+	if (qpcs->mppe && neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED) {
+		fsleep(10000);
+		ret = regmap_clear_bits(qpcs->regmap, PCS_MII_CTRL(index),
+					PCS_MII_ADPT_RESET);
+		if (ret)
+			return ret;
+		ret = regmap_set_bits(qpcs->regmap, PCS_MII_CTRL(index),
+				      PCS_MII_ADPT_RESET);
+		if (ret)
+			return ret;
+		if (!regmap_read(qpcs->regmap, PCS_MISC2, &misc2) &&
+		    !regmap_read(qpcs->regmap, PCS_MODE_CTRL, &mode) &&
+		    !regmap_read(qpcs->regmap, PCS_MII_CTRL(index), &ctrl) &&
+		    !regmap_read(qpcs->regmap, PCS_MII_STS(index), &sts))
+			dev_info(qpcs->dev,
+				 "MPPE SGMII primed: misc2=%#x mode=%#x ctrl=%#x sts=%#x\n",
+				 misc2, mode, ctrl, sts);
+	}
+	return 0;
 }
 
 static int ipq_pcs_config_2500basex(struct ipq_pcs *qpcs)
