From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] qualcommbe: wave7: log MDIO and CMN controller state

The transaction-shape experiments do not restore reliable native Clause 45
access on Wave 7. Capture the broader controller state without changing
hardware behavior and compare it with the working vendor kernel.

Log the complete IPQ MDIO register window at reset entry and immediately
before the existing pre-scan. Log the IPQ5332 CMN PLL state on both sides
of clock-provider registration, which also brackets assigned-clock defaults
even when the requested rate already matches the inherited boot state.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -89,6 +89,16 @@
 				  IPQ4019_MDIO_SLEEP, IPQ4019_MDIO_TIMEOUT);
 }
 
+static void ipq4019_mdio_dump_state(struct mii_bus *bus, const char *stage)
+{
+	struct ipq4019_mdio_data *priv = bus->priv;
+	unsigned int offset;
+
+	for (offset = 0; offset <= 0x60; offset += sizeof(u32))
+		dev_info(bus->parent, "Wave7 MDIO state %s: reg=%#x val=%#x\n",
+			 stage, offset, readl(priv->membase + offset));
+}
+
 static int ipq4019_mdio_read_c45(struct mii_bus *bus, int mii_id, int mmd,
 				 int reg)
 {
@@ -328,6 +338,8 @@
 	u32 val;
 	int i, ret;
 
+	ipq4019_mdio_dump_state(bus, "reset-entry");
+
 	/* IPQ5332 needs the SoC UNIPHY clocks running before an external
 	 * PHY reset takes effect. The clocks are optional so older users
 	 * of this driver retain their existing behavior.
@@ -406,9 +418,11 @@
 
 	/* Restore MDC rate */
 	ret = ipq4019_mdio_set_div(priv);
-	if (!ret)
+	if (!ret) {
 		dev_info(bus->parent, "MDC rate %u Hz, mode register %#x\n",
 			 priv->mdc_rate, readl(priv->membase + MDIO_MODE_REG));
+		ipq4019_mdio_dump_state(bus, "pre-scan");
+	}
 	if (!ret) {
 		int id1, id2, spec, pma4, an20, serdes4;
 
--- a/drivers/clk/qcom/ipq-cmn-pll.c
+++ b/drivers/clk/qcom/ipq-cmn-pll.c
@@ -108,6 +108,25 @@
 
 #define to_clk_cmn_pll(_hw) container_of(_hw, struct clk_cmn_pll, hw)
 
+static void ipq_cmn_pll_dump_state(struct clk_cmn_pll *cmn_pll,
+				   const char *stage)
+{
+	u32 refsel, locked, power, refcfg, ctrl, divider;
+
+	if (!cmn_pll->eth_ldo_rdy)
+		return;
+
+	regmap_read(cmn_pll->regmap, CMN_PLL_REFCLK_SRC_SELECTION, &refsel);
+	regmap_read(cmn_pll->regmap, CMN_PLL_LOCKED, &locked);
+	regmap_read(cmn_pll->regmap, CMN_PLL_POWER_ON_AND_RESET, &power);
+	regmap_read(cmn_pll->regmap, CMN_PLL_REFCLK_CONFIG, &refcfg);
+	regmap_read(cmn_pll->regmap, CMN_PLL_CTRL, &ctrl);
+	regmap_read(cmn_pll->regmap, CMN_PLL_DIVIDER_CTRL, &divider);
+	pr_info("Wave7 CMN state %s: rate=%lu refsel=%#x locked=%#x power=%#x refcfg=%#x ctrl=%#x divider=%#x\n",
+		stage, clk_hw_get_rate(&cmn_pll->hw), refsel, locked, power,
+		refcfg, ctrl, divider);
+}
+
 static const struct regmap_config ipq_cmn_pll_regmap_config = {
 	.reg_bits = 32,
 	.reg_stride = 4,
@@ -357,6 +376,8 @@
 	if (ret)
 		return ERR_PTR(ret);
 
+	ipq_cmn_pll_dump_state(cmn_pll, "pre-provider");
+
 	return &cmn_pll->hw;
 }
 
@@ -412,6 +433,8 @@
 	hw_data->num = num_clks + 1;
 
 	ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, hw_data);
+	ipq_cmn_pll_dump_state(to_clk_cmn_pll(cmn_pll_hw),
+			       ret ? "post-provider-error" : "post-provider");
 	if (ret)
 		goto unregister_fixed_clk;
 
