From: Code and Solder <codeandsolder@gmail.com>
Subject: [PATCH] remoteproc: qcom: fix UserPD registration array indexing

ASIDs derived from SMP2P spawn bits are 1..MAX_UPD, while upd[] is
0..MAX_UPD-1. Use the validated zero-based index, rejecting invalid
and duplicate ASIDs before publishing the remoteproc.

Signed-off-by: Code and Solder <codeandsolder@gmail.com>
---
--- a/drivers/remoteproc/qcom_q6v5_mpd.c
+++ b/drivers/remoteproc/qcom_q6v5_mpd.c
@@ -884,17 +884,30 @@
 	ret = init_irq(&upd->q6, userpd_pdev, rproc,
 		       WCSS_CRASH_REASON, NULL, NULL);
 	if (ret)
 		goto free_rproc;
 
+	/* ASIDs are 1-based; the registered UserPD array is 0-based. */
+	if (!upd->pd_asid || upd->pd_asid > ARRAY_SIZE(wcss->upd)) {
+		dev_err(upd->dev, "UserPD ASID %u out of range\n",
+			upd->pd_asid);
+		ret = -ERANGE;
+		goto free_rproc;
+	}
+	if (wcss->upd[upd->pd_asid - 1]) {
+		dev_err(upd->dev, "duplicate UserPD ASID %u\n", upd->pd_asid);
+		ret = -EEXIST;
+		goto free_rproc;
+	}
+
 	rproc->dump_conf = RPROC_COREDUMP_ENABLED;
 	rproc->auto_boot = false;
 	ret = rproc_add(rproc);
 	if (ret)
 		goto free_rproc;
 
-	wcss->upd[upd->pd_asid] = upd;
+	wcss->upd[upd->pd_asid - 1] = upd;
 	platform_set_drvdata(userpd_pdev, rproc);
 	qcom_add_ssr_subdev(rproc, &upd->ssr_subdev, userpd_pdev->name);
 	return 0;
 
 free_rproc:
