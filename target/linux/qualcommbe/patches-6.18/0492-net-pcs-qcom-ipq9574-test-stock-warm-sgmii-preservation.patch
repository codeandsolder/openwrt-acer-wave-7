+/* Exact Wave7 direct copper PHY, not the independent RTL8367D trunk. */
+static bool ppe_port_wave7_phy(struct ppe_port *ppe_port,
+			       struct phy_device *phy)
+{
+	return !IS_ENABLED(CONFIG_PM_SLEEP) &&
+	       of_machine_is_compatible("acer,wave7") && ppe_port->port_id == 2 &&
+	       phy && phy->phy_id == 0x004dd101 && phy->mdio.addr == 0x18;
+}
+
 /* PPE port MAC configuration for phylink */
 static void ppe_port_mac_config(struct phylink_config *config,
 				unsigned int mode,
@@ -666,6 +675,10 @@
 	u32 val, mask;
 	int ret;
 
+	ppe_port->mac_configured = false;
+	if (ppe_port->wave7_relink)
+		ipq_pcs_wave7_relink_invalidate(ppe_port->pcs);
+
 	switch (state->interface) {
 	case PHY_INTERFACE_MODE_2500BASEX:
 	case PHY_INTERFACE_MODE_USXGMII:
@@ -699,6 +712,7 @@
 		goto err_mac_config;
 
 	ppe_port->mac_type = mac_type;
+	ppe_port->mac_configured = true;
 
 	return;
 
@@ -945,6 +959,15 @@
 	int ret, port = ppe_port->port_id;
 	u32 reg, val;
 
+	if (ppe_port->wave7_relink) {
+		ret = ipq_pcs_wave7_mac_prepare(ppe_port->pcs, mode, interface,
+						speed, duplex, tx_pause, rx_pause,
+						ppe_port->mac_configured &&
+						ppe_port_wave7_phy(ppe_port, phy));
+		if (ret)
+			goto err_port_mac_link_up;
+	}
+
 	/* Set PPE port MAC speed clock */
 	ret = ppe_port_mac_speed_clock_rate_set(ppe_port, interface, speed);
 	if (ret)
@@ -975,9 +998,14 @@
 	if (ret)
 		goto err_port_mac_link_up;
 
+	if (ppe_port->wave7_relink)
+		ipq_pcs_wave7_mac_finish(ppe_port->pcs, true);
+
 	return;
 
 err_port_mac_link_up:
+	if (ppe_port->wave7_relink)
+		ipq_pcs_wave7_mac_finish(ppe_port->pcs, false);
 	dev_err(ppe_dev->dev, "PPE port %d link up fail %d\n", port, ret);
 }
 
@@ -1042,6 +1070,8 @@
 	return;
 
 err_port_mac_link_down:
+	if (ppe_port->wave7_relink)
+		ipq_pcs_wave7_relink_invalidate(ppe_port->pcs);
 	dev_err(ppe_dev->dev, "PPE port %d link down fail %d\n", port, ret);
 }
 
@@ -1098,6 +1128,7 @@
 	struct phy_device *phydev;
 	int ret = 0;
 
+	ppe_port->wave7_relink = false;
 	phy_node = of_parse_phandle(ppe_port->np, "phy-handle", 0);
 	if (!phy_node)
 		return 0;
@@ -1109,6 +1140,8 @@
 
 	if (!device_is_bound(&phydev->mdio.dev))
 		ret = -EPROBE_DEFER;
+	else
+		ppe_port->wave7_relink = ppe_port_wave7_phy(ppe_port, phydev);
 
 	put_device(&phydev->mdio.dev);
 	return ret;
@@ -1147,6 +1180,12 @@
 		return PTR_ERR(ppe_port->pcs);
 	}
 
+	if (ppe_port->wave7_relink) {
+		ret = ipq_pcs_wave7_relink_enable(ppe_port->pcs);
