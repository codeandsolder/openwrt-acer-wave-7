From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] net: mdio: ipq4019: restore MDC divider for each transfer

Qualcomm downstream programs the selected MDC divider on every Clause 22
and Clause 45 transaction. The upstream driver instead restores it only
at probe/reset time. Match the downstream transaction semantics so a mode
change or intervening hardware state cannot leave IPQ53xx transfers using
a stale divider.

Log the restored mode word after bus reset while Wave 7 bring-up is still
in progress, so the divider and preserved controller mode bits are
observable in ramoops.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -77,6 +77,8 @@
 	[MDIO_CLK_UNIPHY1_SYS] = "gcc_uniphy1_sys_clk",
 };
 
+static int ipq4019_mdio_set_div(struct ipq4019_mdio_data *priv);
+
 static int ipq4019_mdio_wait_busy(struct mii_bus *bus)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
@@ -97,6 +99,13 @@
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
+	/* Qualcomm downstream restores the configured MDC divider before
+	 * every transaction. Keep that behavior so mode changes cannot leave
+	 * the controller running with a stale divider.
+	 */
+	if (ipq4019_mdio_set_div(priv))
+		return -EINVAL;
+
 	data = readl(priv->membase + MDIO_MODE_REG);
 
 	data |= MDIO_MODE_C45;
@@ -138,6 +147,13 @@
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
+	/* Qualcomm downstream restores the configured MDC divider before
+	 * every transaction. Keep that behavior so mode changes cannot leave
+	 * the controller running with a stale divider.
+	 */
+	if (ipq4019_mdio_set_div(priv))
+		return -EINVAL;
+
 	data = readl(priv->membase + MDIO_MODE_REG);
 
 	data &= ~MDIO_MODE_C45;
@@ -170,6 +186,13 @@
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
+	/* Qualcomm downstream restores the configured MDC divider before
+	 * every transaction. Keep that behavior so mode changes cannot leave
+	 * the controller running with a stale divider.
+	 */
+	if (ipq4019_mdio_set_div(priv))
+		return -EINVAL;
+
 	data = readl(priv->membase + MDIO_MODE_REG);
 
 	data |= MDIO_MODE_C45;
@@ -211,6 +234,13 @@
 
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
+
+	/* Qualcomm downstream restores the configured MDC divider before
+	 * every transaction. Keep that behavior so mode changes cannot leave
+	 * the controller running with a stale divider.
+	 */
+	if (ipq4019_mdio_set_div(priv))
+		return -EINVAL;
 
 	/* Enter Clause 22 mode */
 	data = readl(priv->membase + MDIO_MODE_REG);
@@ -353,7 +383,12 @@
 	mdelay(10);
 
 	/* Restore MDC rate */
-	return ipq4019_mdio_set_div(priv);
+	ret = ipq4019_mdio_set_div(priv);
+	if (!ret)
+		dev_info(bus->parent, "MDC rate %u Hz, mode register %#x\n",
+			 priv->mdc_rate, readl(priv->membase + MDIO_MODE_REG));
+
+	return ret;
 }
 
 static void ipq4019_mdio_select_mdc_rate(struct platform_device *pdev,
