From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] net: mdio: ipq4019: restore Wave7 UNIPHY PHY reference clock

The Wave 7 bootloader explicitly leaves bit 0 set in both UNIPHY clock
output registers before Linux starts. The 0416 hardware trace shows the
mainline bring-up loses that bit before the external PHY reset, exactly
where the previously healthy QCA8081 Clause-45 state becomes stale.

Restore only the bootloader's clock-output enable bit after the UNIPHY
clocks are live and before any attached PHY is reset. Keep the other
Linux-programmed UNIPHY fields untouched so this is a narrow hardware
A/B for the reference-clock hypothesis.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -421,6 +421,31 @@
 		iounmap(gcc);
 }
 
+static int ipq4019_mdio_restore_wave7_refclk(struct mii_bus *bus)
+{
+	void __iomem *uniphy;
+	u32 u0, u1;
+
+	if (!of_device_is_compatible(bus->parent->of_node, "qcom,ipq5332-mdio"))
+		return 0;
+
+	uniphy = ioremap(WAVE7_UNIPHY_BASE, WAVE7_UNIPHY_SIZE);
+	if (!uniphy)
+		return -ENOMEM;
+
+	u0 = readl(uniphy + 0x00610);
+	u1 = readl(uniphy + 0x10610);
+	writel(u0 | BIT(0), uniphy + 0x00610);
+	writel(u1 | BIT(0), uniphy + 0x10610);
+
+	dev_info(bus->parent,
+		 "Wave7 UNIPHY refclk restore: u0=%#x->%#x u1=%#x->%#x\n",
+		 u0, readl(uniphy + 0x00610), u1, readl(uniphy + 0x10610));
+
+	iounmap(uniphy);
+	return 0;
+}
+
 static int ipq_mdio_reset(struct mii_bus *bus)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
@@ -461,6 +486,15 @@
 			return ret;
 	}
 
+	/* APPSBL leaves the external-PHY reference clock output enabled on both
+	 * UNIPHY blocks. Restore only that explicit bootloader bit before any
+	 * attached PHY is reset; leave every other Linux-programmed field intact.
+	 */
+	ret = ipq4019_mdio_restore_wave7_refclk(bus);
+	if (ret)
+		return ret;
+	ipq4019_mdio_dump_wave7_clock_state(bus, "refclk-restored");
+
 	/* To indicate CMN_PLL that ethernet_ldo has been ready if platform resource 1
 	 * is specified in the device tree.
 	 */
