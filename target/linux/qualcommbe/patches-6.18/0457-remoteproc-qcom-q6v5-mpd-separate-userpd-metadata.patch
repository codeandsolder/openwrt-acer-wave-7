+static int q6_parse_userpd_metadata(struct q6_wcss *wcss)
+{
+	struct device_node *np = wcss->dev->of_node;
+	bool has_firmware, has_asids;
+	int fw_count, asid_count, i, j, ret;
+	u32 asid;
+
+	has_firmware = of_property_present(np, "qcom,userpd-firmware-names");
+	has_asids = of_property_present(np, "qcom,userpd-asids");
+	if (!has_firmware && !has_asids)
+		return 0;
+
+	if (!has_firmware || !has_asids)
+		return dev_err_probe(wcss->dev, -EINVAL,
+				     "userpd firmware names and ASIDs must be provided together\n");
+
+	fw_count = of_property_count_strings(np, "qcom,userpd-firmware-names");
+	asid_count = of_property_count_u32_elems(np, "qcom,userpd-asids");
+	if (fw_count <= 0 || fw_count > MAX_UPD || asid_count != fw_count)
+		return dev_err_probe(wcss->dev, -EINVAL,
+				     "invalid userpd metadata: firmware=%d asids=%d\n",
+				     fw_count, asid_count);
+
+	for (i = 0; i < fw_count; i++) {
+		ret = of_property_read_string_index(np, "qcom,userpd-firmware-names",
+						i, &wcss->userpd_firmware[i]);
+		if (ret)
+			return ret;
+
+		ret = of_property_read_u32_index(np, "qcom,userpd-asids", i, &asid);
+		if (ret)
+			return ret;
+		if (!asid || asid >= U8_MAX)
+			return dev_err_probe(wcss->dev, -EINVAL,
+					     "invalid userpd ASID %u\n", asid);
+
+		for (j = 0; j < i; j++)
+			if (wcss->userpd_asid[j] == asid)
+				return dev_err_probe(wcss->dev, -EINVAL,
+						     "duplicate userpd ASID %u\n", asid);
+
+		wcss->userpd_asid[i] = asid;
+	}
+
+	wcss->userpd_count = fw_count;
+	return 0;
+}
+
+static int q6_write_userpd_bootinfo(struct rproc *rproc, void **ptr, u8 asid,
+				    const char *firmware_name)
+{
+	struct q6_wcss *wcss = rproc->priv;
+	struct userpd_boot_info bootinfo = {
+		.header.type = UPD_BOOT_INFO_HEADER_TYPE,
+		.header.length = sizeof(bootinfo) - sizeof(bootinfo.header),
+		.pid = asid + 1,
+	};
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, firmware_name, wcss->dev);
+	if (ret)
+		return dev_err_probe(wcss->dev, ret,
+				     "failed to request userpd firmware %s\n",
+				     firmware_name);
+
+	bootinfo.bootaddr = rproc_get_boot_addr(rproc, fw);
+	bootinfo.data_size = qcom_mdt_get_size(fw);
+	release_firmware(fw);
+
+	memcpy_toio(*ptr, &bootinfo, sizeof(bootinfo));
+	*ptr += sizeof(bootinfo);
+
+	return 0;
+}
