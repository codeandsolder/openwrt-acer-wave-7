From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] net: mdio: ipq4019: trace Wave 7 C45 state transitions

Wave 7 bring-up currently sees valid Clause 22 QCA8081 traffic but stale
values from both native Clause 45 and Clause 22 MMD accesses. The exact
IPQ4019 native C45 transaction works under the vendor kernel, so capture
the controller state around representative C45 reads and sample the PHY
before phylib enumerates and resets it.

This is intentionally bring-up instrumentation and should be removed once
the state transition which breaks MMD access is identified.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -93,8 +93,12 @@
 				 int reg)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
+	unsigned int addr_mode, addr_addr, addr_wr, addr_rd, addr_cmd;
 	unsigned int data;
 	unsigned int cmd;
+	bool trace;
+
+	trace = (mii_id == 0x18 || mii_id == 0x19) && (mmd == 1 || mmd == 7);
 
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
@@ -123,10 +127,18 @@
 	/* issue read command */
 	writel(cmd, priv->membase + MDIO_CMD_REG);
 
-	/* Wait read complete */
+	/* Wait address phase complete */
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
+	if (trace) {
+		addr_mode = readl(priv->membase + MDIO_MODE_REG);
+		addr_addr = readl(priv->membase + MDIO_ADDR_REG);
+		addr_wr = readl(priv->membase + MDIO_DATA_WRITE_REG);
+		addr_rd = readl(priv->membase + MDIO_DATA_READ_REG);
+		addr_cmd = readl(priv->membase + MDIO_CMD_REG);
+	}
+
 	cmd = MDIO_CMD_ACCESS_START | MDIO_CMD_ACCESS_CODE_C45_READ;
 
 	writel(cmd, priv->membase + MDIO_CMD_REG);
@@ -134,8 +146,18 @@
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
-	/* Read and return data */
-	return readl(priv->membase + MDIO_DATA_READ_REG);
+	data = readl(priv->membase + MDIO_DATA_READ_REG);
+	if (trace)
+		dev_info(bus->parent,
+			 "C45 trace phy=%#x mmd=%#x reg=%#x: addr-phase mode=%#x addr=%#x wr=%#x rd=%#x cmd=%#x; read-phase mode=%#x addr=%#x wr=%#x rd=%#x cmd=%#x\n",
+			 mii_id, mmd, reg, addr_mode, addr_addr, addr_wr,
+			 addr_rd, addr_cmd,
+			 readl(priv->membase + MDIO_MODE_REG),
+			 readl(priv->membase + MDIO_ADDR_REG),
+			 readl(priv->membase + MDIO_DATA_WRITE_REG), data,
+			 readl(priv->membase + MDIO_CMD_REG));
+
+	return data;
 }
 
 static int ipq4019_mdio_read_c22(struct mii_bus *bus, int mii_id, int regnum)
@@ -387,6 +409,19 @@
 	if (!ret)
 		dev_info(bus->parent, "MDC rate %u Hz, mode register %#x\n",
 			 priv->mdc_rate, readl(priv->membase + MDIO_MODE_REG));
+	if (!ret) {
+		int id1, id2, spec, pma4, an20, serdes4;
+
+		id1 = ipq4019_mdio_read_c22(bus, 0x18, MII_PHYSID1);
+		id2 = ipq4019_mdio_read_c22(bus, 0x18, MII_PHYSID2);
+		spec = ipq4019_mdio_read_c22(bus, 0x18, 0x11);
+		pma4 = ipq4019_mdio_read_c45(bus, 0x18, 1, 4);
+		an20 = ipq4019_mdio_read_c45(bus, 0x18, 7, 0x20);
+		serdes4 = ipq4019_mdio_read_c45(bus, 0x19, 1, 4);
+		dev_info(bus->parent,
+			 "Wave7 pre-scan MDIO: id=%#x:%#x spec=%#x pma4=%#x an20=%#x serdes4=%#x\n",
+			 id1, id2, spec, pma4, an20, serdes4);
+	}
 
 	return ret;
 }
