From: Code and Solder <codeandsolder@gmail.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: honor EDMA hardware reset timing

The EDMA driver documents a required 100 ms reset delay, but used
fsleep(100), which takes microseconds. Its reset pulse and settling
interval were therefore 1000 times shorter than intended.

Keep the reset asserted for 100 ms and give the hardware another
100 ms to settle after deassertion. Also propagate errors from the
reset controller, so a failed reset cannot silently pass initialization.

Signed-off-by: Code and Solder <codeandsolder@gmail.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma.c
@@ -626,31 +626,39 @@
 {
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct device *dev = ppe_dev->dev;
 	struct reset_control *edma_hw_rst;
 	struct device_node *edma_np;
+	int ret;
 
 	edma_np = of_get_child_by_name(dev->of_node, EDMA_NODE_NAME);
+	if (!edma_np)
+		return -ENODEV;
 	edma_hw_rst = of_reset_control_array_get_exclusive(edma_np);
 	if (IS_ERR(edma_hw_rst)) {
 		of_node_put(edma_np);
 		return PTR_ERR(edma_hw_rst);
 	}
 
-	/* 100ms delay is required by hardware to reset EDMA. */
-	reset_control_assert(edma_hw_rst);
-	fsleep(100);
-
-	reset_control_deassert(edma_hw_rst);
-	fsleep(100);
-
+	/* The EDMA hardware requires 100 ms on each side of reset. */
+	ret = reset_control_assert(edma_hw_rst);
+	if (ret)
+		goto release_reset;
+	msleep(100);
+
+	ret = reset_control_deassert(edma_hw_rst);
+	if (ret)
+		goto release_reset;
+	msleep(100);
+
+	dev_dbg(dev, "EDMA HW reset\n");
+
+release_reset:
 	reset_control_put(edma_hw_rst);
-	dev_dbg(dev, "EDMA HW reset\n");
-
 	of_node_put(edma_np);
 
-	return 0;
+	return ret;
 }
 
 static int edma_hw_configure(void)
 {
 	struct edma_hw_info *hw_info = edma_ctx->hw_info;
