From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] net: mdio: ipq4019: add IPQ5332 UNIPHY reset sequencing

IPQ5332 requires its UNIPHY AHB/SYS clocks and ethernet LDO-ready bit
to be enabled before reset of an attached external PHY takes effect.
Allow the MDIO node to provide these optional clocks and a bus-level
ordered PHY-reset GPIO list, preserving existing behavior on older SoCs.
Shipping QSDK walks that list in DT order, asserting and deasserting each
reset independently for 100-110 ms before advancing to the next device.

This is the minimal subset needed for the Wave 7 QCA8081 bring-up.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -12,6 +12,7 @@
 #include <linux/phy.h>
 #include <linux/platform_device.h>
 #include <linux/clk.h>
+#include <linux/gpio/consumer.h>
 
 #define MDIO_MODE_REG				0x40
 #define   MDIO_MODE_MDC_MODE			BIT(12)
@@ -45,14 +46,36 @@
 
 /* MDIO clock source frequency is fixed to 100M */
 #define IPQ_MDIO_CLK_RATE	100000000
+#define IPQ_UNIPHY_AHB_CLK_RATE	100000000
+#define IPQ_UNIPHY_SYS_CLK_RATE	24000000
 
 #define IPQ_PHY_SET_DELAY_US	100000
+#define IPQ_PHY_RESET_MIN_US	100000
+#define IPQ_PHY_RESET_MAX_US	110000
+
+enum mdio_clk_id {
+	MDIO_CLK_MDIO_AHB,
+	MDIO_CLK_UNIPHY0_AHB,
+	MDIO_CLK_UNIPHY0_SYS,
+	MDIO_CLK_UNIPHY1_AHB,
+	MDIO_CLK_UNIPHY1_SYS,
+	MDIO_CLK_CNT,
+};
 
 struct ipq4019_mdio_data {
 	void __iomem	*membase;
 	void __iomem *eth_ldo_rdy;
-	struct clk *mdio_clk;
+	struct clk *clk[MDIO_CLK_CNT];
+	struct gpio_descs *reset_gpios;
 	unsigned int mdc_rate;
+};
+
+static const char *const mdio_clk_name[MDIO_CLK_CNT] = {
+	[MDIO_CLK_MDIO_AHB] = "gcc_mdio_ahb_clk",
+	[MDIO_CLK_UNIPHY0_AHB] = "gcc_uniphy0_ahb_clk",
+	[MDIO_CLK_UNIPHY0_SYS] = "gcc_uniphy0_sys_clk",
+	[MDIO_CLK_UNIPHY1_AHB] = "gcc_uniphy1_ahb_clk",
+	[MDIO_CLK_UNIPHY1_SYS] = "gcc_uniphy1_sys_clk",
 };
 
 static int ipq4019_mdio_wait_busy(struct mii_bus *bus)
@@ -223,8 +246,8 @@
 
 	/* If we don't have a clock for AHB use the fixed value */
 	ahb_rate = IPQ_MDIO_CLK_RATE;
-	if (priv->mdio_clk)
-		ahb_rate = clk_get_rate(priv->mdio_clk);
+	if (priv->clk[MDIO_CLK_MDIO_AHB])
+		ahb_rate = clk_get_rate(priv->clk[MDIO_CLK_MDIO_AHB]);
 
 	/* MDC rate is ahb_rate/(MDIO_MODE_DIV + 1)
 	 * While supported, internal documentation doesn't
@@ -250,8 +273,39 @@
 static int ipq_mdio_reset(struct mii_bus *bus)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
+	unsigned long rate;
 	u32 val;
-	int ret;
+	int i, ret;
+
+	/* IPQ5332 needs the SoC UNIPHY clocks running before an external
+	 * PHY reset takes effect. The clocks are optional so older users
+	 * of this driver retain their existing behavior.
+	 */
+	for (i = MDIO_CLK_UNIPHY0_AHB; i < MDIO_CLK_CNT; i++) {
+		if (!priv->clk[i])
+			continue;
+
+		switch (i) {
+		case MDIO_CLK_UNIPHY0_AHB:
+		case MDIO_CLK_UNIPHY1_AHB:
+			rate = IPQ_UNIPHY_AHB_CLK_RATE;
+			break;
+		case MDIO_CLK_UNIPHY0_SYS:
+		case MDIO_CLK_UNIPHY1_SYS:
+			rate = IPQ_UNIPHY_SYS_CLK_RATE;
+			break;
+		default:
+			return -EINVAL;
+		}
+
+		ret = clk_set_rate(priv->clk[i], rate);
+		if (ret)
+			return ret;
+
+		ret = clk_prepare_enable(priv->clk[i]);
+		if (ret)
+			return ret;
+	}
 
 	/* To indicate CMN_PLL that ethernet_ldo has been ready if platform resource 1
 	 * is specified in the device tree.
@@ -263,14 +317,29 @@
 		fsleep(IPQ_PHY_SET_DELAY_US);
 	}
 
+	/* Shipping QSDK walks phy-reset-gpio in DT order and resets each
+	 * attached device separately: 100-110ms asserted, then 100-110ms
+	 * deasserted before advancing to the next GPIO.
+	 */
+	if (priv->reset_gpios) {
+		for (i = 0; i < priv->reset_gpios->ndescs; i++) {
+			gpiod_set_value_cansleep(priv->reset_gpios->desc[i], 1);
+			usleep_range(IPQ_PHY_RESET_MIN_US, IPQ_PHY_RESET_MAX_US);
+			gpiod_set_value_cansleep(priv->reset_gpios->desc[i], 0);
+			usleep_range(IPQ_PHY_RESET_MIN_US, IPQ_PHY_RESET_MAX_US);
+		}
+	}
+
 	/* Configure MDIO clock source frequency if clock is specified in the device tree */
-	ret = clk_set_rate(priv->mdio_clk, IPQ_MDIO_CLK_RATE);
-	if (ret)
-		return ret;
-
-	ret = clk_prepare_enable(priv->mdio_clk);
-	if (ret)
-		return ret;
+	if (priv->clk[MDIO_CLK_MDIO_AHB]) {
+		ret = clk_set_rate(priv->clk[MDIO_CLK_MDIO_AHB], IPQ_MDIO_CLK_RATE);
+		if (ret)
+			return ret;
+
+		ret = clk_prepare_enable(priv->clk[MDIO_CLK_MDIO_AHB]);
+		if (ret)
+			return ret;
+	}
 
 	mdelay(10);
 
@@ -292,8 +361,8 @@
 
 	/* If we don't have a clock for AHB use the fixed value */
 	ahb_rate = IPQ_MDIO_CLK_RATE;
-	if (priv->mdio_clk)
-		ahb_rate = clk_get_rate(priv->mdio_clk);
+	if (priv->clk[MDIO_CLK_MDIO_AHB])
+		ahb_rate = clk_get_rate(priv->clk[MDIO_CLK_MDIO_AHB]);
 
 	/* Check what is the current div set */
 	val = readl(priv->membase + MDIO_MODE_REG);
@@ -340,9 +409,11 @@
 	if (IS_ERR(priv->membase))
 		return PTR_ERR(priv->membase);
 
-	priv->mdio_clk = devm_clk_get_optional(&pdev->dev, "gcc_mdio_ahb_clk");
-	if (IS_ERR(priv->mdio_clk))
-		return PTR_ERR(priv->mdio_clk);
+	for (ret = 0; ret < MDIO_CLK_CNT; ret++) {
+		priv->clk[ret] = devm_clk_get_optional(&pdev->dev, mdio_clk_name[ret]);
+		if (IS_ERR(priv->clk[ret]))
+			return PTR_ERR(priv->clk[ret]);
+	}
 
 	ipq4019_mdio_select_mdc_rate(pdev, priv);
 	ret = ipq4019_mdio_set_div(priv);
@@ -357,6 +428,12 @@
 		if (IS_ERR(priv->eth_ldo_rdy))
 			return PTR_ERR(priv->eth_ldo_rdy);
 	}
+
+	priv->reset_gpios = devm_gpiod_get_array_optional(&pdev->dev,
+							  "phy-reset", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->reset_gpios))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->reset_gpios),
+				     "could not get PHY reset GPIOs\n");
 
 	bus->name = "ipq4019_mdio";
 	bus->read = ipq4019_mdio_read_c22;
@@ -388,6 +465,7 @@
 static const struct of_device_id ipq4019_mdio_dt_ids[] = {
 	{ .compatible = "qcom,ipq4019-mdio" },
 	{ .compatible = "qcom,ipq5018-mdio" },
+	{ .compatible = "qcom,ipq5332-mdio" },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, ipq4019_mdio_dt_ids);
