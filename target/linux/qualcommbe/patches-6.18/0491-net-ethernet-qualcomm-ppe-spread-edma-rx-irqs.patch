Subject: [PATCH] net: ethernet: qualcomm: spread EDMA RX IRQs and honor RPS mask

PPE RSS sends distinct flow hash buckets to four RX descriptor rings,
but their IRQs currently all default to CPU0. Their NAPI polls thus
share one softirq bottleneck, limiting 2.5GbE receive throughput.

Distribute RX IRQs across online CPUs, with affinity hints that are
cleared on teardown. Failure to set IRQ affinity is nonfatal.
Also unwind already-registered RX IRQs correctly if registration fails.

The rps_bitmap_cores sysctl was ineffective because the RSS mapping
function read a hard-coded mask; use its configured value instead.

Measured live IPQ5332, 2.5GbE Asus-to-router TCP receive:
1 stream: 1741.81 -> 2228.04 Mbps (+27.9%).
4 streams: 1573.30 -> 2347.87 Mbps (+49.2%).
The standalone A/B restored all IRQ affinities afterward.

---
diff --git a/drivers/net/ethernet/qualcomm/ppe/edma.c b/drivers/net/ethernet/qualcomm/ppe/edma.c
--- a/drivers/net/ethernet/qualcomm/ppe/edma.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma.c
@@ -5,10 +5,12 @@
  /* Qualcomm Ethernet DMA driver setup, HW configuration, clocks and
   * interrupt initializations.
   */
 
 #include <linux/clk.h>
+#include <linux/cpumask.h>
+#include <linux/interrupt.h>
 #include <linux/delay.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/netdevice.h>
 #include <linux/of_irq.h>
@@ -455,11 +457,11 @@
 	for (i = 0; i < rx->num_rings; i++) {
 		edma_rxdesc_irq_name[i] = kzalloc((sizeof(char *) * EDMA_IRQ_NAME_SIZE),
 						  GFP_KERNEL);
 		if (!edma_rxdesc_irq_name[i]) {
 			ret = -ENOMEM;
-			goto rxdesc_ring_irq_name_alloc_fail;
+			goto rx_desc_ring_intr_req_fail;
 		}
 
 		snprintf(edma_rxdesc_irq_name[i], 20, "rxdesc_%d",
 			 rx->ring_start + i);
 
@@ -477,10 +479,20 @@
 
 		pr_debug("RXDESC ring: %d IRQ:%d request success: %s\n",
 			 rx->ring_start + i,
 			 edma_ctx->intr_info.intr_rx[i],
 			 edma_rxdesc_irq_name[i]);
+
+		/*
+		 * Hardware RSS maps each queue group to a different RX ring.
+		 * Keep the ring's interrupt/NAPI work on a distinct online CPU.
+		 */
+		ret = irq_set_affinity_and_hint(edma_ctx->intr_info.intr_rx[i],
+				cpumask_of(cpumask_local_spread(i, dev_to_node(dev))));
+		if (ret)
+			dev_warn(dev, "RXDESC ring %u IRQ %d affinity unavailable: %d\n",
+				 rx->ring_start + i, edma_ctx->intr_info.intr_rx[i], ret);
 	}
 
 	/* Request Misc IRQ */
 	ret = request_irq(edma_ctx->intr_info.intr_misc, edma_misc_handle_irq,
 			  IRQF_SHARED, "misc",
@@ -492,20 +504,22 @@
 	}
 
 	return 0;
 
 misc_intr_req_fail:
-	/* Free IRQ for RXDESC rings */
-	for (i = 0; i < rx->num_rings; i++) {
+	i = rx->num_rings;
+rx_desc_ring_intr_req_fail:
+	/* Only IRQs successfully requested before index i are owned here. */
+	while (i > 0) {
+		i--;
+		irq_update_affinity_hint(edma_ctx->intr_info.intr_rx[i], NULL);
 		synchronize_irq(edma_ctx->intr_info.intr_rx[i]);
 		free_irq(edma_ctx->intr_info.intr_rx[i],
 			 (void *)&edma_ctx->rx_rings[i]);
 	}
-rx_desc_ring_intr_req_fail:
 	for (i = 0; i < rx->num_rings; i++)
 		kfree(edma_rxdesc_irq_name[i]);
-rxdesc_ring_irq_name_alloc_fail:
 	kfree(edma_rxdesc_irq_name);
 rxdesc_irq_name_alloc_fail:
 	for (i = 0; i < txcmpl->num_rings; i++) {
 		synchronize_irq(edma_ctx->intr_info.intr_txcmpl[i]);
 		free_irq(edma_ctx->intr_info.intr_txcmpl[i],
@@ -835,10 +849,11 @@
 	}
 	kfree(edma_txcmpl_irq_name);
 
 	/* Free IRQ for Rx DESC rings */
 	for (i = 0; i < rx->num_rings; i++) {
+		irq_update_affinity_hint(edma_ctx->intr_info.intr_rx[i], NULL);
 		synchronize_irq(edma_ctx->intr_info.intr_rx[i]);
 		free_irq(edma_ctx->intr_info.intr_rx[i],
 			 (void *)&edma_ctx->rx_rings[i]);
 		kfree(edma_rxdesc_irq_name[i]);
 	}

diff --git a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
--- a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
@@ -1001,11 +1001,11 @@
  *
  * Initialize and configure RPS hash map for queues
  */
 int edma_cfg_rx_rps_hash_map(void)
 {
-	cpumask_t edma_rps_cpumask = {{EDMA_RX_DEFAULT_BITMAP}};
+	cpumask_t edma_rps_cpumask = {{READ_ONCE(edma_cfg_rx_rps_bitmap_cores)}};
 	int map_len = 0, idx = 0, ret = 0;
 	u32 q_off = EDMA_RX_QUEUE_START;
 	u32 q_map[EDMA_MAX_CORE] = {0};
 	u32 hash, cpu;
 
