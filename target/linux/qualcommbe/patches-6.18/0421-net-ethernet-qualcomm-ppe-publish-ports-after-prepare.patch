From: Wave 7 bring-up <noreply@example.com>
Subject: [PATCH] net: ethernet: qualcomm: publish PPE ports after preparation

PPE currently publishes the switch-facing EDMA netdevice before checking
that subsequent PHY-backed ports can be prepared. A later -EPROBE_DEFER
then unregisters the conduit while DSA can concurrently bind to it,
followed by an EDMA reset and a deferred PPE retry.

Prepare all ports before publishing any netdevice. Track registered
netdevices explicitly so unwind works before and after registration.
Unregister prior to deconfiguring the NAPI and phylink used by ndo_stop().

---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.c
@@ -333,23 +333,28 @@
 	int port_id = port->port_id;
 	struct net_device *netdev = edma_ctx->netdev_arr[port_id - 1];
 
+	struct edma_port_priv *priv = netdev_priv(netdev);
+
+	/* ndo_stop uses NAPI and phylink; unregister before teardown. */
+	if (priv->registered)
+		unregister_netdev(netdev);
+
 	edma_port_deconfigure(netdev);
-	edma_port_stats_free(netdev);
-	unregister_netdev(netdev);
-	free_netdev(netdev);
 	ppe_port_phylink_destroy(port);
+	edma_port_stats_free(netdev);
 	edma_ctx->netdev_arr[port_id - 1] = NULL;
+	free_netdev(netdev);
 }
 
 /**
- * edma_port_setup - EDMA port Setup.
+ * edma_port_prepare - Prepare an EDMA port without registering it.
  * @port: PPE port
  *
- * Initialize and register the netdevice.
+ * Initialize the netdevice, DMA and phylink, but do not publish it.
  *
  * Return 0 on success, negative error code on failure.
  */
-int edma_port_setup(struct ppe_port *port)
+int edma_port_prepare(struct ppe_port *port)
 {
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct device_node *np = port->np;
@@ -429,18 +434,8 @@
 		goto port_phylink_setup_fail;
 	}
 
-	ret = register_netdev(netdev);
-	if (ret) {
-		netdev_dbg(netdev, "Error registering netdevice %s\n",
-			   netdev->name);
-		goto register_netdev_fail;
-	}
+	return 0;
 
-	netdev_dbg(netdev, "Setup EDMA port%d done\n", port_id);
-	return ret;
-
-register_netdev_fail:
-	ppe_port_phylink_destroy(port);
 port_phylink_setup_fail:
 	edma_port_deconfigure(netdev);
 	edma_ctx->netdev_arr[port_id - 1] = NULL;
@@ -450,3 +445,20 @@
 
 	return ret;
 }
+
+int edma_port_register(struct ppe_port *port)
+{
+	struct net_device *netdev = edma_ctx->netdev_arr[port->port_id - 1];
+	struct edma_port_priv *priv = netdev_priv(netdev);
+	int ret;
+
+	ret = register_netdev(netdev);
+	if (ret) {
+		netdev_err(netdev, "Failed to register EDMA port %u: %d\n",
+			   port->port_id, ret);
+		return ret;
+	}
+
+	priv->registered = true;
+	return 0;
+}
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.h
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.h
@@ -83,6 +83,7 @@
  * @pcpu_stats: Per CPU netdev statistics
  * @txr_map: Tx ring per-core mapping
  * @flags: Feature flags
+ * @registered: Whether this netdevice was registered
  */
 struct edma_port_priv {
 	struct ppe_port *ppe_port;
@@ -90,8 +91,10 @@
 	struct edma_port_pcpu_stats pcpu_stats;
 	struct edma_txdesc_ring *txr_map[EDMA_PORT_MAX_CORE];
 	unsigned long flags;
+	bool registered;
 };
 
 void edma_port_destroy(struct ppe_port *port);
-int edma_port_setup(struct ppe_port *port);
+int edma_port_prepare(struct ppe_port *port);
+int edma_port_register(struct ppe_port *port);
 #endif
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
@@ -1367,7 +1367,7 @@
 {
 	struct device_node *ports_node, *port_node;
 	struct ppe_ports *ppe_ports;
-	int port, num, ret, i = 0;
+	int port, num, ret, i = 0, j;
 	phy_interface_t phy_mode;
 
 	ports_node = of_get_child_by_name(ppe_dev->dev->of_node,
@@ -1421,7 +1421,7 @@
 			goto err_current_clock;
 		}
 
-		ret = edma_port_setup(&ppe_ports->port[i]);
+		ret = edma_port_prepare(&ppe_ports->port[i]);
 		if (ret) {
 			dev_err(ppe_dev->dev, "QCOM EDMA port setup failed\n");
 			goto err_current_clock;
@@ -1430,6 +1430,16 @@
 		i++;
 	}
 
+	/* DSA may attach to the first published conduit immediately.
+	 * Complete all port preparation before registering any netdevice,
+	 * so PHY probe deferral never invalidates a published conduit.
+	 */
+	for (j = 0; j < i; j++) {
+		ret = edma_port_register(&ppe_ports->port[j]);
+		if (ret)
+			goto err_cleanup_ports;
+	}
+
 	of_node_put(ports_node);
 	return 0;
 
