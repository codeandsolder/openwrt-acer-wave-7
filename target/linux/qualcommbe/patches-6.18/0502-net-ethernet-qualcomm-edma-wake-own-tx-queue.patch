+/* Called under the netdev TX queue lock after descriptor exhaustion.
+ * Do not leave a queue stopped if hardware consumed descriptors between
+ * the failed reservation and publication of the stop bit.
+ */
+bool edma_tx_stop_if_full(struct netdev_queue *nq,
+			  struct edma_txdesc_ring *ring, struct sk_buff *skb)
+{
+	u32 needed = skb_is_nonlinear(skb) ? edma_tx_num_descs_for_sg(skb) : 1;
+
+	netif_tx_stop_queue(nq);
+	smp_mb__after_atomic();
+	ring->avail_desc = edma_tx_avail_desc(ring, ring->prod_idx);
+	if (ring->avail_desc < needed)
+		return true;
+
+	netif_tx_start_queue(nq);
+	return false;
 }
 
