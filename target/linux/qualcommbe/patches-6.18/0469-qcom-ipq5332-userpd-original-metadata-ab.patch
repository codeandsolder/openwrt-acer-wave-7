Subject: [PATCH] qcom: test original-offset PAS metadata for IPQ5332 UserPDs

The Acer 067 QSDK loader supplies all 4232 bytes of UserPD MDT
metadata, retaining the hash segment at ELF offset 0x1000.
Mainline instead compacts its 148-byte header and 136-byte hash
to 284 bytes. Isolate this secure-monitor ABI difference with an
explicit IPQ5332 UserPD opt-in, preserving other platforms.
The standard relocatable PAS and segment loading machinery is
shared; original-layout validation rejects split hash metadata.
This is an A/B hypothesis, not a confirmed Q6 U-bit fix.

---
diff --git a/drivers/soc/qcom/mdt_loader.c b/drivers/soc/qcom/mdt_loader.c
--- a/drivers/soc/qcom/mdt_loader.c
+++ b/drivers/soc/qcom/mdt_loader.c
@@ -278,9 +278,10 @@
  *
  * Returns 0 on success, negative errno otherwise.
  */
-int qcom_mdt_pas_init(struct device *dev, const struct firmware *fw,
-		      const char *fw_name, int pas_id, phys_addr_t mem_phys,
-		      struct qcom_scm_pas_metadata *ctx)
+static int qcom_mdt_pas_init_with_layout(struct device *dev,
+		      const struct firmware *fw, const char *fw_name,
+		      int pas_id, phys_addr_t mem_phys,
+		      struct qcom_scm_pas_metadata *ctx, bool original_layout)
 {
 	const struct elf32_phdr *phdrs;
 	const struct elf32_phdr *phdr;
@@ -315,11 +316,44 @@
 			max_addr = ALIGN(phdr->p_paddr + phdr->p_memsz, SZ_4K);
 	}
 
-	metadata = qcom_mdt_read_metadata(fw, &metadata_len, fw_name, dev);
-	if (IS_ERR(metadata)) {
-		ret = PTR_ERR(metadata);
-		dev_err(dev, "error %d reading firmware %s metadata\n", ret, fw_name);
-		goto out;
+	if (original_layout) {
+		/*
+		 * Some signed MDTs have an in-file hash segment at its original
+		 * ELF p_offset rather than directly following the ELF headers.
+		 * This layout must only be used for fully contained hash segments;
+		 * split hash images require the conventional compact metadata ABI.
+		 */
+		bool has_hash = false;
+
+		for (i = 1; i < ehdr->e_phnum; i++) {
+			phdr = &phdrs[i];
+			if ((phdr->p_flags & QCOM_MDT_TYPE_MASK) != QCOM_MDT_TYPE_HASH)
+				continue;
+			if (phdr->p_offset > fw->size ||
+			    phdr->p_filesz > fw->size - phdr->p_offset) {
+				ret = -EINVAL;
+				goto out;
+			}
+			has_hash = true;
+			break;
+		}
+		if (!has_hash) {
+			ret = -EINVAL;
+			goto out;
+		}
+		metadata = kmemdup(fw->data, fw->size, GFP_KERNEL);
+		metadata_len = fw->size;
+		if (!metadata) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	} else {
+		metadata = qcom_mdt_read_metadata(fw, &metadata_len, fw_name, dev);
+		if (IS_ERR(metadata)) {
+			ret = PTR_ERR(metadata);
+			dev_err(dev, "error %d reading firmware %s metadata\n", ret, fw_name);
+			goto out;
+		}
 	}
 
 	ret = qcom_scm_pas_init_image(pas_id, metadata, metadata_len, ctx);
@@ -341,6 +375,14 @@
 
 out:
 	return ret;
+}
+
+int qcom_mdt_pas_init(struct device *dev, const struct firmware *fw,
+		      const char *fw_name, int pas_id, phys_addr_t mem_phys,
+		      struct qcom_scm_pas_metadata *ctx)
+{
+	return qcom_mdt_pas_init_with_layout(dev, fw, fw_name, pas_id,
+					     mem_phys, ctx, false);
 }
 EXPORT_SYMBOL_GPL(qcom_mdt_pas_init);
 
@@ -505,6 +547,30 @@
 }
 EXPORT_SYMBOL_GPL(qcom_mdt_load);
 
+/*
+ * Preserve the original fully contained MDT hash-segment offset in the
+ * PAS metadata buffer. Callers choose this only when the platform's
+ * secure firmware expects the on-disk padded metadata representation.
+ * Firmware segments and PAS relocation are otherwise identical to
+ * qcom_mdt_load().
+ */
+int qcom_mdt_load_original_metadata(struct device *dev,
+			 const struct firmware *fw, const char *firmware,
+			 int pas_id, void *mem_region, phys_addr_t mem_phys,
+			 size_t mem_size, phys_addr_t *reloc_base)
+{
+	int ret;
+
+	ret = qcom_mdt_pas_init_with_layout(dev, fw, firmware, pas_id,
+					     mem_phys, NULL, true);
+	if (ret)
+		return ret;
+
+	return __qcom_mdt_load(dev, fw, firmware, mem_region, mem_phys,
+			       mem_size, reloc_base);
+}
+EXPORT_SYMBOL_GPL(qcom_mdt_load_original_metadata);
+
 /**
  * qcom_mdt_load_no_init() - load the firmware which header is loaded as fw
  * @dev:	device handle to associate resources with
diff --git a/include/linux/soc/qcom/mdt_loader.h b/include/linux/soc/qcom/mdt_loader.h
--- a/include/linux/soc/qcom/mdt_loader.h
+++ b/include/linux/soc/qcom/mdt_loader.h
@@ -24,6 +24,10 @@
 		  phys_addr_t mem_phys, size_t mem_size,
 		  phys_addr_t *reloc_base);
 
+int qcom_mdt_load_original_metadata(struct device *dev,
+			 const struct firmware *fw, const char *firmware,
+			 int pas_id, void *mem_region, phys_addr_t mem_phys,
+			 size_t mem_size, phys_addr_t *reloc_base);
 int qcom_mdt_load_no_init(struct device *dev, const struct firmware *fw,
 			  const char *fw_name, void *mem_region,
 			  phys_addr_t mem_phys, size_t mem_size,
@@ -58,6 +62,14 @@
 	return -ENODEV;
 }
 
+static inline int qcom_mdt_load_original_metadata(struct device *dev,
+			const struct firmware *fw, const char *fw_name, int pas_id,
+			void *mem_region, phys_addr_t mem_phys, size_t mem_size,
+			phys_addr_t *reloc_base)
+{
+	return -ENODEV;
+}
+
 static inline int qcom_mdt_load_no_init(struct device *dev,
 					const struct firmware *fw,
 					const char *fw_name, void *mem_region,
diff --git a/drivers/remoteproc/qcom_q6v5_mpd.c b/drivers/remoteproc/qcom_q6v5_mpd.c
--- a/drivers/remoteproc/qcom_q6v5_mpd.c
+++ b/drivers/remoteproc/qcom_q6v5_mpd.c
@@ -97,6 +97,7 @@
 struct wcss_data {
 	u32 pasid;
 	bool share_upd_info_to_q6;
+	bool userpd_original_pas_metadata;
 };
 
 /**
@@ -597,6 +598,11 @@
 	if (ret)
 		return ret;
 
+	if (wcss->desc->userpd_original_pas_metadata)
+		return qcom_mdt_load_original_metadata(upd->dev, fw, rproc->firmware,
+				pasid, wcss->mem_region, wcss->mem_phys,
+				wcss->mem_size, NULL);
+
 	return qcom_mdt_load(upd->dev, fw, rproc->firmware,
 			     pasid, wcss->mem_region,
 			     wcss->mem_phys, wcss->mem_size,
@@ -973,6 +979,7 @@
 static const struct wcss_data q6_ipq5332_res_init = {
 	.pasid = MPD_WCNSS_PAS_ID,
 	.share_upd_info_to_q6 = true,
+	.userpd_original_pas_metadata = true,
 };
 
 static const struct wcss_data q6_ipq9574_res_init = {
