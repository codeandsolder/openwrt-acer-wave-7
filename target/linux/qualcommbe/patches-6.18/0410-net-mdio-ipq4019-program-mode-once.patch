From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] net: mdio: ipq4019: program transaction mode in one write

IPQ5332 can complete MDIO commands while returning stale DATA_READ values
when the MDC divider and Clause selector are programmed in separate mode
register writes. The working Qualcomm downstream sequence programs the
complete target mode once before each transaction.

Fold divider selection and the Clause 22/45 selector into one mode-register
write for every transaction. Put reset/probe initialization explicitly in
Clause 22 mode as well. This keeps the configured MDC rate unchanged while
matching the downstream controller programming sequence more closely.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -77,7 +77,7 @@
 	[MDIO_CLK_UNIPHY1_SYS] = "gcc_uniphy1_sys_clk",
 };
 
-static int ipq4019_mdio_set_div(struct ipq4019_mdio_data *priv);
+static int ipq4019_mdio_set_mode(struct ipq4019_mdio_data *priv, bool c45);
 
 static int ipq4019_mdio_wait_busy(struct mii_bus *bus)
 {
@@ -103,19 +103,12 @@
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
-	/* Qualcomm downstream restores the configured MDC divider before
-	 * every transaction. Keep that behavior so mode changes cannot leave
-	 * the controller running with a stale divider.
+	/* Qualcomm downstream programs the complete target mode once before
+	 * each transaction. Keep divider and Clause selection in that write.
 	 */
-	if (ipq4019_mdio_set_div(priv))
+	if (ipq4019_mdio_set_mode(priv, true))
 		return -EINVAL;
 
-	data = readl(priv->membase + MDIO_MODE_REG);
-
-	data |= MDIO_MODE_C45;
-
-	writel(data, priv->membase + MDIO_MODE_REG);
-
 	/* issue the phy address and mmd */
 	writel((mii_id << 8) | mmd, priv->membase + MDIO_ADDR_REG);
 
@@ -163,25 +156,15 @@
 static int ipq4019_mdio_read_c22(struct mii_bus *bus, int mii_id, int regnum)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
-	unsigned int data;
 	unsigned int cmd;
 
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
-	/* Qualcomm downstream restores the configured MDC divider before
-	 * every transaction. Keep that behavior so mode changes cannot leave
-	 * the controller running with a stale divider.
-	 */
-	if (ipq4019_mdio_set_div(priv))
+	/* Program divider and Clause 22 selection in one mode write. */
+	if (ipq4019_mdio_set_mode(priv, false))
 		return -EINVAL;
 
-	data = readl(priv->membase + MDIO_MODE_REG);
-
-	data &= ~MDIO_MODE_C45;
-
-	writel(data, priv->membase + MDIO_MODE_REG);
-
 	/* issue the phy address and reg */
 	writel((mii_id << 8) | regnum, priv->membase + MDIO_ADDR_REG);
 
@@ -202,25 +185,15 @@
 				  int reg, u16 value)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
-	unsigned int data;
 	unsigned int cmd;
 
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
-	/* Qualcomm downstream restores the configured MDC divider before
-	 * every transaction. Keep that behavior so mode changes cannot leave
-	 * the controller running with a stale divider.
-	 */
-	if (ipq4019_mdio_set_div(priv))
+	/* Program divider and Clause 45 selection in one mode write. */
+	if (ipq4019_mdio_set_mode(priv, true))
 		return -EINVAL;
 
-	data = readl(priv->membase + MDIO_MODE_REG);
-
-	data |= MDIO_MODE_C45;
-
-	writel(data, priv->membase + MDIO_MODE_REG);
-
 	/* issue the phy address and mmd */
 	writel((mii_id << 8) | mmd, priv->membase + MDIO_ADDR_REG);
 
@@ -251,26 +224,15 @@
 				  u16 value)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
-	unsigned int data;
 	unsigned int cmd;
 
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
 
-	/* Qualcomm downstream restores the configured MDC divider before
-	 * every transaction. Keep that behavior so mode changes cannot leave
-	 * the controller running with a stale divider.
-	 */
-	if (ipq4019_mdio_set_div(priv))
+	/* Program divider and Clause 22 selection in one mode write. */
+	if (ipq4019_mdio_set_mode(priv, false))
 		return -EINVAL;
 
-	/* Enter Clause 22 mode */
-	data = readl(priv->membase + MDIO_MODE_REG);
-
-	data &= ~MDIO_MODE_C45;
-
-	writel(data, priv->membase + MDIO_MODE_REG);
-
 	/* issue the phy address and reg */
 	writel((mii_id << 8) | regnum, priv->membase + MDIO_ADDR_REG);
 
@@ -289,7 +251,7 @@
 	return 0;
 }
 
-static int ipq4019_mdio_set_div(struct ipq4019_mdio_data *priv)
+static int ipq4019_mdio_set_mode(struct ipq4019_mdio_data *priv, bool c45)
 {
 	unsigned long ahb_rate;
 	int div;
@@ -309,8 +271,10 @@
 		/* The requested rate is supported by the div */
 		if (priv->mdc_rate == DIV_ROUND_UP(ahb_rate, div)) {
 			val = readl(priv->membase + MDIO_MODE_REG);
-			val &= ~MDIO_MODE_DIV_MASK;
+			val &= ~(MDIO_MODE_DIV_MASK | MDIO_MODE_C45);
 			val |= MDIO_MODE_DIV(div);
+			if (c45)
+				val |= MDIO_MODE_C45;
 			writel(val, priv->membase + MDIO_MODE_REG);
 
 			return 0;
@@ -405,7 +369,7 @@
 	mdelay(10);
 
 	/* Restore MDC rate */
-	ret = ipq4019_mdio_set_div(priv);
+	ret = ipq4019_mdio_set_mode(priv, false);
 	if (!ret)
 		dev_info(bus->parent, "MDC rate %u Hz, mode register %#x\n",
 			 priv->mdc_rate, readl(priv->membase + MDIO_MODE_REG));
@@ -495,7 +459,7 @@
 	}
 
 	ipq4019_mdio_select_mdc_rate(pdev, priv);
-	ret = ipq4019_mdio_set_div(priv);
+	ret = ipq4019_mdio_set_mode(priv, false);
 	if (ret)
 		return ret;
 
