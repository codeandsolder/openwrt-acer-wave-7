From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] net: qualcomm: instrument Wave 7 SGMII receive path

The Wave 7 QCA8081 reports copper link while the MPPE PCS never receives a
valid SGMII link indication. The shipping Acer qca-ssdk.ko leaves its
qca808x link-change callback empty, while mainline toggles the QCA8081
SerDes FIFO through the pseudo-PHY at addr + 1 and discards all errors.

Add bounded bring-up diagnostics around that FIFO transaction and include
the adjacent 0x484 PCS register in the existing post-MAC snapshot. This is
observability only; the link-change write and PCS sequencing are unchanged.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/phy/qcom/qca808x.c
+++ b/drivers/net/phy/qcom/qca808x.c
@@ -681,13 +681,26 @@
 
 static void qca808x_link_change_notify(struct phy_device *phydev)
 {
+	int before, after, ret;
+	int serdes_addr = phydev->mdio.addr + 1;
+
 	/* Assert interface sgmii fifo on link down, deassert it on link up,
 	 * the interface device address is always phy address added by 1.
 	 */
-	mdiobus_c45_modify_changed(phydev->mdio.bus, phydev->mdio.addr + 1,
-				   MDIO_MMD_PMAPMD, QCA8081_PHY_SERDES_MMD1_FIFO_CTRL,
-				   QCA8081_PHY_FIFO_RSTN,
-				   phydev->link ? QCA8081_PHY_FIFO_RSTN : 0);
+	before = mdiobus_c45_read(phydev->mdio.bus, serdes_addr,
+				  MDIO_MMD_PMAPMD,
+				  QCA8081_PHY_SERDES_MMD1_FIFO_CTRL);
+	ret = mdiobus_c45_modify_changed(phydev->mdio.bus, serdes_addr,
+					 MDIO_MMD_PMAPMD,
+				  QCA8081_PHY_SERDES_MMD1_FIFO_CTRL,
+				  QCA8081_PHY_FIFO_RSTN,
+				  phydev->link ? QCA8081_PHY_FIFO_RSTN : 0);
+	after = mdiobus_c45_read(phydev->mdio.bus, serdes_addr,
+				 MDIO_MMD_PMAPMD,
+				 QCA8081_PHY_SERDES_MMD1_FIFO_CTRL);
+	phydev_info(phydev,
+		    "SGMII FIFO notify: link=%u serdes=%#x before=%#x modify=%d after=%#x\n",
+		    phydev->link, serdes_addr, before, ret, after);
 }
 
 static int qca808x_led_parse_netdev(struct phy_device *phydev, unsigned long rules,
--- a/drivers/net/pcs/pcs-qcom-ipq9574.c
+++ b/drivers/net/pcs/pcs-qcom-ipq9574.c
@@ -773,7 +773,7 @@
 {
 	struct ipq_pcs_mii *qpcs_mii = phylink_pcs_to_qpcs_mii(pcs);
 	struct ipq_pcs *qpcs = qpcs_mii->qpcs;
-	unsigned int ctrl, sts;
+	unsigned int ctrl, aux, sts;
 	int ret;
 
 	if (!qpcs->mppe || qpcs->interface != PHY_INTERFACE_MODE_SGMII)
@@ -796,10 +796,11 @@
 
 	fsleep(10000);
 	if (!regmap_read(qpcs->regmap, PCS_MII_CTRL(qpcs_mii->index), &ctrl) &&
+	    !regmap_read(qpcs->regmap, PCS_MII_CTRL(qpcs_mii->index) + 4, &aux) &&
 	    !regmap_read(qpcs->regmap, PCS_MII_STS(qpcs_mii->index), &sts))
 		dev_info(qpcs->dev,
-			 "MPPE SGMII post-MAC reset: ctrl=%#x sts=%#x\n",
-			 ctrl, sts);
+			 "MPPE SGMII post-MAC reset: ctrl=%#x aux=%#x sts=%#x\n",
+			 ctrl, aux, sts);
 
 	return 0;
 }
