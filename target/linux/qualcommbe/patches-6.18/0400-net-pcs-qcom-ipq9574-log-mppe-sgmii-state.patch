From: Jan Równicki <jan@example.invalid>
Subject: [PATCH] net: pcs: qcom-ipq9574: log MPPE SGMII state window

Wave 7 still receives 1G/full speed information while the MPPE SGMII PCS
link bit remains clear. Extend the existing bring-up diagnostic to snapshot
the neighboring calibration, mode-adjacent and PLL registers so the failed
OpenWrt state can be compared directly with the working vendor image.

This is diagnostic-only and does not change PCS programming.

Signed-off-by: Jan Równicki <jan@example.invalid>
---
--- a/drivers/net/pcs/pcs-qcom-ipq9574.c
+++ b/drivers/net/pcs/pcs-qcom-ipq9574.c
@@ -773,7 +773,7 @@
 {
 	struct ipq_pcs_mii *qpcs_mii = phylink_pcs_to_qpcs_mii(pcs);
 	struct ipq_pcs *qpcs = qpcs_mii->qpcs;
-	unsigned int ctrl, aux, sts;
+	unsigned int calib, r470, r474, r478, pll, ctrl, aux, sts;
 	int ret;
 
 	if (!qpcs->mppe || qpcs->interface != PHY_INTERFACE_MODE_SGMII)
@@ -795,12 +795,17 @@
 		return ret;
 
 	fsleep(10000);
-	if (!regmap_read(qpcs->regmap, PCS_MII_CTRL(qpcs_mii->index), &ctrl) &&
+	if (!regmap_read(qpcs->regmap, PCS_CALIBRATION, &calib) &&
+	    !regmap_read(qpcs->regmap, 0x470, &r470) &&
+	    !regmap_read(qpcs->regmap, 0x474, &r474) &&
+	    !regmap_read(qpcs->regmap, 0x478, &r478) &&
+	    !regmap_read(qpcs->regmap, PCS_PLL_RESET, &pll) &&
+	    !regmap_read(qpcs->regmap, PCS_MII_CTRL(qpcs_mii->index), &ctrl) &&
 	    !regmap_read(qpcs->regmap, PCS_MII_CTRL(qpcs_mii->index) + 4, &aux) &&
 	    !regmap_read(qpcs->regmap, PCS_MII_STS(qpcs_mii->index), &sts))
 		dev_info(qpcs->dev,
-			 "MPPE SGMII post-MAC reset: ctrl=%#x aux=%#x sts=%#x\n",
-			 ctrl, aux, sts);
+			 "MPPE SGMII post-MAC reset: cal=%#x r470=%#x r474=%#x r478=%#x pll=%#x ctrl=%#x aux=%#x sts=%#x\n",
+			 calib, r470, r474, r478, pll, ctrl, aux, sts);
 
 	return 0;
 }
