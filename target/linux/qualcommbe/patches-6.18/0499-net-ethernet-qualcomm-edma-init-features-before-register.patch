From: codeandsolder <codeandsolder@users.noreply.github.com>
Subject: [PATCH] net: ethernet: qualcomm: qualify parser offloads at EDMA conduit

Advertise capabilities before register_netdev, not on every open.
The descriptor driver provides no explicit L3/L4 offsets for DSA
tags. Preserve ordinary VLAN inheritance, but request software TX
checksum and GSO for DSA conduits at the final feature-check boundary.
Keep scatter-gather and RX capabilities. Apply the standard VLAN
feature check as well.

This lab experiment requires payload qualification of post-tag
software segmentation before it is considered production-ready.

Signed-off-by: codeandsolder <codeandsolder@users.noreply.github.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.c
@@ -5,11 +5,13 @@
 /* EDMA port initialization, configuration and netdevice ops handling */
 
 #include <linux/etherdevice.h>
+#include <linux/if_vlan.h>
 #include <linux/net.h>
 #include <linux/netdevice.h>
 #include <linux/of_net.h>
 #include <linux/phylink.h>
 #include <linux/printk.h>
+#include <net/dsa.h>
 
 #include "edma.h"
 #include "edma_cfg_rx.h"
@@ -100,15 +102,6 @@
 	if (!port_priv)
 		return -EINVAL;
 
-	/* Inform the Linux Networking stack about the hardware capability of
-	 * checksum offloading and other features. Each port is
-	 * responsible to maintain the feature set it supports.
-	 */
-	netdev->features |= EDMA_NETDEV_FEATURES;
-	netdev->hw_features |= EDMA_NETDEV_FEATURES;
-	netdev->vlan_features |= EDMA_NETDEV_FEATURES;
-	netdev->wanted_features |= EDMA_NETDEV_FEATURES;
-
 	ppe_port  = port_priv->ppe_port;
 	port_id = ppe_port->port_id;
 
@@ -177,11 +170,19 @@
 	return ppe_port_set_maxframe(port_priv->ppe_port, mtu);
 }
 
-static netdev_features_t edma_port_feature_check(__maybe_unused struct sk_buff *skb,
-						 __maybe_unused struct net_device *netdev,
-						 netdev_features_t features)
-{
-	return features;
+static netdev_features_t edma_port_feature_check(struct sk_buff *skb,
+						 struct net_device *netdev,
+						 netdev_features_t features)
+{
+	/* The EDMA checksum and segmentation engines parse the wire
+	 * headers. No DSA tag format is qualified for those engines yet.
+	 * Complete such offloads in software before descriptor submission.
+	 * Scatter-gather does not depend on the packet parser.
+	 */
+	if (netdev_uses_dsa(netdev))
+		features &= ~(NETIF_F_CSUM_MASK | NETIF_F_GSO_MASK);
+
+	return vlan_features_check(skb, features);
 }
 
 static netdev_tx_t edma_port_xmit(struct sk_buff *skb,
@@ -398,6 +399,14 @@
 	netdev->watchdog_timeo = 5 * HZ;
 	netdev->priv_flags |= IFF_LIVE_ADDR_CHANGE;
 	netdev->netdev_ops = &edma_port_netdev_ops;
+
+	/* Publish capabilities before registration. Reopening the port
+	 * must not reset the administrator's selected feature mask.
+	 */
+	netdev->features |= EDMA_NETDEV_FEATURES;
+	netdev->hw_features |= EDMA_NETDEV_FEATURES;
+
+	netdev->vlan_features |= EDMA_NETDEV_FEATURES;
 	netdev->gso_max_segs = GSO_MAX_SEGS;
 	edma_set_ethtool_ops(netdev);
 
