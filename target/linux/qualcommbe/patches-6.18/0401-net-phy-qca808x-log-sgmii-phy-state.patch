From: Jan Równicki <jan@example.invalid>
Subject: [PATCH] net: phy: qca808x: log SGMII PHY state on link change

Wave 7 reaches copper link-up while the SoC SGMII PCS never asserts its
link-status bit. Snapshot the QCA8081 PMA/AN state and the hidden SerDes
endpoint when link changes so the failed Linux state can be compared with
the working vendor firmware.

This is diagnostic-only.

Signed-off-by: Jan Równicki <jan@example.invalid>
---
--- a/drivers/net/phy/qcom/qca808x.c
+++ b/drivers/net/phy/qcom/qca808x.c
@@ -697,6 +697,8 @@
 
 static void qca808x_link_change_notify(struct phy_device *phydev)
 {
+	int pma4, pma8, pma11, pma21, pma93, an20, spec;
+	int serdes4, serdes8, serdes11, serdes21;
 	int before, after, ret;
 	int serdes_addr = phydev->mdio.addr + 1;
 
@@ -714,6 +716,29 @@
 	after = mdiobus_c45_read(phydev->mdio.bus, serdes_addr,
 				 MDIO_MMD_PMAPMD,
 				 QCA8081_PHY_SERDES_MMD1_FIFO_CTRL);
+
+	pma4 = phy_read_mmd(phydev, MDIO_MMD_PMAPMD, 4);
+	pma8 = phy_read_mmd(phydev, MDIO_MMD_PMAPMD, 8);
+	pma11 = phy_read_mmd(phydev, MDIO_MMD_PMAPMD, 11);
+	pma21 = phy_read_mmd(phydev, MDIO_MMD_PMAPMD, 21);
+	pma93 = phy_read_mmd(phydev, MDIO_MMD_PMAPMD, 0x93);
+	an20 = phy_read_mmd(phydev, MDIO_MMD_AN, 0x20);
+	spec = phy_read(phydev, 0x11);
+	serdes4 = mdiobus_c45_read(phydev->mdio.bus, serdes_addr,
+				   MDIO_MMD_PMAPMD, 4);
+	serdes8 = mdiobus_c45_read(phydev->mdio.bus, serdes_addr,
+				   MDIO_MMD_PMAPMD, 8);
+	serdes11 = mdiobus_c45_read(phydev->mdio.bus, serdes_addr,
+				    MDIO_MMD_PMAPMD, 11);
+	serdes21 = mdiobus_c45_read(phydev->mdio.bus, serdes_addr,
+				    MDIO_MMD_PMAPMD, 21);
+
+	phydev_info(phydev,
+		    "SGMII PHY state: spec=%#x pma4=%#x pma8=%#x pma11=%#x pma21=%#x pma93=%#x an20=%#x\n",
+		    spec, pma4, pma8, pma11, pma21, pma93, an20);
+	phydev_info(phydev,
+		    "SGMII SerDes state: phy=%#x pma4=%#x pma8=%#x pma11=%#x pma21=%#x fifo=%#x\n",
+		    serdes_addr, serdes4, serdes8, serdes11, serdes21, after);
 	phydev_info(phydev,
 		    "SGMII FIFO notify: link=%u serdes=%#x before=%#x modify=%d after=%#x\n",
 		    phydev->link, serdes_addr, before, ret, after);
