From: Code and Solder <codeandsolder@gmail.com>
Subject: [PATCH] net: pcs: qcom-ipq9574: expose read-only PCS status in debugfs

An IPQ5332 SGMII link can report copper carrier while its receive
datapath stops without incrementing either MAC or PPE counters.
Expose the configured mode, calibration and per-channel link status
registers via an on-demand debugfs file so a boot watchdog can preserve
the PCS state before a deliberate failsafe reboot.

The snapshot reads only selected known registers and changes no reset,
clock, link or datapath configuration.

Signed-off-by: Code and Solder <codeandsolder@gmail.com>
---
--- a/drivers/net/pcs/pcs-qcom-ipq9574.c
+++ b/drivers/net/pcs/pcs-qcom-ipq9574.c
@@ -4,18 +4,20 @@
  */
 
 #include <linux/clk.h>
 #include <linux/clk-provider.h>
 #include <linux/device.h>
+#include <linux/debugfs.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
 #include <linux/pcs/pcs-qcom-ipq9574.h>
 #include <linux/phy.h>
 #include <linux/phylink.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
+#include <linux/seq_file.h>
 
 #include <dt-bindings/net/qcom,ipq9574-pcs.h>
 
 /* Maximum number of MIIs per PCS instance. There are 5 MIIs for PSGMII. */
 #define PCS_MAX_MII_NRS			5
@@ -1227,10 +1229,81 @@
 	.reg_read = ipq_pcs_regmap_read,
 	.reg_write = ipq_pcs_regmap_write,
 	.fast_io = true,
 };
 
+#ifdef CONFIG_DEBUG_FS
+/* Read-only, bounded register snapshot for diagnosing PHY/PCS RX failures. */
+static int ipq_pcs_snapshot_show(struct seq_file *s, void *unused)
+{
+	static const struct {
+		const char *name;
+		unsigned int reg;
+	} regs[] = {
+		{ "calibration", PCS_CALIBRATION },
+		{ "mode_ctrl", PCS_MODE_CTRL },
+		{ "misc2", PCS_MISC2 },
+		{ "vco_cal_ctrl", PCS_VCO_CAL_CTRL },
+	};
+	struct ipq_pcs *qpcs = s->private;
+	unsigned int val;
+	int ret, i;
+
+	seq_printf(s, "interface=%s mppe=%u\\n",
+		   phy_modes(qpcs->interface), qpcs->mppe);
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = regmap_read(qpcs->regmap, regs[i].reg, &val);
+		if (ret)
+			seq_printf(s, "%s error=%d\\n", regs[i].name, ret);
+		else
+			seq_printf(s, "%s=0x%08x\\n", regs[i].name, val);
+	}
+	for (i = 0; i < PCS_MAX_MII_NRS; i++) {
+		if (!qpcs->qpcs_mii[i])
+			continue;
+		ret = regmap_read(qpcs->regmap, PCS_MII_STS(i), &val);
+		if (ret)
+			seq_printf(s, "mii%d_status error=%d\\n", i, ret);
+		else
+			seq_printf(s, "mii%d_status=0x%08x link=%u\\n",
+				   i, val, !!(val & PCS_MII_LINK_STS));
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ipq_pcs_snapshot);
+
+static void ipq_pcs_debugfs_remove(void *data)
+{
+	debugfs_remove_recursive(data);
+}
+
+static void ipq_pcs_debugfs_register(struct device *dev, struct ipq_pcs *qpcs)
+{
+	struct dentry *dir, *file;
+	char *dirname;
+
+	dirname = devm_kasprintf(dev, GFP_KERNEL, "ipq-pcs-%s", dev_name(dev));
+	if (!dirname)
+		return;
+
+	dir = debugfs_create_dir(dirname, NULL);
+	if (IS_ERR_OR_NULL(dir))
+		return;
+	file = debugfs_create_file("link_state", 0400, dir, qpcs,
+				   &ipq_pcs_snapshot_fops);
+	if (IS_ERR_OR_NULL(file)) {
+		debugfs_remove_recursive(dir);
+		return;
+	}
+	devm_add_action_or_reset(dev, ipq_pcs_debugfs_remove, dir);
+}
+#else
+static void ipq_pcs_debugfs_register(struct device *dev, struct ipq_pcs *qpcs)
+{
+}
+#endif
+
 static int ipq9574_pcs_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct ipq_pcs *qpcs;
 	struct clk *clk;
@@ -1285,10 +1358,11 @@
 	ret = ipq_pcs_create_miis(qpcs);
 	if (ret)
 		return ret;
 
 	platform_set_drvdata(pdev, qpcs);
+	ipq_pcs_debugfs_register(dev, qpcs);
 
 	return 0;
 }
 
 static const struct of_device_id ipq9574_pcs_of_mtable[] = {
