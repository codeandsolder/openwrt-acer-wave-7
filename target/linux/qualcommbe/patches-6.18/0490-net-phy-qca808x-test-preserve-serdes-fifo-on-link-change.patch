From: Code and Solder <codeandsolder@gmail.com>
Subject: [PATCH] net: phy: qca808x: test preserving SGMII FIFO on carrier changes

The original Acer Wave 7 firmware qca-ssdk.ko's
qca808x_link_change_notify() is a literal no-op (bx lr). In upstream
Linux 6.18, this callback holds and releases the QCA8081 adjacent
SerDes FIFO each time the copper PHY link changes. On IPQ5332 MPPE,
postboot copper-down/up repeatedly produces a carrier-up frame
blackhole despite fresh host PCS calibration, active host clocks,
and subsequent forced PHY FIFO re-release and copper PHY reset.

Perform an isolated no-FIFO-notify A/B test before adopting further
register resets. Keep the original bounded PHY/PCS/counter telemetry
and explicitly mark each edge as FIFO-preserved. This is an
experimental behavior change, not a general upstream fix until it
passes a matched carrier-flap test.

Signed-off-by: Code and Solder <codeandsolder@gmail.com>
---
--- a/drivers/net/phy/qcom/qca808x.c
+++ b/drivers/net/phy/qcom/qca808x.c
@@ -773,48 +773,45 @@
 
 	return __genphy_config_aneg(phydev, ret);
 }
 
 static void qca808x_link_change_notify(struct phy_device *phydev)
 {
 	struct qca808x_priv *priv = phydev->priv;
-	int ret;
-
-	/* Assert interface sgmii fifo on link down, deassert it on link up,
-	 * the interface device address is always phy address added by 1.
-	 */
-	ret = mdiobus_c45_modify_changed(phydev->mdio.bus, phydev->mdio.addr + 1,
-					 MDIO_MMD_PMAPMD,
-					 QCA8081_PHY_SERDES_MMD1_FIFO_CTRL,
-					 QCA8081_PHY_FIFO_RSTN,
-					 phydev->link ? QCA8081_PHY_FIFO_RSTN : 0);
+
+	/* Experiment: leave the QCA8081 PHY+1 SGMII FIFO unchanged across
+	 * copper carrier transitions. Acer stock qca-ssdk's QCA8081 notify
+	 * callback is a no-op, whereas upstream Linux toggles FIFO_RSTN.
+	 * Keep the same diagnostics to distinguish a new state-machine
+	 * outcome from the already disproven additional FIFO resets.
+	 */
 	if (phydev_id_compare(phydev, QCA8081_PHY_ID)) {
 		priv->diag_phy_path_edges++;
 		priv->diag_phy_path_window = 60;
 		priv->diag_phy_path_sample = 0;
 		priv->diag_phy_path_prev_rx = priv->hw_stats.rx_pkts;
 		priv->diag_phy_path_prev_tx = priv->hw_stats.tx_pkts;
 		phydev_info(phydev,
-			    "wave7-diag: phy-path edge=%u link=%u fifo_ret=%d rx=%llu tx=%llu rx_err=%llu tx_err=%llu\n",
-			    priv->diag_phy_path_edges, phydev->link, ret,
+			    "wave7-diag: phy-path edge=%u link=%u fifo_action=preserved rx=%llu tx=%llu rx_err=%llu tx_err=%llu\n",
+			    priv->diag_phy_path_edges, phydev->link,
 			    (unsigned long long)priv->hw_stats.rx_pkts,
 			    (unsigned long long)priv->hw_stats.tx_pkts,
 			    (unsigned long long)priv->hw_stats.rx_err_pkts,
 			    (unsigned long long)priv->hw_stats.tx_err_pkts);
 	}
 
 	if (phydev_id_compare(phydev, QCA8081_PHY_ID) &&
 	    priv->initial_link_events < 3) {
 		priv->initial_link_events++;
 		phydev_info(phydev,
-			    "wave7-diag: fifo[%u] state=%d link=%u mdio_result=%d\n",
+			    "wave7-diag: fifo[%u] state=%d link=%u fifo_action=preserved\n",
 			    priv->initial_link_events, phydev->state,
-			    phydev->link, ret);
-
-		/* Defer the MDIO reads; the notify path itself remains unchanged. */
+			    phydev->link);
+
+		/* Keep the original delayed SerDes/PCS diagnostic sample. */
 		WRITE_ONCE(priv->diag_serdes_events, priv->initial_link_events);
 		WRITE_ONCE(priv->diag_serdes_link, phydev->link);
 		WRITE_ONCE(priv->diag_serdes_sample, 0);
 		mod_delayed_work(system_unbound_wq, &priv->diag_serdes_work,
 				 msecs_to_jiffies(20));
 	}
 }
