#!/bin/sh /etc/rc.common
START=99
STOP=1

. /lib/functions/system.sh

wave7_firstboot_link_ready() {
	[ "$(cat /sys/class/net/lan/carrier 2>/dev/null)" = 1 ] || return 1
	ip -4 -o addr show dev br-lan 2>/dev/null | grep -Fq '192.168.76.1/24'
}

start() {
	[ "$(board_name)" = "acer,wave7" ] || return 0
	[ -s /tmp/wave7-firstboot-hard-panic.pid ] && \
		kill -0 "$(cat /tmp/wave7-firstboot-hard-panic.pid)" 2>/dev/null && return 0
	(
		sleep 120
		[ -e /tmp/wave7-keep-boot ] && exit 0
		if wave7_firstboot_link_ready; then
			touch /tmp/wave7-keep-boot
			exit 0
		fi
		echo 1 > /proc/sys/kernel/sysrq 2>/dev/null || true
		echo c > /proc/sysrq-trigger
	) &
	echo $! > /tmp/wave7-firstboot-hard-panic.pid
}

stop() {
	for pidfile in /tmp/wave7-firstboot-hard-panic.pid /tmp/wave7-firstboot-diagnostics.pid; do
		[ -s "$pidfile" ] || continue
		kill "$(cat "$pidfile")" 2>/dev/null || true
		rm -f "$pidfile"
	done
}
