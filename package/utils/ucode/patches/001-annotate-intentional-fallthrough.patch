From: CodeAndSolder <codeandsolder@users.noreply.github.com>
Subject: [PATCH] ucode: annotate intentional switch fallthroughs

The VM, compiler, parser and optional module implementations intentionally
fall through between switch cases, with comments that GCC does not
recognize under strict -Wimplicit-fallthrough. Replace those comments
with explicit GNU-compatible fallthrough statements. This preserves
execution behavior rather than suppressing diagnostics.

---
--- a/vm.c
+++ b/vm.c
@@ -1102,7 +1102,7 @@
 	case I_ULOC:
 	case I_UUPV:
 		cnst = uc_chunk_debug_get_variable(chunk, pos - chunk->entries, vm->arg.u32 & 0x00ffffff, (insn == I_UUPV));
-		/* fall through */
+		__attribute__((__fallthrough__));
 
 	case I_UVAR:
 		if (!cnst)
--- a/lib/uci.c
+++ b/lib/uci.c
@@ -945,7 +945,7 @@
 	case UC_INTEGER:
 	case UC_STRING:
 		*p = ucv_to_string(vm, val);
-		/* fall through */
+		__attribute__((__fallthrough__));
 
 	case UC_NULL:
 		return true;
--- a/lib/struct.c
+++ b/lib/struct.c
@@ -2242,7 +2242,7 @@
 
 	default:
 		--*pfmt; /* Back out of pointer increment */
-		/* Fall through */
+		__attribute__((__fallthrough__));
 
 	case '@':
 		return native_endian_table;
@@ -2411,7 +2411,7 @@
 			return NULL;
 
 		switch (c) {
-		case '*': /* fall through */
+		case '*': __attribute__((__fallthrough__));
 		case 's':
 		case 'p':
 		case 'X':
@@ -2735,7 +2735,7 @@
 			src_off++; /* Skip the = */
 
 			/* Fall through to "single trailing =" case. */
-			/* FALLTHROUGH */
+			__attribute__((__fallthrough__));
 
 		case BYTE4:		/* Valid, means two bytes of info */
 			/*
