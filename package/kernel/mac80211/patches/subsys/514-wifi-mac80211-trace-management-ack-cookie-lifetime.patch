+TRACE_EVENT(ack_status_lifetime,
+	TP_PROTO(struct ieee80211_local *local, u16 id, u64 cookie,
+		 bool attach, bool acked, bool dropped),
+	TP_ARGS(local, id, cookie, attach, acked, dropped),
+	TP_STRUCT__entry(
+		LOCAL_ENTRY
+		__field(u16, id)
+		__field(u64, cookie)
+		__field(bool, attach)
+		__field(bool, acked)
+		__field(bool, dropped)
+	),
+	TP_fast_assign(
+		LOCAL_ASSIGN;
+		__entry->id = id;
+		__entry->cookie = cookie;
+		__entry->attach = attach;
+		__entry->acked = acked;
+		__entry->dropped = dropped;
+	),
+	TP_printk(LOCAL_PR_FMT " id=%u cookie=%llu attach=%u acked=%u dropped=%u",
+		  LOCAL_PR_ARG, __entry->id, __entry->cookie, __entry->attach,
+		  __entry->acked, __entry->dropped)
+);
+
 #endif /* !__MAC80211_DRIVER_TRACE || TRACE_HEADER_MULTI_READ */
 
