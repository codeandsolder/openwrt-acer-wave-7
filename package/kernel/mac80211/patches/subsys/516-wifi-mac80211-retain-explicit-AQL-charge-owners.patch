 /**
+ * ieee80211_tx_aql_get - retain the station owning a dequeued frame's AQL charge
+ * @pubsta: original TX queue station, valid under RCU
+ * @skb: dequeued frame
+ *
+ * Returns an opaque reference independent of station lifetime, or NULL for
+ * uncharged/broadcast frames. Drivers must complete every charge explicitly
+ * before handing the skb back to mac80211, including failed submissions.
+ */
+struct ieee80211_aql_owner *
+ieee80211_tx_aql_get(struct ieee80211_sta *pubsta, struct sk_buff *skb);
+
+/**
+ * ieee80211_tx_aql_clone - charge a further copy of a dequeued frame
+ * @hw: hardware
+ * @owner: original charge owner (may be NULL)
+ * @skb: copied skb, preserving the original airtime estimate
+ *
+ * The copy obtains its own charge and owner reference.
+ */
+void ieee80211_tx_aql_clone(struct ieee80211_hw *hw,
+			    struct ieee80211_aql_owner *owner,
+			    struct sk_buff *skb);
+
+/**
+ * ieee80211_tx_aql_complete - retire an explicitly owned TX charge
+ * @hw: hardware
+ * @owner: retained charge owner, or NULL for broadcast
+ * @skb: completed frame, before TX status processing
+ * @wake: resume generic TX queue scheduling (false during teardown)
+ *
+ * Consumes the owner reference and clears the skb estimate so subsequent
+ * status processing cannot retire the same charge again.
+ */
+void ieee80211_tx_aql_complete(struct ieee80211_hw *hw,
+			       struct ieee80211_aql_owner *owner,
+			       struct sk_buff *skb, bool wake);
+
+/**
+ * ieee80211_tx_aql_put - release a charge owner reference
+ * @owner: retained owner, or NULL
+ *
+ * Use without completion only after hardware accounting has been destroyed.
+ */
+void ieee80211_tx_aql_put(struct ieee80211_aql_owner *owner);
+
