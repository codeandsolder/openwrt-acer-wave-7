-	struct ieee80211_txq *queue;
-
-	spin_lock(&local->handle_wake_tx_queue_lock);
-
-	/* Use ieee80211_next_txq() for airtime fairness accounting */
-	ieee80211_txq_schedule_start(hw, txq->ac);
-	while ((queue = ieee80211_next_txq(hw, txq->ac))) {
-		wake_tx_push_queue(local, sdata, queue);
-		ieee80211_return_txq(hw, queue, false);
-	}
-	ieee80211_txq_schedule_end(hw, txq->ac);
-	spin_unlock(&local->handle_wake_tx_queue_lock);
+	ieee80211_handle_wake_tx_queue_ac(hw_to_local(hw), txq->ac, false);
 }
 EXPORT_SYMBOL(ieee80211_handle_wake_tx_queue);
+
+void ieee80211_aql_wake_txqs(struct tasklet_struct *t)
+{
+	struct ieee80211_local *local = from_tasklet(local, t, aql_txq_tasklet);
+	u8 ac;
+
+	if (READ_ONCE(local->aql_wake_disabled))
+		return;
+
+	/* A release can make another AC eligible through the global limit. */
+	rcu_read_lock();
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+		ieee80211_handle_wake_tx_queue_ac(local, ac, true);
+	rcu_read_unlock();
+}
 
