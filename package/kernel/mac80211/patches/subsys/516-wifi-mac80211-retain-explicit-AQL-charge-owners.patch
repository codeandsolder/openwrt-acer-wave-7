+
+void ieee80211_sta_update_pending_airtime(struct ieee80211_local *local,
+					  struct sta_info *sta, u8 ac,
+					  u16 tx_airtime, bool tx_completed,
+					  bool mcast)
+{
+	ieee80211_aql_update_pending_airtime(local, sta ? sta->aql : NULL,
+					     ac, tx_airtime, tx_completed, mcast);
+}
+
+struct ieee80211_aql_owner *
+ieee80211_tx_aql_get(struct ieee80211_sta *pubsta, struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct sta_info *sta;
+
+	if (!pubsta || info->tx_time_mc || !ieee80211_info_get_tx_time_est(info))
+		return NULL;
+
+	sta = container_of(pubsta, struct sta_info, sta);
+	refcount_inc(&sta->aql->refs);
+	return sta->aql;
+}
+EXPORT_SYMBOL(ieee80211_tx_aql_get);
+
+void ieee80211_tx_aql_put(struct ieee80211_aql_owner *owner)
+{
+	if (owner && refcount_dec_and_test(&owner->refs))
+		kfree(owner);
+}
+EXPORT_SYMBOL(ieee80211_tx_aql_put);
+
+void ieee80211_tx_aql_clone(struct ieee80211_hw *hw,
+			    struct ieee80211_aql_owner *owner,
+			    struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	u16 airtime = ieee80211_info_get_tx_time_est(info);
+
+	if (!airtime)
+		return;
+
+	if (owner)
+		refcount_inc(&owner->refs);
+	ieee80211_aql_update_pending_airtime(hw_to_local(hw), owner,
+					     skb_get_queue_mapping(skb), airtime,
+					     false, info->tx_time_mc);
+}
+EXPORT_SYMBOL(ieee80211_tx_aql_clone);
+
+void ieee80211_tx_aql_complete(struct ieee80211_hw *hw,
+			       struct ieee80211_aql_owner *owner,
+			       struct sk_buff *skb, bool wake)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	u16 airtime = ieee80211_info_get_tx_time_est(info);
+	struct ieee80211_local *local = hw_to_local(hw);
+
+	if (airtime) {
+		ieee80211_aql_update_pending_airtime(local, owner,
+						     skb_get_queue_mapping(skb),
+						     airtime, true, info->tx_time_mc);
+		ieee80211_info_set_tx_time_est(info, 0);
+		if (wake && local->ops->wake_tx_queue == ieee80211_handle_wake_tx_queue &&
+		    !READ_ONCE(local->aql_wake_disabled))
+			tasklet_schedule(&local->aql_txq_tasklet);
+	}
+	ieee80211_tx_aql_put(owner);
+}
+EXPORT_SYMBOL(ieee80211_tx_aql_complete);
 
