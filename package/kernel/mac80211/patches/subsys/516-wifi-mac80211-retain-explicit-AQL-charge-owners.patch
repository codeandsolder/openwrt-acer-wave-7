-/* wake_tx_queue handler for driver not implementing a custom one*/
+static void ieee80211_handle_wake_tx_queue_ac(struct ieee80211_local *local,
+					      u8 ac, bool completion)
+{
+	struct ieee80211_hw *hw = &local->hw;
+	struct ieee80211_txq *queue;
+
+	spin_lock(&local->handle_wake_tx_queue_lock);
+
+	ieee80211_txq_schedule_start(hw, ac);
+	while ((queue = ieee80211_next_txq(hw, ac))) {
+		if (completion) {
+			struct ieee80211_sub_if_data *sdata = vif_to_sdata(queue->vif);
+
+			if (READ_ONCE(local->in_reconfig) ||
+			    READ_ONCE(local->quiescing) ||
+			    READ_ONCE(local->suspended) ||
+			    !READ_ONCE(local->started) ||
+			    !ieee80211_sdata_running(sdata) ||
+			    !(get_bss_sdata(sdata)->flags & IEEE80211_SDATA_IN_DRIVER)) {
+				set_bit(IEEE80211_TXQ_DIRTY, &to_txq_info(queue)->flags);
+				goto return_queue;
+			}
+			if (queue->sta &&
+			    READ_ONCE(container_of(queue->sta, struct sta_info, sta)->removed))
+				goto return_queue;
+		}
+		wake_tx_push_queue(local, queue);
+return_queue:
+		ieee80211_return_txq(hw, queue, false);
+	}
+	ieee80211_txq_schedule_end(hw, ac);
+	spin_unlock(&local->handle_wake_tx_queue_lock);
+}
