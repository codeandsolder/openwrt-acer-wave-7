+static void ath12k_wifi7_reo_cmd_complete(struct ath12k_dp *dp, u16 tag,
+					struct hal_reo_status *status)
+{
+	struct ath12k_reo_cmd_pending *pending;
+	struct ath12k_dp_rx_reo_cmd *cmd;
+	u16 num = status->uniform_hdr.cmd_num;
+
+	if (!num || num > ARRAY_SIZE(dp->reo_cmd_pending))
+		return;
+
+	spin_lock_bh(&dp->reo_cmd_lock);
+	pending = &dp->reo_cmd_pending[num - 1];
+	if (pending->status_tag != tag) {
+		spin_unlock_bh(&dp->reo_cmd_lock);
+		return;
+	}
+	cmd = pending->cmd;
+	*pending = (struct ath12k_reo_cmd_pending){};
+	spin_unlock_bh(&dp->reo_cmd_lock);
+
+	/* A callback may submit another command. Do not hold the owner lock. */
+	if (cmd) {
+		cmd->handler(dp, &cmd->data, status->uniform_hdr.cmd_status);
+		kfree(cmd);
+	}
+}
