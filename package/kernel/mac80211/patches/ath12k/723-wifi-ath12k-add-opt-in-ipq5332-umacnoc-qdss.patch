+/* QMI callbacks only retain validated-size messages and queue sleeping
+ * operations on the ordered QMI event workqueue. A diagnostic DTB may
+ * provision ETR during boot; MODE_ON still requires explicit debugfs start.
+ */
+static void ath12k_qmi_msg_qdss_req_mem_cb(struct qmi_handle *hdl,
+					   struct sockaddr_qrtr *sq,
+					   struct qmi_txn *txn,
+					   const void *decoded)
+{
+	struct ath12k_qmi *qmi = container_of(hdl, struct ath12k_qmi, handle);
+	const struct qmi_wlanfw_request_mem_ind_msg_v01 *msg = decoded;
+	struct qmi_wlanfw_request_mem_ind_msg_v01 *copy;
+
+	/* HOST_CAP negotiation happens before the BDF profile upload.
+	 * Preserve evidence of an indication even if firmware sends it
+	 * during this gap rather than after qdss.configured is set.
+	 */
+	if (qmi->ab->hw_rev != ATH12K_HW_IPQ5332_HW10)
+		return;
+	atomic_inc(&qmi->qdss.mem_req_seen);
+	ath12k_info(qmi->ab,
+		    "QDSS: FW ETR memory indication configured=%u segments=%u first-type=%u first-size=%u\n",
+		    READ_ONCE(qmi->qdss.configured), msg->mem_seg_len,
+		    msg->mem_seg_len ? msg->mem_seg[0].type : 0,
+		    msg->mem_seg_len ? msg->mem_seg[0].size : 0);
+	if (!READ_ONCE(qmi->qdss.configured)) {
+		atomic_inc(&qmi->qdss.mem_req_before_config);
+		ath12k_warn(qmi->ab, "QDSS: FW ETR request arrived before profile configuration\n");
+		return;
+	}
+	if (msg->mem_seg_len != 1 || msg->mem_seg[0].type != ATH12K_QDSS_MEM_TYPE) {
+		atomic_inc(&qmi->qdss.mem_req_invalid);
+		ath12k_warn(qmi->ab, "QDSS: unexpected memory request\n");
+		return;
+	}
+
+	copy = kmemdup(msg, sizeof(*msg), GFP_ATOMIC);
+	if (!copy)
+		return;
+	if (ath12k_qmi_driver_event_post(qmi, ATH12K_QMI_EVENT_QDSS_REQ_MEM,
+					   copy))
+		kfree(copy);
+}
+
+static void ath12k_qmi_msg_qdss_save_cb(struct qmi_handle *hdl,
+					struct sockaddr_qrtr *sq,
+					struct qmi_txn *txn,
+					const void *decoded)
+{
+	struct ath12k_qmi *qmi = container_of(hdl, struct ath12k_qmi, handle);
+	struct ath12k_qdss_save_ind *copy;
+
+	if (!READ_ONCE(qmi->qdss.configured))
+		return;
+	copy = kmemdup(decoded, sizeof(*copy), GFP_ATOMIC);
+	if (!copy)
+		return;
+	if (ath12k_qmi_driver_event_post(qmi, ATH12K_QMI_EVENT_QDSS_SAVE, copy))
+		kfree(copy);
+}
+
 static const struct qmi_msg_handler ath12k_qmi_msg_handlers[] = {
 	{
 		.type = QMI_INDICATION,
@@ -4448,6 +4526,20 @@
 		.fn = ath12k_qmi_msg_fw_ready_cb,
 	},
 
+	{
+		.type = QMI_INDICATION,
+		.msg_id = ATH12K_QDSS_QMI_REQ_MEM,
+		.ei = qmi_wlanfw_request_mem_ind_msg_v01_ei,
+		.decoded_size = sizeof(struct qmi_wlanfw_request_mem_ind_msg_v01),
+		.fn = ath12k_qmi_msg_qdss_req_mem_cb,
+	},
+	{
+		.type = QMI_INDICATION,
+		.msg_id = ATH12K_QDSS_QMI_SAVE,
+		.ei = ath12k_qdss_save_ind_ei,
+		.decoded_size = sizeof(struct ath12k_qdss_save_ind),
+		.fn = ath12k_qmi_msg_qdss_save_cb,
+	},
 	/* end of list */
 	{},
 };
@@ -4549,6 +4641,7 @@
 				set_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags);
 			break;
 		case ATH12K_QMI_EVENT_SERVER_EXIT:
+			ath12k_qdss_cleanup(ab);
 			set_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags);
 			break;
 		case ATH12K_QMI_EVENT_REQUEST_MEM:
@@ -4599,12 +4692,25 @@
 			if (ret < 0)
 				set_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags);
 			break;
+		case ATH12K_QMI_EVENT_QDSS_REQ_MEM:
+			ret = ath12k_qdss_handle_mem_req(ab, event->data);
+			if (ret) {
+				ath12k_warn(ab, "QDSS: ETR request failed: %d\n", ret);
+				ath12k_qdss_cleanup(ab);
+			}
+			break;
+		case ATH12K_QMI_EVENT_QDSS_SAVE:
+			ret = ath12k_qdss_handle_save(ab, event->data);
+			if (ret)
+				ath12k_warn(ab, "QDSS: trace save failed: %d\n", ret);
+			break;
 		default:
 			ath12k_warn(ab, "invalid event type: %d", event->type);
 			break;
 		}
 
 skip:
+		kfree(event->data);
 		kfree(event);
 		spin_lock(&qmi->event_lock);
 	}
@@ -4618,6 +4724,7 @@
 	memset(&ab->qmi.target, 0, sizeof(struct target_info));
 	memset(&ab->qmi.target_mem, 0, sizeof(struct target_mem_chunk));
 	ab->qmi.ab = ab;
+	ath12k_qdss_init(ab);
 
 	ab->qmi.target_mem_mode = ab->target_mem_mode;
 	ret = qmi_handle_init(&ab->qmi.handle, ATH12K_QMI_RESP_LEN_MAX,
@@ -4657,6 +4764,7 @@
 	qmi_handle_release(&ab->qmi.handle);
 	cancel_work_sync(&ab->qmi.event_work);
 	destroy_workqueue(ab->qmi.event_wq);
+	ath12k_qdss_cleanup(ab);
 	ath12k_qmi_aux_uc_free(ab);
 	ath12k_qmi_m3_free(ab);
 	ath12k_qmi_free_target_mem_chunk(ab);
@@ -4669,3 +4777,46 @@
 	ath12k_qmi_aux_uc_free(ab);
 	ath12k_qmi_m3_free(ab);
 }
+
+
+/* Return the dedicated physical ETR reservation to WCSS, never Linux RAM.
+ * All payloads use the existing WLFW_RESPOND_MEM structs for QMI 0x0040.
+ */
+int ath12k_qdss_qmi_send_mem_info(struct ath12k_base *ab,
+				 phys_addr_t addr, u32 size)
+{
+	struct qmi_wlanfw_respond_mem_req_msg_v01 req = {};
+	struct qmi_wlanfw_respond_mem_resp_msg_v01 resp = {};
+	struct qmi_txn txn;
+	int ret;
+
+	req.mem_seg_len = 1;
+	req.mem_seg[0].addr = addr;
+	req.mem_seg[0].size = size;
+	req.mem_seg[0].type = ATH12K_QDSS_MEM_TYPE;
+
+	ret = qmi_txn_init(&ab->qmi.handle, &txn,
+			   qmi_wlanfw_respond_mem_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+
+	ret = qmi_send_request(&ab->qmi.handle, NULL, &txn,
+			       ATH12K_QDSS_QMI_MEM_INFO,
+			       QMI_WLANFW_RESPOND_MEM_REQ_MSG_V01_MAX_LEN,
+			       qmi_wlanfw_respond_mem_req_msg_v01_ei, &req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+	ret = qmi_txn_wait(&txn,
+			   msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+	if (ret < 0)
+		return ret;
+	if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
+		ath12k_warn(ab, "QDSS: mem info failed result %u error %u\n",
+			    resp.resp.result, resp.resp.error);
+		return -EREMOTEIO;
+	}
+
+	return 0;
+}
diff --git a/drivers/net/wireless/ath/ath12k/qmi.h b/drivers/net/wireless/ath/ath12k/qmi.h
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -77,6 +77,8 @@
 	ATH12K_QMI_EVENT_POWER_UP,
 	ATH12K_QMI_EVENT_POWER_DOWN,
 	ATH12K_QMI_EVENT_HOST_CAP,
+	ATH12K_QMI_EVENT_QDSS_REQ_MEM,
+	ATH12K_QMI_EVENT_QDSS_SAVE,
 	ATH12K_QMI_EVENT_MAX,
 };
 
@@ -166,6 +168,24 @@
 	struct m3_mem_region aux_uc_mem;
 	unsigned int service_ins_id;
 	struct dev_mem_info dev_mem[ATH12K_QMI_WLFW_MAX_DEV_MEM_NUM_V01];
+
+	/* UMACNOC QDSS is opt-in and its buffer is never shared with target
+	 * WLAN allocations. Protected by qdss.lock (configured is READ_ONCE
+	 * in QMI indication callbacks).
+	 */
+	struct {
+		struct mutex lock;
+		phys_addr_t base;
+		u32 size;
+		void __iomem *etr;
+		bool configured;
+		bool active;
+		bool start_requested;
+		/* QMI indications may precede QDSS profile download. */
+		atomic_t mem_req_seen;
+		atomic_t mem_req_before_config;
+		atomic_t mem_req_invalid;
+	} qdss;
 };
 
 #define QMI_WLANFW_HOST_CAP_REQ_MSG_V01_MAX_LEN		261
diff --git a/drivers/net/wireless/ath/ath12k/qdss.c b/drivers/net/wireless/ath/ath12k/qdss.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/qdss.c
@@ -0,0 +1,597 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * Opt-in Qualcomm WCSS UMACNOC trace through the existing WLFW QMI service.
+ * Wire formats are derived from Qualcomm QSDK athdbg_qdss.c/athdbg_qmi.c.
+ * Never start tracing automatically: capture is a diagnostic operation.
+ */
+#include <linux/debugfs.h>
+#include <linux/devcoredump.h>
+#include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "core.h"
+#include "debug.h"
+#include "qdss.h"
+#include "qmi.h"
+#include "qdss_qmi_eis.h"
+
+static bool ath12k_qdss_supported(const struct ath12k_base *ab)
+{
+	return ab->hw_rev == ATH12K_HW_IPQ5332_HW10;
+}
+
+/* Dedicated no-map ETR is installed only by the diagnostic board DTB.
+ * Normal IPQ5332 images retain CNSS_QDSS_CFG_MISS and unchanged FW boot.
+ */
+bool ath12k_qdss_boot_config_enabled(struct ath12k_base *ab)
+{
+	struct reserved_mem *rmem;
+
+	if (!ath12k_qdss_supported(ab))
+		return false;
+
+	rmem = ath12k_core_get_reserved_mem_by_name(ab, "q6-etr-dump");
+	return rmem && rmem->size == ATH12K_QDSS_ETR_MAX &&
+	       IS_ALIGNED(rmem->base, PAGE_SIZE);
+}
+
+static int ath12k_qdss_send_qmi(struct ath12k_base *ab, u32 id,
+			       unsigned int max_req_len,
+			       const struct qmi_elem_info *req_ei,
+			       const void *request,
+			       const struct qmi_elem_info *resp_ei,
+			       void *response,
+			       const struct qmi_response_type_v01 *result)
+{
+	struct qmi_txn txn;
+	int ret;
+
+	/* qmi_txn_init() returns a nonnegative transaction ID on success. */
+	ret = qmi_txn_init(&ab->qmi.handle, &txn, resp_ei, response);
+	if (ret < 0)
+		return ret;
+
+	ret = qmi_send_request(&ab->qmi.handle, NULL, &txn, id, max_req_len,
+			       req_ei, request);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+
+	ret = qmi_txn_wait(&txn,
+			   msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+	if (ret < 0)
+		return ret;
+
+	if (result->result != QMI_RESULT_SUCCESS_V01) {
+		ath12k_warn(ab, "QDSS QMI %#x rejected: result %u error %u\n",
+			    id, result->result, result->error);
+		return -EREMOTEIO;
+	}
+
+	return 0;
+}
+
+static int ath12k_qdss_send_config(struct ath12k_base *ab)
+{
+	const struct firmware *fw;
+	struct ath12k_qdss_cfg_req *req;
+	struct ath12k_qdss_cfg_resp resp;
+	size_t offset;
+	u32 segment = 0;
+	int ret;
+
+	fw = ath12k_core_firmware_request(ab, ATH12K_QDSS_FW_FILE);
+	if (IS_ERR(fw))
+		return PTR_ERR(fw);
+
+	if (!fw->size || fw->size > U32_MAX) {
+		ret = -EINVAL;
+		goto out_fw;
+	}
+
+	req = kzalloc_obj(*req, GFP_KERNEL);
+	if (!req) {
+		ret = -ENOMEM;
+		goto out_fw;
+	}
+
+	req->total_size_valid = 1;
+	req->total_size = fw->size;
+	req->seg_id_valid = 1;
+	req->data_valid = 1;
+	req->end_valid = 1;
+
+	for (offset = 0; offset < fw->size; offset += req->data_len) {
+		req->seg_id = segment++;
+		req->data_len = min_t(size_t, fw->size - offset,
+				      sizeof(req->data));
+		memcpy(req->data, fw->data + offset, req->data_len);
+		req->end = offset + req->data_len == fw->size;
+		memset(&resp, 0, sizeof(resp));
+
+		ret = ath12k_qdss_send_qmi(ab, ATH12K_QDSS_QMI_CONFIG, 6167,
+					  ath12k_qdss_cfg_req_ei, req,
+					  ath12k_qdss_cfg_resp_ei, &resp,
+					  &resp.resp);
+		if (ret)
+			goto out_req;
+	}
+
+	ath12k_info(ab, "QDSS: uploaded %s (%zu bytes, %u segments)\n",
+		    ATH12K_QDSS_FW_FILE, fw->size, segment);
+out_req:
+	kfree(req);
+out_fw:
+	release_firmware(fw);
+	return ret;
+}
+
+static int ath12k_qdss_mode(struct ath12k_base *ab, bool enabled)
+{
+	struct ath12k_qdss_mode_req req = {
+		.mode_valid = 1,
+		.mode = enabled ? ATH12K_QDSS_TRACE_ON : ATH12K_QDSS_TRACE_OFF,
+		.option_valid = 1,
+		.option = enabled ? 0 : ATH12K_QDSS_QMI_STOP_ALL,
+	};
+	struct ath12k_qdss_mode_resp resp = {};
+
+	return ath12k_qdss_send_qmi(ab, ATH12K_QDSS_QMI_MODE, 18,
+				   ath12k_qdss_mode_req_ei, &req,
+				   ath12k_qdss_mode_resp_ei, &resp, &resp.resp);
+}
+
+static void ath12k_qdss_reset_locked(struct ath12k_qmi *qmi);
+
+/* With CNSS_QDSS_CFG_MISS cleared the firmware may wait for its config
+ * during BDF bring-up, so download the profile there. The QDSS ETR memory
+ * reservation itself does NOT imply that tracing should start. An explicit
+ * debugfs request is still required before MODE_ON is sent.
+ */
+static int ath12k_qdss_configure(struct ath12k_base *ab, bool request_trace)
+{
+	struct ath12k_qmi *qmi = &ab->qmi;
+	struct reserved_mem *rmem;
+	int ret = 0;
+
+	if (!ath12k_qdss_boot_config_enabled(ab))
+		return -EOPNOTSUPP;
+
+	mutex_lock(&qmi->qdss.lock);
+	if (qmi->qdss.configured) {
+		if (!request_trace)
+			goto out_unlock;
+		if (qmi->qdss.start_requested || qmi->qdss.active) {
+			ret = -EBUSY;
+			goto out_unlock;
+		}
+		qmi->qdss.start_requested = true;
+		if (qmi->qdss.etr) {
+			/* Firmware already accepted our ETR mapping during boot. */
+			ret = ath12k_qdss_mode(ab, true);
+			if (!ret)
+				qmi->qdss.active = true;
+			else
+				qmi->qdss.start_requested = false;
+		}
+		goto out_unlock;
+	}
+
+	rmem = ath12k_core_get_reserved_mem_by_name(ab, "q6-etr-dump");
+	if (!rmem || rmem->size != ATH12K_QDSS_ETR_MAX ||
+	    !IS_ALIGNED(rmem->base, PAGE_SIZE)) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	qmi->qdss.base = rmem->base;
+	qmi->qdss.size = rmem->size;
+	qmi->qdss.start_requested = request_trace;
+	WRITE_ONCE(qmi->qdss.configured, true);
+
+	ret = ath12k_qdss_send_config(ab);
+	if (ret) {
+		ath12k_warn(ab, "QDSS: firmware configuration failed: %d\n", ret);
+		ath12k_qdss_reset_locked(qmi);
+	}
+out_unlock:
+	mutex_unlock(&qmi->qdss.lock);
+	return ret;
+}
+
+int ath12k_qdss_prepare_boot(struct ath12k_base *ab)
+{
+	int ret = ath12k_qdss_configure(ab, false);
+
+	if (!ret)
+		ath12k_info(ab, "QDSS: early ETR config uploaded, trace disabled\n");
+	return ret;
+}
+
+static int ath12k_qdss_start(struct ath12k_base *ab)
+{
+	return ath12k_qdss_configure(ab, true);
+}
+
+static int ath12k_qdss_stop(struct ath12k_base *ab)
+{
+	struct ath12k_qmi *qmi = &ab->qmi;
+	int ret = 0;
+
+	mutex_lock(&qmi->qdss.lock);
+	if (!qmi->qdss.configured) {
+		ret = -EALREADY;
+		goto out_unlock;
+	}
+
+	if (!qmi->qdss.active) {
+		/* Firmware may still be waiting for MEM_INFO. Cancel the
+		 * negotiated session first; do not silently forget a pending
+		 * request and potentially strand WCSS during initialization.
+		 */
+		ret = ath12k_qdss_mode(ab, false);
+		if (!ret) {
+			ath12k_qdss_reset_locked(qmi);
+			ath12k_info(ab, "QDSS: unstarted configuration canceled\n");
+		}
+		goto out_unlock;
+	}
+
+	ret = ath12k_qdss_mode(ab, false);
+	if (!ret)
+		qmi->qdss.active = false; /* retain ETR until FW SAVE */
+out_unlock:
+	mutex_unlock(&qmi->qdss.lock);
+	return ret;
+}
+
+int ath12k_qdss_handle_mem_req(struct ath12k_base *ab,
+			      const struct qmi_wlanfw_request_mem_ind_msg_v01 *req)
+{
+	struct ath12k_qmi *qmi = &ab->qmi;
+	u32 size;
+	int ret;
+
+	if (!ath12k_qdss_supported(ab))
+		return -EOPNOTSUPP;
+
+	if (req->mem_seg_len != 1 ||
+	    req->mem_seg[0].type != ATH12K_QDSS_MEM_TYPE)
+		return -EINVAL;
+	size = req->mem_seg[0].size;
+
+	mutex_lock(&qmi->qdss.lock);
+	if (!qmi->qdss.configured || qmi->qdss.etr ||
+	    !size || size > qmi->qdss.size) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	qmi->qdss.etr = ioremap(qmi->qdss.base, qmi->qdss.size);
+	if (!qmi->qdss.etr) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+
+	ret = ath12k_qdss_qmi_send_mem_info(ab, qmi->qdss.base, size);
+	if (ret)
+		goto out_unmap;
+
+	/* Qualcomm QSDK explicitly allows up to one second after MEM_INFO
+	 * for WCSS to finish configuring its ETR sink.
+	 */
+	msleep(1000);
+	if (qmi->qdss.start_requested) {
+		ret = ath12k_qdss_mode(ab, true);
+		if (ret)
+			goto out_unmap;
+		qmi->qdss.active = true;
+		ath12k_info(ab, "QDSS: WCSS UMACNOC tracing active, ETR %pa size %#x\n",
+			    &qmi->qdss.base, size);
+	} else {
+		ath12k_info(ab, "QDSS: ETR memory provisioned at %pa size %#x, tracing idle\n",
+			    &qmi->qdss.base, size);
+	}
+	goto out_unlock;
+
+out_unmap:
+	iounmap(qmi->qdss.etr);
+	qmi->qdss.etr = NULL;
+	WRITE_ONCE(qmi->qdss.configured, false);
+out_unlock:
+	mutex_unlock(&qmi->qdss.lock);
+	return ret;
+}
+
+/* Firmware can stream the dump back over QMI rather than referencing ETR
+ * memory. Strict sequence, length, and termination checks prevent a malformed
+ * response from being presented as a complete trace.
+ */
+static int ath12k_qdss_fetch_qmi(struct ath12k_base *ab, u8 *dest, u32 total)
+{
+	struct ath12k_qdss_data_resp *resp;
+	struct ath12k_qdss_data_req req;
+	struct qmi_txn txn;
+	u32 pos = 0, seg_id = 0;
+	int ret;
+
+	resp = kzalloc_obj(*resp, GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+
+	while (pos < total) {
+		memset(resp, 0, sizeof(*resp));
+		req.seg_id = seg_id;
+		ret = qmi_txn_init(&ab->qmi.handle, &txn,
+				   ath12k_qdss_data_resp_ei, resp);
+		if (ret < 0)
+			break;
+		ret = qmi_send_request(&ab->qmi.handle, NULL, &txn,
+				       ATH12K_QDSS_QMI_DATA, 7,
+				       ath12k_qdss_data_req_ei, &req);
+		if (ret < 0) {
+			qmi_txn_cancel(&txn);
+			break;
+		}
+		ret = qmi_txn_wait(&txn,
+				   msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+		if (ret < 0)
+			break;
+		if (resp->resp.result != QMI_RESULT_SUCCESS_V01 ||
+		    !resp->data_valid || !resp->data_len ||
+		    resp->data_len > total - pos ||
+		    (resp->seg_id_valid && resp->seg_id != seg_id) ||
+		    (resp->total_size_valid && resp->total_size != total)) {
+			ret = -EPROTO;
+			break;
+		}
+
+		memcpy(dest + pos, resp->data, resp->data_len);
+		pos += resp->data_len;
+		seg_id++;
+		if ((resp->end_valid && !!resp->end) != (pos == total)) {
+			ret = -EPROTO;
+			break;
+		}
+	}
+	kfree(resp);
+	/* qmi_txn_wait() also returns a positive decoded byte count on
+	 * success, which must not propagate as a failed trace save.
+	 */
+	return ret < 0 ? ret : 0;
+}
+
+int ath12k_qdss_handle_save(struct ath12k_base *ab,
+			    const struct ath12k_qdss_save_ind *req)
+{
+	struct ath12k_qmi *qmi = &ab->qmi;
+	u8 *data;
+	u32 total = 0, i;
+	int ret = 0;
+
+	mutex_lock(&qmi->qdss.lock);
+	if (!qmi->qdss.configured || !qmi->qdss.etr) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	/* WLFW QDSS SAVE source selects the transport, not total_size:
+	 * 0 = ETR physical-memory segment(s), 1 = QMI DATA requests.
+	 * A memory-backed trace can (and generally does) report total_size.
+	 */
+	switch (req->source) {
+	case 1:
+		total = req->total_size;
+		if (!total || total > qmi->qdss.size) {
+			ret = -EFBIG;
+			goto out_unlock;
+		}
+		break;
+	case 0:
+		if (!req->mem_seg_valid || !req->mem_seg_len ||
+		    req->mem_seg_len > ATH12K_QMI_WLANFW_MAX_NUM_MEM_SEG_V01) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+		for (i = 0; i < req->mem_seg_len; i++) {
+			const struct qmi_wlanfw_mem_seg_resp_s_v01 *seg =
+				&req->mem_seg[i];
+			u64 offset;
+
+			if (seg->addr < qmi->qdss.base) {
+				ret = -ERANGE;
+				goto out_unlock;
+			}
+			offset = seg->addr - qmi->qdss.base;
+			if (offset >= qmi->qdss.size ||
+			    !seg->size || seg->size > qmi->qdss.size - offset ||
+			    seg->size > qmi->qdss.size - total) {
+				ret = -ERANGE;
+				goto out_unlock;
+			}
+			total += seg->size;
+		}
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+		goto out_unlock;
+	}
+	data = vzalloc(total);
+	if (!data) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+
+	if (req->source == 1) {
+		ret = ath12k_qdss_fetch_qmi(ab, data, total);
+		if (ret)
+			goto out_free;
+	} else {
+		u32 pos = 0;
+
+		for (i = 0; i < req->mem_seg_len; i++) {
+			const struct qmi_wlanfw_mem_seg_resp_s_v01 *s =
+				&req->mem_seg[i];
+
+			memcpy_fromio(data + pos,
+				      (u8 __iomem *)qmi->qdss.etr +
+				      (s->addr - qmi->qdss.base), s->size);
+			pos += s->size;
+		}
+	}
+
+	ath12k_info(ab, "QDSS: captured %u raw UMACNOC bytes (source %u)\n",
+		    total, req->source);
+	/* dev_coredumpv owns and vfree()s the vmalloc-backed buffer. */
+	dev_coredumpv(ab->dev, data, total, GFP_KERNEL);
+	ath12k_qdss_reset_locked(qmi);
+	goto out_unlock;
+
+out_free:
+	vfree(data);
+out_unlock:
+	/* A stopped trace with a failed save must not trap the device in
+	 * configured-but-unrecoverable state. No ETR writer is active.
+	 */
+	if (ret && !qmi->qdss.active)
+		ath12k_qdss_reset_locked(qmi);
+	mutex_unlock(&qmi->qdss.lock);
+	return ret;
+}
+
+static void ath12k_qdss_reset_locked(struct ath12k_qmi *qmi)
+{
+	WRITE_ONCE(qmi->qdss.configured, false);
+	qmi->qdss.active = false;
+	qmi->qdss.start_requested = false;
+	if (qmi->qdss.etr) {
+		iounmap(qmi->qdss.etr);
+		qmi->qdss.etr = NULL;
+	}
+	qmi->qdss.base = 0;
+	qmi->qdss.size = 0;
+}
+
+void ath12k_qdss_init(struct ath12k_base *ab)
+{
+	mutex_init(&ab->qmi.qdss.lock);
+	atomic_set(&ab->qmi.qdss.mem_req_seen, 0);
+	atomic_set(&ab->qmi.qdss.mem_req_before_config, 0);
+	atomic_set(&ab->qmi.qdss.mem_req_invalid, 0);
+}
+
+void ath12k_qdss_cleanup(struct ath12k_base *ab)
+{
+	struct ath12k_qmi *qmi = &ab->qmi;
+
+	mutex_lock(&qmi->qdss.lock);
+	ath12k_qdss_reset_locked(qmi);
+	mutex_unlock(&qmi->qdss.lock);
+}
+
+#ifdef CPTCFG_ATH12K_DEBUGFS
+static ssize_t ath12k_qdss_write_control(struct file *file,
+					   const char __user *buf,
+					   size_t count, loff_t *ppos,
+					   bool start)
+{
+	struct ath12k_base *ab = file->private_data;
+	unsigned int trigger;
+	int ret;
+
+	if (*ppos)
+		return -EINVAL;
+	ret = kstrtouint_from_user(buf, count, 0, &trigger);
+	if (ret)
+		return ret;
+	if (trigger != 1)
+		return -EINVAL;
+
+	ret = start ? ath12k_qdss_start(ab) : ath12k_qdss_stop(ab);
+	if (ret)
+		return ret;
+	*ppos += count;
+	return count;
+}
+
+static ssize_t ath12k_qdss_start_write(struct file *file,
+					const char __user *buf,
+					size_t count, loff_t *ppos)
+{
+	return ath12k_qdss_write_control(file, buf, count, ppos, true);
+}
+
+static ssize_t ath12k_qdss_stop_write(struct file *file,
+					const char __user *buf,
+					size_t count, loff_t *ppos)
+{
+	return ath12k_qdss_write_control(file, buf, count, ppos, false);
+}
+
+static const struct file_operations ath12k_qdss_start_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = ath12k_qdss_start_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations ath12k_qdss_stop_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = ath12k_qdss_stop_write,
+	.llseek = noop_llseek,
+};
+
+static ssize_t ath12k_qdss_status_read(struct file *file,
+				       char __user *user_buf, size_t count,
+				       loff_t *ppos)
+{
+	struct ath12k_base *ab = file->private_data;
+	struct ath12k_qmi *qmi = &ab->qmi;
+	char status[224];
+	int len;
+
+	mutex_lock(&qmi->qdss.lock);
+	len = scnprintf(status, sizeof(status),
+			"configured=%u active=%u start_requested=%u etr_ready=%u etr_base=%pa etr_size=%u mem_req_seen=%d mem_req_before_config=%d mem_req_invalid=%d\n",
+			qmi->qdss.configured, qmi->qdss.active,
+			qmi->qdss.start_requested, !!qmi->qdss.etr,
+			&qmi->qdss.base, qmi->qdss.size,
+			atomic_read(&qmi->qdss.mem_req_seen),
+			atomic_read(&qmi->qdss.mem_req_before_config),
+			atomic_read(&qmi->qdss.mem_req_invalid));
+	mutex_unlock(&qmi->qdss.lock);
+	return simple_read_from_buffer(user_buf, count, ppos, status, len);
+}
+
+static const struct file_operations ath12k_qdss_status_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = ath12k_qdss_status_read,
+	.llseek = default_llseek,
+};
+
+void ath12k_qdss_debugfs_create(struct ath12k_base *ab)
+{
+	struct dentry *dir;
+
+	if (!ath12k_qdss_supported(ab))
+		return;
+
+	dir = debugfs_create_dir("umacnoc_qdss", ab->debugfs_soc);
+	if (IS_ERR_OR_NULL(dir))
+		return;
+
+	debugfs_create_file("start", 0200, dir, ab,
+			    &ath12k_qdss_start_fops);
+	debugfs_create_file("stop_and_capture", 0200, dir, ab,
+			    &ath12k_qdss_stop_fops);
+	debugfs_create_file("status", 0400, dir, ab,
+			    &ath12k_qdss_status_fops);
+}
+#else
+void ath12k_qdss_debugfs_create(struct ath12k_base *ab) {}
+#endif
diff --git a/drivers/net/wireless/ath/ath12k/qdss.h b/drivers/net/wireless/ath/ath12k/qdss.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/qdss.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* IPQ5332 opt-in Qualcomm WCSS NoC trace capture using existing QMI service. */
+#ifndef ATH12K_QDSS_H
+#define ATH12K_QDSS_H
+
+#include <linux/soc/qcom/qmi.h>
+
+struct ath12k_base;
+struct qmi_wlanfw_request_mem_ind_msg_v01;
+
+#define ATH12K_QDSS_FW_FILE "qdss_trace_umacnoc.bin"
+#define ATH12K_QDSS_ETR_MAX 0x100000
+#define ATH12K_QDSS_MEM_TYPE 6
+#define ATH12K_QDSS_QMI_REQ_MEM 0x003f
+#define ATH12K_QDSS_QMI_MEM_INFO 0x0040
+#define ATH12K_QDSS_QMI_SAVE 0x0041
+#define ATH12K_QDSS_QMI_DATA 0x0042
+#define ATH12K_QDSS_QMI_CONFIG 0x0044
+#define ATH12K_QDSS_QMI_MODE 0x0045
+#define ATH12K_QDSS_QMI_STOP_ALL 1
+#define ATH12K_QDSS_DATA_MAX 6144
+
+enum ath12k_qdss_mode_enum {
+	ATH12K_QDSS_TRACE_OFF = 0,
+	ATH12K_QDSS_TRACE_ON = 1,
+};
+
+struct ath12k_qdss_mode_resp {
+	struct qmi_response_type_v01 resp;
+};
+
+struct ath12k_qdss_cfg_resp {
+	struct qmi_response_type_v01 resp;
+};
+
+struct ath12k_qdss_cfg_req {
+	u8 total_size_valid;
+	u32 total_size;
+	u8 seg_id_valid;
+	u32 seg_id;
+	u8 data_valid;
+	u32 data_len;
+	u8 data[ATH12K_QDSS_DATA_MAX];
+	u8 end_valid;
+	u8 end;
+};
+
+struct ath12k_qdss_mode_req {
+	u8 mode_valid;
+	s32 mode;
+	u8 option_valid;
+	u64 option;
+};
+
+struct ath12k_qdss_data_req {
+	u32 seg_id;
+};
+
+struct ath12k_qdss_data_resp {
+	struct qmi_response_type_v01 resp;
+	u8 total_size_valid;
+	u32 total_size;
+	u8 seg_id_valid;
+	u32 seg_id;
+	u8 data_valid;
+	u32 data_len;
+	u8 data[ATH12K_QDSS_DATA_MAX];
+	u8 end_valid;
+	u8 end;
+};
+
+/* Qualcomm WLFW QDSS trace-save indication (types reused from qmi.h). */
+struct ath12k_qdss_save_ind {
+	u32 source;
+	u32 total_size;
+	u8 mem_seg_valid;
+	u32 mem_seg_len;
+	struct qmi_wlanfw_mem_seg_resp_s_v01
+		mem_seg[ATH12K_QMI_WLANFW_MAX_NUM_MEM_SEG_V01];
+	u8 file_name_valid;
+	char file_name[QMI_WLANFW_MAX_STR_LEN_V01 + 1];
+};
+
+extern const struct qmi_elem_info ath12k_qdss_save_ind_ei[];
+
+bool ath12k_qdss_boot_config_enabled(struct ath12k_base *ab);
+int ath12k_qdss_prepare_boot(struct ath12k_base *ab);
+void ath12k_qdss_init(struct ath12k_base *ab);
+void ath12k_qdss_cleanup(struct ath12k_base *ab);
+void ath12k_qdss_debugfs_create(struct ath12k_base *ab);
+int ath12k_qdss_handle_mem_req(struct ath12k_base *ab,
+			      const struct qmi_wlanfw_request_mem_ind_msg_v01 *req);
+int ath12k_qdss_handle_save(struct ath12k_base *ab,
+			    const struct ath12k_qdss_save_ind *req);
+
+/* Use the existing QMI response-memory encoding from qmi.c. */
+int ath12k_qdss_qmi_send_mem_info(struct ath12k_base *ab,
+				 phys_addr_t addr, u32 size);
+#endif
