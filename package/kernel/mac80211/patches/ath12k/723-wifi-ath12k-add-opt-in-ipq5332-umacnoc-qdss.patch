+#define ATH12K_QDSS_QMI_EIS_H
+
+static const struct qmi_elem_info ath12k_qdss_mode_resp_ei[] = {
+	{
+		.data_type      = QMI_STRUCT,
+		.elem_len       = 1,
+		.elem_size      = sizeof(struct qmi_response_type_v01),
+		.array_type     = NO_ARRAY,
