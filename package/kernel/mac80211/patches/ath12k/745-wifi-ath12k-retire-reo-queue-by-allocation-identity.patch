+static struct ath12k_reo_queue_ref *
+ath12k_wifi7_peer_rx_tid_qref(struct ath12k_base *ab, u16 peer_id, u16 tid)
+{
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
+	struct ath12k_reo_q_addr_lut *lut;
+	bool ml_peer = peer_id & ATH12K_PEER_ML_ID_VALID;
