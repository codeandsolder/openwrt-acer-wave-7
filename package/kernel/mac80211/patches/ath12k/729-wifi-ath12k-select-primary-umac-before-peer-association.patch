 }
 
+/* The association link owns management traffic. On hardware that shares
+ * all reorder queues through one primary UMAC, pick a created, started
+ * preferable radio before publishing any WMI peer-association flags.
+ */
+static u8 ath12k_mac_mlo_select_primary(struct ath12k_hw *ah,
+					struct ath12k_sta *ahsta)
+{
+	struct ath12k_link_sta *arsta;
+	struct ath12k_link_vif *arvif;
+	unsigned long links = ahsta->links_map;
+	u8 link_id, primary = ahsta->assoc_link_id;
+
+	lockdep_assert_wiphy(ah->hw->wiphy);
+
+	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		arsta = wiphy_dereference(ah->hw->wiphy, ahsta->link[link_id]);
+		if (!arsta)
+			continue;
+
+		arvif = arsta->arvif;
+		if (!arvif || !arvif->ar || !arvif->is_created || !arvif->is_started ||
+		    !arvif->ar->ab->hw_params->is_plink_preferable)
+			continue;
+
+		if (link_id == ahsta->assoc_link_id)
+			return link_id;
+
+		if (primary == ahsta->assoc_link_id)
+			primary = link_id;
+	}
+
+	return primary;
+}
+
+static int ath12k_mac_mlo_setup_primary(struct ath12k_hw *ah,
+					struct ath12k_sta *ahsta)
+{
+	struct ath12k_link_sta *arsta;
+	struct ath12k_link_vif *arvif;
+	u8 primary;
+	int ret;
+
+	lockdep_assert_wiphy(ah->hw->wiphy);
+
+	/* An incomplete REO setup may still have pending hardware deletes.
+	 * Require station teardown before attempting another allocation.
+	 */
+	if (ahsta->primary_setup_failed)
+		return -EIO;
+
+	if (ahsta->primary_selected)
+		return 0;
+
+	primary = ath12k_mac_mlo_select_primary(ah, ahsta);
+	arsta = wiphy_dereference(ah->hw->wiphy, ahsta->link[primary]);
+	if (!arsta || !arsta->arvif || !arsta->arvif->ar)
+		return -EINVAL;
+
+	arvif = arsta->arvif;
+	WRITE_ONCE(ahsta->primary_link_id, primary);
+	ahsta->primary_selected = true;
+
+	ret = ath12k_dp_peer_setup(arvif->ar, arvif->vdev_id, arsta->addr);
+	if (ret) {
+		ahsta->primary_setup_failed = true;
+		return ret;
+	}
+
+	ath12k_dbg(arvif->ar->ab, ATH12K_DBG_MAC,
+		   "mac ML STA %pM assoc link %u primary UMAC %u\n",
+		   arsta->addr, ahsta->assoc_link_id, primary);
+
+	return 0;
+}
