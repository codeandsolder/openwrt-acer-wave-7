+/* FW MEC notifications and unknown statuses do not prove buffer release. */
+static bool
+ath12k_wifi7_tx_completion_is_release(struct ath12k_dp *dp,
+				      struct ath12k_tx_completion_stats *stats,
+				      enum hal_wbm_rel_src_module src, u8 status)
+{
+	if (src >= ARRAY_SIZE(stats->tx_wbm_rel_source)) {
+		ath12k_warn(dp->ab, "invalid TX release source %u\n", src);
+		return false;
+	}
+	stats->tx_wbm_rel_source[src]++;
+
+	if (src == HAL_WBM_REL_SRC_MODULE_TQM) {
+		if (status < ARRAY_SIZE(stats->tqm_rel_reason))
+			stats->tqm_rel_reason[status]++;
+		else
+			ath12k_warn(dp->ab, "invalid TQM release reason %u\n", status);
+		return true;
+	}
+
+	if (src != HAL_WBM_REL_SRC_MODULE_FW) {
+		ath12k_warn(dp->ab, "unexpected TX release source %u\n", src);
+		return false;
+	}
+
+	if (status >= ARRAY_SIZE(stats->fw_tx_status)) {
+		ath12k_warn(dp->ab, "unknown FW TX status %u\n", status);
+		return false;
+	}
+
+	stats->fw_tx_status[status]++;
+	return status != HAL_WBM_REL_HTT_TX_COMP_STATUS_MEC_NOTIFY;
+}
+
+static void ath12k_wifi7_tx_retire(struct ath12k_pdev_dp *dp_pdev,
+				   struct ath12k_tx_desc_params *params,
+				   int ring)
+{
+	struct ath12k_dp *dp = dp_pdev->dp;
+	struct sk_buff *skb = params->skb;
+	struct ath12k_skb_cb *skb_cb = ATH12K_SKB_CB(skb);
+	struct ieee80211_vif *vif = skb_cb->vif;
+	struct ath12k_link_vif *arvif;
+	struct ath12k_vif *ahvif;
+
+	dma_unmap_single(dp->dev, skb_cb->paddr, skb->len, DMA_TO_DEVICE);
+	if (params->skb_ext_desc) {
+		dma_unmap_single(dp->dev, skb_cb->paddr_ext_desc,
+				 params->skb_ext_desc->len, DMA_TO_DEVICE);
+		dev_kfree_skb_any(params->skb_ext_desc);
+	}
+	dp->device_stats.tx_completion[ring].completed++;
+
+	if (!vif)
+		return;
+
+	ahvif = ath12k_vif_to_ahvif(vif);
+	arvif = rcu_dereference(ahvif->link[skb_cb->link_id]);
+	if (arvif) {
+		spin_lock_bh(&arvif->link_stats_lock);
+		arvif->link_stats.tx_completed++;
+		spin_unlock_bh(&arvif->link_stats_lock);
+	}
+}
