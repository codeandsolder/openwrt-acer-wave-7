From: Wave7 development <codeandsolder@gmail.com>
Subject: [PATCH] wifi: ath12k: retire only terminal TX completions

Classify release records before resolving their cookies. MEC notifications
are not releases; reserved source and FW status values cannot establish
buffer ownership. Bound the per-source and per-reason statistics and
shard completion counters by their single-consumer ring.

Claim published descriptors under their pool lock and hold RCU from before
claim until after skb reporting. Preserve ownership for device teardown
when its pdev is gone. Retire DMA and account completions in one path,
including firmware drops, and signal empty only after mac80211 reporting.

Reset parsed rate metadata per completion and use only valid rate fields
with the matching link's NSS estimate. Encode the full supported DMA
address in the extension descriptor.

---
--- a/drivers/net/wireless/ath/ath12k/dp.h
+++ b/drivers/net/wireless/ath/ath12k/dp.h
@@ -352,7 +352,6 @@
 struct ath12k_tx_desc_params {
 	struct sk_buff *skb;
 	struct sk_buff *skb_ext_desc;
-	u8 mac_id;
 };
 
 struct ath12k_spt_info {
@@ -433,6 +432,16 @@
 	atomic_t misc_fail;
 };
 
+/* Each completion ring has one NAPI consumer. Keep its counters local
+ * instead of racing other rings (or bouncing a shared atomic counter).
+ */
+struct ath12k_tx_completion_stats {
+	u32 tqm_rel_reason[MAX_TQM_RELEASE_REASON];
+	u32 fw_tx_status[MAX_FW_TX_STATUS];
+	u32 tx_wbm_rel_source[HAL_WBM_REL_SRC_MODULE_MAX];
+	u32 completed;
+} ____cacheline_aligned_in_smp;
+
 struct ath12k_device_dp_stats {
 	u32 err_ring_pkts;
 	u32 invalid_rbm;
@@ -442,11 +451,8 @@
 	struct ath12k_device_dp_tx_err_stats tx_err;
 	u32 reo_rx[DP_REO_DST_RING_MAX][ATH12K_MAX_DEVICES];
 	u32 rx_wbm_rel_source[HAL_WBM_REL_SRC_MODULE_MAX][ATH12K_MAX_DEVICES];
-	u32 tqm_rel_reason[MAX_TQM_RELEASE_REASON];
-	u32 fw_tx_status[MAX_FW_TX_STATUS];
-	u32 tx_wbm_rel_source[HAL_WBM_REL_SRC_MODULE_MAX];
+	struct ath12k_tx_completion_stats tx_completion[DP_TCL_NUM_RING_MAX];
 	u32 tx_enqueued[DP_TCL_NUM_RING_MAX];
-	u32 tx_completed[DP_TCL_NUM_RING_MAX];
 	u32 reo_excep_msdu_buf_type;
 };
 
--- a/drivers/net/wireless/ath/ath12k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_tx.c
