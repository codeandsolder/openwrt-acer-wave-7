-{
-	struct ath12k_pdev_dp *dp_pdev;
-	struct sk_buff *msdu = desc_params->skb;
-	struct ath12k_skb_cb *skb_cb;
-	u8 pdev_idx = ath12k_hw_mac_id_to_pdev_id(dp->hw_params, desc_params->mac_id);
-
-	skb_cb = ATH12K_SKB_CB(msdu);
-
-	dma_unmap_single(dp->dev, skb_cb->paddr, msdu->len, DMA_TO_DEVICE);
-	if (desc_params->skb_ext_desc) {
-		dma_unmap_single(dp->dev, skb_cb->paddr_ext_desc,
-				 desc_params->skb_ext_desc->len, DMA_TO_DEVICE);
-		dev_kfree_skb_any(desc_params->skb_ext_desc);
-	}
-
-	guard(rcu)();
+/*
+ * The caller holds RCU from before this transfer until it finishes reporting
+ * the skb. VIF teardown clears references under the same pool lock and then
+ * waits for RCU when unassigning a link.
+ */
+struct ath12k_pdev_dp *
+ath12k_dp_tx_take_completed(struct ath12k_dp *dp,
+			    struct ath12k_tx_desc_info *desc,
+			    struct ath12k_tx_desc_params *params)
+{
+	struct ath12k_pdev_dp *dp_pdev = NULL;
+	u8 pool_id = desc->pool_id;
+	int pdev_idx;
+
+	spin_lock_bh(&dp->tx_desc_lock[pool_id]);
+	if (!desc->skb)
+		goto out;
+
+	pdev_idx = ath12k_hw_mac_id_to_pdev_id(dp->hw_params, desc->mac_id);
+	if ((unsigned int)pdev_idx >= ARRAY_SIZE(dp->dp_pdevs))
+		goto out;
 
 	dp_pdev = ath12k_dp_to_pdev_dp(dp, pdev_idx);
-
-	ieee80211_free_txskb(ath12k_pdev_dp_to_hw(dp_pdev), msdu);
-
-	if (atomic_dec_and_test(&dp_pdev->num_tx_pending))
-		wake_up(&dp_pdev->tx_empty_waitq);
-}
-EXPORT_SYMBOL(ath12k_dp_tx_free_txbuf);
+	if (!dp_pdev)
+		goto out; /* Device teardown still owns this descriptor. */
+
+	params->skb = desc->skb;
+	params->skb_ext_desc = desc->skb_ext_desc;
+	desc->skb = NULL;
+	desc->skb_ext_desc = NULL;
+	list_move_tail(&desc->list, &dp->tx_desc_free_list[pool_id]);
+out:
+	spin_unlock_bh(&dp->tx_desc_lock[pool_id]);
+	return dp_pdev;
+}
+EXPORT_SYMBOL(ath12k_dp_tx_take_completed);
