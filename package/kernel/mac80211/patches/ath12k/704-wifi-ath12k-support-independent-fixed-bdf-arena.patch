Subject: [PATCH] wifi: ath12k: support independent fixed BDF and HOST_DDR arenas

Fixed-memory QMI devices may reserve their BDF and host data in distinct
physical windows. Accept a named bdf-mem reservation for BDF segments
rather than requiring them to fit inside host-ddr-mem. Keep the existing
order-independent exclusion of BDF intervals when both share a single
reservation.

Reject overlapping separate arenas and overlapping fixed BDF ranges,
and validate every fixed segment against its own reserved region.

---
diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2815,8 +2815,10 @@
 static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 {
 	struct ath12k_hw_group *ag = ab->ag;
-	struct reserved_mem *ddr_rmem, *rmem;
+	struct reserved_mem *ddr_rmem, *bdf_rmem, *rmem;
 	struct {
+		phys_addr_t paddr;
+		size_t size;
 		size_t start;
 		size_t end;
 	} bdf[ATH12K_QMI_WLANFW_MAX_NUM_MEM_SEG_V01] = {};
@@ -2845,6 +2847,20 @@
 		goto out_free;
 	}
 
+	/* A fixed BDF arena may be physically separate from the host
+	 * data arena. An absent bdf-mem name means the BDF is inside
+	 * host-ddr-mem and must be excluded from its allocations.
+	 */
+	bdf_rmem = ath12k_core_get_reserved_mem_by_name(ab, "bdf-mem");
+	if (bdf_rmem && bdf_rmem != ddr_rmem &&
+	    (bdf_rmem->base <= ddr_rmem->base ?
+	     ddr_rmem->base - bdf_rmem->base < bdf_rmem->size :
+	     bdf_rmem->base - ddr_rmem->base < ddr_rmem->size)) {
+		ath12k_err(ab, "separate BDF and HOST_DDR arenas overlap\n");
+		ret = -EINVAL;
+		goto out_free;
+	}
+
 	if (ab->qmi.mem_seg_count > ARRAY_SIZE(bdf)) {
 		ret = -EINVAL;
 		goto out_free;
@@ -2863,30 +2879,37 @@
 		if (chunk->type != BDF_MEM_REGION_TYPE)
 			continue;
 
+		rmem = bdf_rmem ? bdf_rmem : ddr_rmem;
 		ret = of_property_read_u32_index(ab->dev->of_node,
 						 "qcom,bdf-addr", ab->target_mem_mode, &addr);
 		if (!ret)
 			paddr = addr;
 		else
-			paddr = ddr_rmem->base + ab->hw_params->bdf_addr_offset;
+			paddr = rmem->base + ab->hw_params->bdf_addr_offset;
 
-		if (paddr < ddr_rmem->base ||
-		    paddr - ddr_rmem->base > ddr_rmem->size ||
+		if (paddr < rmem->base ||
+		    paddr - rmem->base > rmem->size ||
 		    !chunk->size ||
-		    chunk->size > ddr_rmem->size - (paddr - ddr_rmem->base)) {
-			ath12k_err(ab, "BDF memory %pa+%u is outside host-ddr-mem %pa+%pa\n",
-				   &paddr, chunk->size, &ddr_rmem->base, &ddr_rmem->size);
+		    chunk->size > rmem->size - (paddr - rmem->base)) {
+			ath12k_err(ab, "BDF memory %pa+%u is outside its reserved arena %pa+%pa\n",
+				   &paddr, chunk->size, &rmem->base, &rmem->size);
 			ret = -EINVAL;
 			goto out_free;
 		}
 
-		start = paddr - ddr_rmem->base;
-		bdf[i].start = start;
-		bdf[i].end = start + chunk->size;
+		bdf[i].paddr = paddr;
+		bdf[i].size = chunk->size;
+		if (rmem == ddr_rmem) {
+			start = paddr - ddr_rmem->base;
+			bdf[i].start = start;
+			bdf[i].end = start + chunk->size;
+		}
 
 		for (j = 0; j < i; j++) {
-			if (bdf[j].end && start < bdf[j].end &&
-			    bdf[j].start < bdf[i].end) {
+			if (bdf[j].size &&
+			    (bdf[j].paddr <= paddr ?
+			     paddr - bdf[j].paddr < bdf[j].size :
+			     bdf[j].paddr - paddr < chunk->size)) {
 				ath12k_err(ab, "overlapping fixed BDF memory regions\n");
 				ret = -EINVAL;
 				goto out_free;
@@ -2931,7 +2954,7 @@
 			break;
 
 		case BDF_MEM_REGION_TYPE:
-			paddr = ddr_rmem->base + bdf[i].start;
+			paddr = bdf[i].paddr;
 			break;
 
 		case CALDB_MEM_REGION_TYPE:
