 	spin_unlock_bh(&dp->rx_desc_lock);
+}
+
+static struct sk_buff *ath12k_dp_rx_build_skb(struct page_pool *pool)
+{
+	struct ath12k_skb_rxcb *rxcb;
+	struct sk_buff *skb;
+	struct page *page;
+
+	BUILD_BUG_ON(SKB_HEAD_ALIGN(DP_RX_POOL_HEADROOM +
+				    DP_RX_BUFFER_SIZE) > PAGE_SIZE);
+
+	page = page_pool_dev_alloc_pages(pool);
+	if (!page)
+		return NULL;
+
+	skb = build_skb(page_address(page),
+			SKB_HEAD_ALIGN(DP_RX_POOL_HEADROOM + DP_RX_BUFFER_SIZE));
+	if (!skb) {
+		page_pool_put_full_page(pool, page, false);
+		return NULL;
+	}
+
+	/* Expose the same 2048-byte DMA window as RXDMA. Charge the full
+	 * page even though the unused end is not visible to the skb.
+	 */
+	skb_reserve(skb, DP_RX_POOL_HEADROOM);
+	skb->truesize = SKB_TRUESIZE(SKB_WITH_OVERHEAD(PAGE_SIZE));
+	skb_mark_for_recycle(skb);
+
+	rxcb = ATH12K_SKB_RXCB(skb);
+	rxcb->paddr = page_pool_get_dma_addr(page) + DP_RX_POOL_HEADROOM;
+	rxcb->pool_mapped = true;
+
+	return skb;
 }
 
