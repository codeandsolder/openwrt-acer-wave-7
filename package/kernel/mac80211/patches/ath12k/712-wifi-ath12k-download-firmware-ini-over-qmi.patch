+/* Download firmware's optional board INI before it requests host DDR.
+ * The transaction uses WLFW INI_FILE_DOWNLOAD (0x56), not WLAN_INI (0x2f).
+ */
+static int ath12k_qmi_ini_file_download(struct ath12k_base *ab)
+{
+	const char *file = ab->hw_params->fw.ini_file;
+	struct qmi_wlanfw_ini_file_download_req_msg_v01 *req;
+	struct qmi_wlanfw_ini_file_download_resp_msg_v01 resp;
+	const struct firmware *fw;
+	struct qmi_txn txn;
+	size_t offset;
+	u32 segment = 0;
+	int ret;
+
+	if (!file)
+		return 0;
+
+	fw = ath12k_core_firmware_request(ab, file);
+	if (IS_ERR(fw)) {
+		ret = PTR_ERR(fw);
+		ath12k_warn(ab, "failed to request firmware INI %s: %d\n", file, ret);
+		return ret;
+	}
+	if (!fw->size || fw->size > U32_MAX) {
+		ret = -EINVAL;
+		goto out_release;
+	}
+
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	if (!req) {
+		ret = -ENOMEM;
+		goto out_release;
+	}
+
+	req->file_id_valid = 1;
+	req->file_id = 0;
+	req->total_size_valid = 1;
+	req->total_size = fw->size;
+	req->seg_id_valid = 1;
+	req->data_valid = 1;
+	req->end_valid = 1;
+
+	for (offset = 0; offset < fw->size; offset += req->data_len) {
+		req->seg_id = segment++;
+		req->data_len = min_t(size_t, fw->size - offset,
+				      QMI_WLANFW_MAX_DATA_SIZE_V01);
+		memcpy(req->data, fw->data + offset, req->data_len);
+		req->end = offset + req->data_len == fw->size;
+
+		memset(&resp, 0, sizeof(resp));
+		ret = qmi_txn_init(&ab->qmi.handle, &txn,
+				   qmi_wlanfw_ini_file_download_resp_msg_v01_ei,
+				   &resp);
+		if (ret < 0)
+			goto out_free;
+
+		ret = qmi_send_request(&ab->qmi.handle, NULL, &txn,
+				       QMI_WLANFW_INI_FILE_DOWNLOAD_REQ_V01,
+				       QMI_WLANFW_INI_FILE_DOWNLOAD_REQ_MSG_V01_MAX_LEN,
+				       qmi_wlanfw_ini_file_download_req_msg_v01_ei,
+				       req);
+		if (ret < 0) {
+			qmi_txn_cancel(&txn);
+			goto out_free;
+		}
+
+		ret = qmi_txn_wait(&txn,
+				   msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+		if (ret < 0)
+			goto out_free;
+
+		if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
+			ath12k_warn(ab,
+				    "firmware INI segment %u rejected: result %u error %u\n",
+				    req->seg_id, resp.resp.result, resp.resp.error);
+			ret = -EREMOTEIO;
+			goto out_free;
+		}
+	}
+
+	ath12k_info(ab, "firmware INI %s downloaded (%zu bytes, %u segments)\n",
+		    file, fw->size, segment);
+	ret = 0;
+out_free:
+	if (ret)
+		ath12k_warn(ab, "firmware INI %s segment %u failed: %d\n",
+			    file, req->seg_id, ret);
+	kfree(req);
+out_release:
+	release_firmware(fw);
 	return ret;
 }
 
