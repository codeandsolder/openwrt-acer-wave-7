From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] wifi: ath12k: use coherent WBM release layout on IPQ5332/QCN6432

IPQ5332 AHB exposes four consecutive TX-completion interrupt lines. Its
shared QCN9274 mapping skips WBM3 for TX and allocates RX release there,
leaving physical WBM4 without its corresponding AHB completion IRQ. An
actual group transmission queued six packets on TCL3, all of which
remained pending even after registering the fourth interrupt.

Use consecutive TX release rings and WBM5 for RX release, as indicated
by the original BE datapath setup on this platform. Keep QCN6432's
MLO companion on the same return-buffer manager layout. Preserve the
existing layout on other revisions. Derive moderation and MSI lookup
from the actual mapping, and make RX error allocation, parsing and
reinject consistent with the selected release ring.

--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -164,26 +164,35 @@
 	return -ENOENT;
 }
 
+/* Convert a physical completion ring to its logical TCL producer. */
+static int ath12k_dp_wbm_tx_ring_index(const struct ath12k_base *ab,
+				       int ring_num)
+{
+	const struct ath12k_hal_tcl_to_wbm_rbm_map *map;
+	int i;
+
+	map = ab->hal.tcl_to_wbm_rbm_map;
+	for (i = 0; i < ab->hw_params->max_tx_ring; i++)
+		if (ring_num == map[i].wbm_ring_num)
+			return i;
+
+	return -ENOENT;
+}
+
 static int ath12k_dp_srng_calculate_msi_group(struct ath12k_base *ab,
 					      enum hal_ring_type type, int ring_num)
 {
-	const struct ath12k_hal_tcl_to_wbm_rbm_map *map;
 	const u8 *grp_mask;
-	int i;
 
 	switch (type) {
 	case HAL_WBM2SW_RELEASE:
-		if (ring_num == HAL_WBM2SW_REL_ERR_RING_NUM) {
+		if (ring_num == ab->hal.hal_params->rx_rel_ring_num) {
 			grp_mask = &ab->hw_params->ring_mask->rx_wbm_rel[0];
 			ring_num = 0;
 		} else {
-			map = ab->hal.tcl_to_wbm_rbm_map;
-			for (i = 0; i < ab->hw_params->max_tx_ring; i++) {
-				if (ring_num == map[i].wbm_ring_num) {
-					ring_num = i;
-					break;
-				}
-			}
+			ring_num = ath12k_dp_wbm_tx_ring_index(ab, ring_num);
+			if (ring_num < 0)
+				return ring_num;
 
 			grp_mask = &ab->hw_params->ring_mask->tx[0];
 		}
@@ -327,14 +336,14 @@
 		params.intr_timer_thres_us = HAL_SRNG_INT_TIMER_THRESHOLD_RX;
 		break;
 	case HAL_WBM2SW_RELEASE:
-		if (ab->hw_params->hw_ops->dp_srng_is_tx_comp_ring(ring_num)) {
+		if (ath12k_dp_wbm_tx_ring_index(ab, ring_num) >= 0) {
 			params.intr_batch_cntr_thres_entries =
 					HAL_SRNG_INT_BATCH_THRESHOLD_TX;
 			params.intr_timer_thres_us =
 					HAL_SRNG_INT_TIMER_THRESHOLD_TX;
 			break;
 		}
-		/* follow through when ring_num != HAL_WBM2SW_REL_ERR_RING_NUM */
+		/* RX release uses the default interrupt moderation. */
 		fallthrough;
 	case HAL_REO_EXCEPTION:
 	case HAL_REO_REINJECT:
@@ -484,6 +493,22 @@
 	struct hal_srng *srng;
 	int i, ret, tx_comp_ring_num;
 	u32 ring_hash_map;
+	unsigned long release_rings;
+	unsigned int max_wbm = ab->hal.srng_config[HAL_WBM2SW_RELEASE].max_rings;
+	unsigned int rx_rel = ab->hal.hal_params->rx_rel_ring_num;
+
+	if (rx_rel >= max_wbm || max_wbm > BITS_PER_LONG ||
+	    ab->hw_params->max_tx_ring > DP_TCL_NUM_RING_MAX)
+		return -EINVAL;
+
+	release_rings = BIT(rx_rel);
+	map = ab->hal.tcl_to_wbm_rbm_map;
+	for (i = 0; i < ab->hw_params->max_tx_ring; i++) {
+		if (map[i].wbm_ring_num >= max_wbm ||
+		    release_rings & BIT(map[i].wbm_ring_num))
+			return -EINVAL;
+		release_rings |= BIT(map[i].wbm_ring_num);
+	}
 
 	ret = ath12k_dp_srng_setup(ab, &dp->wbm_desc_rel_ring,
 				   HAL_SW2WBM_RELEASE, 0, 0,
@@ -526,7 +551,7 @@
 	}
 
 	ret = ath12k_dp_srng_setup(ab, &dp->rx_rel_ring, HAL_WBM2SW_RELEASE,
-				   HAL_WBM2SW_REL_ERR_RING_NUM, 0,
+				   ab->hal.hal_params->rx_rel_ring_num, 0,
 				   DP_RX_RELEASE_RING_SIZE);
 	if (ret) {
 		ath12k_warn(ab, "failed to set up rx_rel ring :%d\n", ret);
