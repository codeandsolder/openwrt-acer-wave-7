-	HAL_SRNG_RING_ID_WBM2SW3_RELEASE, /* RX ERROR RING */
+	HAL_SRNG_RING_ID_WBM2SW3_RELEASE,
 	HAL_SRNG_RING_ID_WBM2SW4_RELEASE,
 	HAL_SRNG_RING_ID_WBM2SW5_RELEASE,
 	HAL_SRNG_RING_ID_WBM2SW6_RELEASE,
@@ -1136,7 +1134,14 @@
 struct ath12k_hw_hal_params {
 	enum hal_rx_buf_return_buf_manager rx_buf_rbm;
 	u32 wbm2sw_cc_enable;
-};
+	u8 rx_rel_ring_num;
+};
+
+static inline enum hal_rx_buf_return_buf_manager
+ath12k_hal_rx_rel_rbm(const struct ath12k_hw_hal_params *params)
+{
+	return HAL_RX_BUF_RBM_SW0_BM + params->rx_rel_ring_num;
+}
 
