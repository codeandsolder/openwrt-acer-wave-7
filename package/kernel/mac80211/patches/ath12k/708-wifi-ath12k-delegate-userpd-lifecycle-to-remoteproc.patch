+/*
+ * Remoteproc exclusively owns UserPD firmware, PAS, SMP2P handshakes and
+ * the shared root-Q6 lifetime.  HIF holds precisely one rproc boot ref.
+ */
 static int ath12k_ahb_power_up(struct ath12k_base *ab)
 {
 	struct ath12k_ahb *ab_ahb = ath12k_ab_to_ahb(ab);
