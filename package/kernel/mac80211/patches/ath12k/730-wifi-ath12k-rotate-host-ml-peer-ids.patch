From: codeandsolder <codeandsolder@gmail.com>
Subject: [PATCH] wifi: ath12k: rotate nonzero host MLO peer IDs

Match the vendor allocator by reserving zero and rotating through
the available host ML peer IDs. Validate host ownership and tagged
ID bounds before returning the slot to the bitmap.

This reduces immediate reuse but does not substitute for confirmed
firmware deletion and REO descriptor lifetime handling.

Signed-off-by: codeandsolder <codeandsolder@gmail.com>
---
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -814,6 +814,7 @@
 	u8 num_radio;
 
 	DECLARE_BITMAP(free_ml_peer_id_map, ATH12K_MAX_MLO_PEERS);
+	u16 last_ml_peer_id;
 
 	struct ath12k_dp_hw dp_hw;
 
--- a/drivers/net/wireless/ath/ath12k/peer.c
+++ b/drivers/net/wireless/ath/ath12k/peer.c
@@ -272,37 +272,42 @@
 
 u16 ath12k_peer_ml_alloc(struct ath12k_hw *ah)
 {
-	u16 ml_peer_id;
+	u16 ml_peer_id = ah->last_ml_peer_id;
+	int i;
 
 	lockdep_assert_wiphy(ah->hw->wiphy);
 
-	for (ml_peer_id = 0; ml_peer_id < ATH12K_MAX_MLO_PEERS; ml_peer_id++) {
+	/* Firmware reserves raw ID zero. Rotate through the remaining IDs
+	 * rather than immediately reusing the lowest recently deleted peer.
+	 */
+	for (i = 0; i < ATH12K_MAX_MLO_PEERS - 1; i++) {
+		ml_peer_id++;
+		if (ml_peer_id >= ATH12K_MAX_MLO_PEERS)
+			ml_peer_id = 1;
+
 		if (test_bit(ml_peer_id, ah->free_ml_peer_id_map))
 			continue;
 
 		set_bit(ml_peer_id, ah->free_ml_peer_id_map);
-		break;
+		ah->last_ml_peer_id = ml_peer_id;
+		return ml_peer_id | ATH12K_PEER_ML_ID_VALID;
 	}
 
-	if (ml_peer_id == ATH12K_MAX_MLO_PEERS)
-		return ATH12K_MLO_PEER_ID_INVALID;
-
-	return ml_peer_id | ATH12K_PEER_ML_ID_VALID;
+	return ATH12K_MLO_PEER_ID_INVALID;
 }
 
 void ath12k_peer_ml_free(struct ath12k_hw *ah, struct ath12k_sta *ahsta)
 {
+	u16 id = ahsta->ml_peer_id & ~ATH12K_PEER_ML_ID_VALID;
+
 	lockdep_assert_wiphy(ah->hw->wiphy);
 
-	/*
-	 * Only devices that allocate the ID on the host own a slot in
-	 * free_ml_peer_id_map.
-	 */
+	/* Firmware-allocated IDs and sentinel values do not own a host slot. */
 	if (ah->host_alloc_ml_id &&
-	    (ahsta->ml_peer_id <
-	     (ATH12K_MAX_MLO_PEERS | ATH12K_PEER_ML_ID_VALID)))
-		clear_bit(ahsta->ml_peer_id & ~ATH12K_PEER_ML_ID_VALID,
-			  ah->free_ml_peer_id_map);
+	    (ahsta->ml_peer_id & ATH12K_PEER_ML_ID_VALID) &&
+	    id && id < ATH12K_MAX_MLO_PEERS)
+		clear_bit(id, ah->free_ml_peer_id_map);
+
 	ahsta->ml_peer_id = ATH12K_MLO_PEER_ID_INVALID;
 }
 
