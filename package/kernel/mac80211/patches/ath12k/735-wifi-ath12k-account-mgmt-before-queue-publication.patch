From: Wave7 development <wave7@local>
Subject: [PATCH] wifi: ath12k: account management TX before queue publication

A WMI TX worker may already be running when another management skb is
queued. Publish it only after pending accounting, and serialize queue
admission with the enqueue. Otherwise a consumer can decrement an
unaccounted skb, leaving a phantom pending count or missing a zero wakeup.
Log queued and outstanding descriptor counts on management flush timeout
to distinguish accounting errors from missing firmware completions.

--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -9598,9 +9598,12 @@
 		       bool is_prb_rsp)
 {
 	struct sk_buff_head *q = &ar->wmi_mgmt_tx_queue;
+	unsigned long flags;
 
 	if (test_bit(ATH12K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags))
 		return -ESHUTDOWN;
+
+	spin_lock_irqsave(&q->lock, flags);
 
 	/* Drop probe response packets when the pending management tx
 	 * count has reached a certain threshold, so as to prioritize
@@ -9609,18 +9612,22 @@
 	 */
 	if (is_prb_rsp &&
 	    atomic_read(&ar->num_pending_mgmt_tx) > ATH12K_PRB_RSP_DROP_THRESHOLD) {
+		spin_unlock_irqrestore(&q->lock, flags);
 		ath12k_warn(ar->ab,
 			    "dropping probe response as pending queue is almost full\n");
 		return -ENOSPC;
 	}
 
-	if (skb_queue_len_lockless(q) >= ATH12K_TX_MGMT_NUM_PENDING_MAX) {
+	if (skb_queue_len(q) >= ATH12K_TX_MGMT_NUM_PENDING_MAX) {
+		spin_unlock_irqrestore(&q->lock, flags);
 		ath12k_warn(ar->ab, "mgmt tx queue is full\n");
 		return -ENOSPC;
 	}
 
-	skb_queue_tail(q, skb);
+	/* Account before publishing to a worker that may already be running. */
 	atomic_inc(&ar->num_pending_mgmt_tx);
+	__skb_queue_tail(q, skb);
+	spin_unlock_irqrestore(&q->lock, flags);
 	wiphy_work_queue(ath12k_ar_to_hw(ar)->wiphy, &ar->wmi_mgmt_tx_work);
 
 	return 0;
@@ -12740,6 +12747,8 @@
 {
 	long time_left;
 	int ret = 0;
+	struct sk_buff *skb;
+	int id, inflight;
 
 	time_left = wait_event_timeout(ar->dp.tx_empty_waitq,
 				       (atomic_read(&ar->dp.num_tx_pending) == 0),
@@ -12755,9 +12764,15 @@
 				       (atomic_read(&ar->num_pending_mgmt_tx) == 0),
 				       ATH12K_FLUSH_TIMEOUT);
 	if (time_left == 0) {
+		inflight = 0;
+		spin_lock_bh(&ar->txmgmt_idr_lock);
+		idr_for_each_entry(&ar->txmgmt_idr, skb, id)
+			inflight++;
+		spin_unlock_bh(&ar->txmgmt_idr_lock);
 		ath12k_warn(ar->ab,
-			    "failed to flush mgmt transmit queue, mgmt pkts pending %d\n",
-			    atomic_read(&ar->num_pending_mgmt_tx));
+			    "failed to flush mgmt transmit queue, mgmt pkts pending %d queued %u inflight %d\n",
+			    atomic_read(&ar->num_pending_mgmt_tx),
+			    skb_queue_len_lockless(&ar->wmi_mgmt_tx_queue), inflight);
 		ret = -ETIMEDOUT;
 	}
 
