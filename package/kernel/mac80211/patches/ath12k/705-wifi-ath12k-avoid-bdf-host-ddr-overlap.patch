From: Code and Solder <codeandsolder@gmail.com>
Subject: [PATCH] wifi: ath12k: keep fixed BDF and host DDR ranges disjoint

When a target requests BDF and HOST_DDR from the same reserved-memory
pool, the previous implementation allocates HOST_DDR starting at byte
zero even if the BDF occupies that address. On QCN6432 mode 2 both
segments were handed the same physical base, overlapping 0x5a000 bytes
and truncating the final HOST_DDR tail. The DSP expects the entire
0xda6000-byte HOST_DDR span after BDF, as verified in its runtime arena
descriptors captured by a Hexagon remoteproc ELF coredump.

Prescan all BDF requests, reserve the maximum size at the configured
BDF address, and assign each contiguous HOST_DDR segment using first
fit around that exclusion regardless of indication order. Check all
offset and size bounds before adding them. Other fixed-memory types
retain their existing allocation behavior.

Signed-off-by: Code and Solder <codeandsolder@gmail.com>
---
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2818,11 +2818,14 @@
 static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 {
 	struct ath12k_hw_group *ag = ab->ag;
 	struct reserved_mem *ddr_rmem, *rmem;
 	size_t host_ddr_off = 0, mlo_off = 0, avail;
-	u32 failed_type = 0, failed_size = 0;
+	size_t bdf_off = 0, bdf_size = 0, bdf_end = 0;
+	phys_addr_t bdf_paddr = 0;
+	bool has_bdf = false;
+	u32 failed_type = 0, failed_size = 0, addr;
 	int i, idx, mlo_idx = 0, ret = 0;
 
 	mutex_lock(&ag->mutex);
 
 	if (!ag->mlo_mem.init_done) {
@@ -2842,19 +2845,65 @@
 	if (!ddr_rmem) {
 		ret = -ENODEV;
 		goto out_free;
 	}
 
+	/* BDF and HOST_DDR may occupy the same fixed reserved-memory pool.
+	 * Reserve the complete BDF span before assigning HOST_DDR chunks:
+	 * firmware is free to request them in either order.
+	 */
+	for (i = 0; i < ab->qmi.mem_seg_count; i++) {
+		if (ab->qmi.target_mem[i].type != BDF_MEM_REGION_TYPE)
+			continue;
+
+		has_bdf = true;
+		bdf_size = max_t(size_t, bdf_size, ab->qmi.target_mem[i].size);
+	}
+
+	if (has_bdf) {
+		ret = of_property_read_u32_index(ab->dev->of_node,
+						 "qcom,bdf-addr", ab->target_mem_mode,
+						 &addr);
+		if (!ret) {
+			if (addr < ddr_rmem->base) {
+				ret = -EINVAL;
+				goto out_free;
+			}
+			bdf_off = addr - ddr_rmem->base;
+		} else {
+			bdf_off = ab->hw_params->bdf_addr_offset;
+		}
+
+		if (bdf_off > ddr_rmem->size ||
+		    bdf_size > ddr_rmem->size - bdf_off) {
+			ath12k_err(ab, "BDF memory offset %#zx size %zu outside host-ddr-mem size %zu\n",
+				   bdf_off, bdf_size, (size_t)ddr_rmem->size);
+			ret = -EINVAL;
+			goto out_free;
+		}
+
+		bdf_end = bdf_off + bdf_size;
+		bdf_paddr = ddr_rmem->base + bdf_off;
+	}
+
 	for (i = 0, idx = 0; i < ab->qmi.mem_seg_count; i++) {
 		struct target_mem_chunk *src = &ab->qmi.target_mem[i];
 		struct target_mem_chunk *dst = &ab->qmi.target_mem[idx];
 		struct target_mem_chunk *mlo_chunk;
 		phys_addr_t paddr;
-		u32 addr;
 
 		switch (src->type) {
 		case HOST_DDR_REGION_TYPE:
+			/* First fit in a monotonically assigned pool, skipping
+			 * the pre-reserved BDF range if this chunk intersects it.
+			 * Compare by subtraction to avoid size arithmetic overflow.
+			 */
+			if (bdf_size && host_ddr_off < bdf_end &&
+			    (host_ddr_off >= bdf_off ||
+			     src->size > bdf_off - host_ddr_off))
+				host_ddr_off = bdf_end;
+
 			if (host_ddr_off > ddr_rmem->size ||
 			    src->size > ddr_rmem->size - host_ddr_off) {
 				avail = host_ddr_off < ddr_rmem->size ?
 					ddr_rmem->size - host_ddr_off : 0;
 				failed_type = src->type;
@@ -2865,24 +2914,11 @@
 			paddr = ddr_rmem->base + host_ddr_off;
 			host_ddr_off += src->size;
 			break;
 
 		case BDF_MEM_REGION_TYPE:
-			ret = of_property_read_u32_index(ab->dev->of_node, "qcom,bdf-addr",
-							 ab->target_mem_mode, &addr);
-			if (!ret)
-				paddr = addr;
-			else
-				paddr = ddr_rmem->base + ab->hw_params->bdf_addr_offset;
-
-			if (paddr < ddr_rmem->base || paddr - ddr_rmem->base > ddr_rmem->size ||
-			    src->size > ddr_rmem->size - (paddr - ddr_rmem->base)) {
-				ath12k_err(ab, "BDF memory %pa+%u is outside host-ddr-mem %pa+%pa\n",
-					   &paddr, src->size, &ddr_rmem->base, &ddr_rmem->size);
-				ret = -EINVAL;
-				goto out_free;
-			}
+			paddr = bdf_paddr;
 			break;
 
 		case CALDB_MEM_REGION_TYPE:
 			/* This tree does not perform cold-boot calibration. */
 			dst->paddr = 0;
