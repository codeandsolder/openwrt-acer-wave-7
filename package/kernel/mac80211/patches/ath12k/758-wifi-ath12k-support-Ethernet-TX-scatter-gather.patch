 static void
+ath12k_wifi7_hal_tx_ext_set_buffer(struct hal_tx_msdu_ext_buffer *buf,
+				   dma_addr_t addr, unsigned int len)
+{
+	buf->info0 = le32_encode_bits(lower_32_bits(addr),
+				      HAL_TX_MSDU_EXT_INFO0_BUF_PTR_LO);
+	buf->info1 = le32_encode_bits(upper_32_bits(addr),
+				      HAL_TX_MSDU_EXT_INFO1_BUF_PTR_HI) |
+		     le32_encode_bits(len, HAL_TX_MSDU_EXT_INFO1_BUF_LEN);
+}
+
+static void
 ath12k_wifi7_hal_tx_cmd_ext_desc_setup(struct hal_tx_msdu_ext_desc *tcl_ext_cmd,
-				       struct hal_tx_info *ti)
+				     struct hal_tx_info *ti, bool override)
 {
-	tcl_ext_cmd->info0 = le32_encode_bits(ti->paddr,
-					      HAL_TX_MSDU_EXT_INFO0_BUF_PTR_LO);
-	tcl_ext_cmd->info1 = le32_encode_bits(upper_32_bits(ti->paddr),
-					      HAL_TX_MSDU_EXT_INFO1_BUF_PTR_HI) |
-			       le32_encode_bits(ti->data_len,
-						HAL_TX_MSDU_EXT_INFO1_BUF_LEN);
-
-	tcl_ext_cmd->info1 |= le32_encode_bits(1, HAL_TX_MSDU_EXT_INFO1_EXTN_OVERRIDE) |
-				le32_encode_bits(ti->encap_type,
-						 HAL_TX_MSDU_EXT_INFO1_ENCAP_TYPE) |
-				le32_encode_bits(ti->encrypt_type,
-						 HAL_TX_MSDU_EXT_INFO1_ENCRYPT_TYPE);
+	BUILD_BUG_ON(sizeof(*tcl_ext_cmd) != 72);
+	ath12k_wifi7_hal_tx_ext_set_buffer(&tcl_ext_cmd->buf[0], ti->paddr,
+					   ti->data_len);
+
+	if (override)
+		tcl_ext_cmd->buf[0].info1 |=
+			le32_encode_bits(1, HAL_TX_MSDU_EXT_INFO1_EXTN_OVERRIDE) |
+			le32_encode_bits(ti->encap_type, HAL_TX_MSDU_EXT_INFO1_ENCAP_TYPE) |
+			le32_encode_bits(ti->encrypt_type, HAL_TX_MSDU_EXT_INFO1_ENCRYPT_TYPE);
+}
+
+/* Only the documented six-buffer Ethernet extension layout is enabled.
+ * Other layouts are linearized before any packet or DMA mutation.
+ */
+static bool ath12k_wifi7_tx_sg_eligible(struct ath12k_dp *dp,
+					struct ath12k_dp_vif *dp_vif,
+					struct sk_buff *skb)
+{
+	unsigned int i, nr = skb_shinfo(skb)->nr_frags;
+
+	if (!dp->hw_params->supports_tx_sg || dp->hw_params->iova_mask ||
+	    test_bit(ATH12K_FLAG_RAW_MODE, &dp->ab->dev_flags) ||
+	    !(ATH12K_SKB_CB(skb)->flags & ATH12K_SKB_HW_80211_ENCAP) ||
+	    dp_vif->tx_encap_type != HAL_TCL_ENCAP_TYPE_ETHERNET ||
+	    skb_has_frag_list(skb) || !nr || nr > ATH12K_TX_EXT_MAX_FRAGS ||
+	    skb_headlen(skb) < ETH_HLEN || skb_headlen(skb) > U16_MAX)
+		return false;
+
+	for (i = 0; i < nr; i++) {
+		unsigned int len = skb_frag_size(&skb_shinfo(skb)->frags[i]);
+
+		if (!len || len > U16_MAX)
+			return false;
+	}
+
+	return true;
 }
 
