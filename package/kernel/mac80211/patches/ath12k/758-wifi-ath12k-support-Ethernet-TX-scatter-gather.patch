+/* The skb and its fragment layout are immutable from mapping to retirement.
+ * nr_frags is the number of successful page mappings, not an address sentinel.
+ */
+void ath12k_dp_tx_unmap_payload(struct ath12k_dp *dp, struct sk_buff *skb,
+				struct sk_buff *ext, unsigned int nr_frags)
+{
+	unsigned int i;
+
+	for (i = 0; i < nr_frags; i++)
+		dma_unmap_page(dp->dev, ATH12K_TX_EXT_CB(ext)->frags[i],
+			       skb_frag_size(&skb_shinfo(skb)->frags[i]),
+			       DMA_TO_DEVICE);
+
+	dma_unmap_single(dp->dev, ATH12K_SKB_CB(skb)->paddr,
+			 skb_headlen(skb), DMA_TO_DEVICE);
+}
+EXPORT_SYMBOL(ath12k_dp_tx_unmap_payload);
+
+void ath12k_dp_tx_unmap(struct ath12k_dp *dp, struct sk_buff *skb,
+			struct sk_buff *ext)
+{
+	if (ext)
+		dma_unmap_single(dp->dev, ATH12K_TX_EXT_CB(ext)->paddr,
+				 ext->len, DMA_TO_DEVICE);
+
+	ath12k_dp_tx_unmap_payload(dp, skb, ext, skb_shinfo(skb)->nr_frags);
+	dev_kfree_skb_any(ext);
+}
+EXPORT_SYMBOL(ath12k_dp_tx_unmap);
