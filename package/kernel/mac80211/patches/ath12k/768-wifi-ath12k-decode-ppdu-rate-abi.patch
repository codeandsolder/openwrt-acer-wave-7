--- a/drivers/net/wireless/ath/ath12k/dp_htt.h
+++ b/drivers/net/wireless/ath/ath12k/dp_htt.h
@@ -1101,6 +1101,8 @@
 	HTT_PPDU_STATS_BANDWIDTH_80MHZ  = 4,
 	HTT_PPDU_STATS_BANDWIDTH_160MHZ = 5, /* includes 80+80 */
 	HTT_PPDU_STATS_BANDWIDTH_DYN    = 6,
+	HTT_PPDU_STATS_BANDWIDTH_DYN_PATTERNS = 7,
+	HTT_PPDU_STATS_BANDWIDTH_320MHZ = 8,
 };
 
 #define HTT_PPDU_STATS_CMN_FLAGS_FRAME_TYPE_M	GENMASK(7, 0)
@@ -1135,6 +1137,33 @@
 
 #define HTT_PPDU_STATS_USER_RATE_INFO0_USER_POS_M	GENMASK(3, 0)
 #define HTT_PPDU_STATS_USER_RATE_INFO0_MU_GROUP_ID_M	GENMASK(11, 4)
+#define HTT_PPDU_STATS_USER_RATE_INFO0_RU_FORMAT_M	GENMASK(15, 12)
+
