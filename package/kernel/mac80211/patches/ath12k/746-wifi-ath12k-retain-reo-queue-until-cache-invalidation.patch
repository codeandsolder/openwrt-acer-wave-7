+void ath12k_dp_reo_flush_done(struct ath12k_dp *dp, void *ctx,
+			     enum hal_reo_cmd_status status)
+{
+	struct ath12k_reo_queue *queue = ctx;
+
+	spin_lock_bh(&dp->reo_queue_lock);
+	/* Stop leaves all remaining owners for the quiesced cleanup path. */
+	if (dp->reo_retire_stopped)
+		goto out;
+	if (WARN_ON_ONCE(queue->state != ATH12K_REO_QUEUE_FLUSH_INFLIGHT))
+		goto out;
+
+	/* Only a successful invalidation transfers ownership back to software. */
+	if (status == HAL_REO_CMD_SUCCESS) {
+		list_del(&queue->list);
+		ath12k_dp_rx_tid_cleanup(dp->ab, &queue->qbuf);
+		kfree(queue);
+	} else {
+		dev_warn_ratelimited(dp->ab->dev,
+				     "REO queue flush failed: tid %u status %d\n",
+				     queue->tid, status);
+		queue->state = ATH12K_REO_QUEUE_FLUSH_PENDING;
+		queue->retry_at = jiffies +
+			msecs_to_jiffies(ATH12K_DP_RX_REO_RETRY_MS);
+		schedule_delayed_work(&dp->reo_retire_work,
+				      msecs_to_jiffies(ATH12K_DP_RX_REO_RETRY_MS));
+	}
+out:
+	spin_unlock_bh(&dp->reo_queue_lock);
+}
+EXPORT_SYMBOL(ath12k_dp_reo_flush_done);
 
