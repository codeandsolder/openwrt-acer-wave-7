 struct ath12k_pdev_mon_stats {
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp.c
@@ -23,6 +23,8 @@
 	struct napi_struct *napi = &irq_grp->napi;
 	int grp_id = irq_grp->grp_id;
 	int work_done = 0;
+	int poll_budget = budget;
+	bool tx_more = false;
 	int i = 0, j;
 	int tot_work_done = 0;
 	enum dp_monitor_mode monitor_mode;
@@ -32,8 +34,13 @@
 	while (tx_mask) {
 		i = fls(tx_mask) - 1;
 		tx_mask ^= BIT(i);
-		ath12k_wifi7_dp_tx_completion_handler(dp, i);
+		tx_more |= ath12k_wifi7_dp_tx_completion_handler(dp, i,
+							      budget ?: NAPI_POLL_WEIGHT);
 	}
+
+	/* A zero-budget poll may reap TX but must not consume RX. */
+	if (!budget)
+		return 0;
 
 	if (dp->hw_params->ring_mask->rx_err[grp_id]) {
 		work_done = ath12k_wifi7_dp_rx_process_err(dp, napi, budget);
@@ -138,7 +145,7 @@
 	/* TODO: Implement handler for other interrupts */
 
 done:
-	return tot_work_done;
+	return tx_more ? poll_budget : tot_work_done;
 }
 
