-	while (ATH12K_TX_COMPL_NEXT(ab, tx_ring->tx_status_head) !=
-	       tx_ring->tx_status_tail) {
+	while (count < limit) {
 		desc = ath12k_hal_srng_dst_get_next_entry(ab, status_ring);
 		if (!desc)
 			break;
 
-		memcpy(&tx_ring->tx_status[tx_ring->tx_status_head],
-		       desc, sizeof(*desc));
-		tx_ring->tx_status_head =
-			ATH12K_TX_COMPL_NEXT(ab, tx_ring->tx_status_head);
-	}
-
-	if (ath12k_hal_srng_dst_peek(ab, status_ring) &&
-	    (ATH12K_TX_COMPL_NEXT(ab, tx_ring->tx_status_head) ==
-	     tx_ring->tx_status_tail)) {
-		/* TODO: Process pending tx_status messages when kfifo_is_full() */
-		ath12k_warn(ab, "Unable to process some of the tx_status ring desc because status_fifo is full\n");
+		memcpy(&batch[count++], desc, sizeof(*batch));
 	}
 
 	ath12k_hal_srng_access_end(ab, status_ring);
-
 	spin_unlock_bh(&status_ring->lock);
 
-	while (ATH12K_TX_COMPL_NEXT(ab, tx_ring->tx_status_tail) !=
-	       tx_ring->tx_status_head) {
-		struct hal_wbm_completion_ring_tx *tx_status;
-		struct hal_tx_status ts = {};
-		u8 release_status;
-		u32 desc_id;
-
-		tx_ring->tx_status_tail =
-			ATH12K_TX_COMPL_NEXT(ab, tx_ring->tx_status_tail);
-		tx_status = &tx_ring->tx_status[tx_ring->tx_status_tail];
-		ath12k_wifi7_dp_tx_status_parse(tx_status, &ts);
-		/* FW and TQM use the same four-bit field in the WBM entry. */
-		release_status = le32_get_bits(tx_status->info0,
-					       HAL_WBM_COMPL_TX_INFO0_TQM_RELEASE_REASON);
-		if (!ath12k_wifi7_tx_completion_is_release(dp, stats,
-							   ts.buf_rel_source,
-							   release_status))
-			continue;
-
-		guard(rcu)();
-
-		if (le32_get_bits(tx_status->info0, HAL_WBM_COMPL_TX_INFO0_CC_DONE)) {
-			/* HW done cookie conversion */
-			desc_va = ((u64)le32_to_cpu(tx_status->buf_va_hi) << 32 |
-				   le32_to_cpu(tx_status->buf_va_lo));
-			tx_desc = (struct ath12k_tx_desc_info *)((unsigned long)desc_va);
-		} else {
-			/* SW does cookie conversion to VA */
-			desc_id = le32_get_bits(tx_status->buf_va_hi,
-						BUFFER_ADDR_INFO1_SW_COOKIE);
-
-			tx_desc = ath12k_dp_get_tx_desc(dp, desc_id);
-		}
-		if (!tx_desc) {
-			ath12k_warn(ab, "unable to retrieve tx_desc!");
-			continue;
-		}
-
-		dp_pdev = ath12k_dp_tx_take_completed(dp, tx_desc, &desc_params);
-		if (!dp_pdev) {
-			ath12k_warn(ab, "TX completion without a live descriptor owner\n");
-			continue;
-		}
-
-		ath12k_wifi7_tx_retire(dp_pdev, &desc_params,
-				       tx_ring->tcl_data_ring_id);
-
-		if (!rcu_dereference(ab->pdevs_active[dp_pdev->mac_id]) ||
-		    !ATH12K_SKB_CB(desc_params.skb)->vif) {
-			ieee80211_free_txskb(ath12k_pdev_dp_to_hw(dp_pdev),
-					     desc_params.skb);
-		} else if (ts.buf_rel_source == HAL_WBM_REL_SRC_MODULE_FW) {
-			ath12k_dp_tx_process_htt_tx_complete(dp_pdev, tx_status,
-							     &desc_params, release_status);
-		} else if (release_status >= MAX_TQM_RELEASE_REASON) {
-			ieee80211_free_txskb(ath12k_pdev_dp_to_hw(dp_pdev),
-					     desc_params.skb);
-		} else {
-			ath12k_wifi7_dp_tx_complete_msdu(dp_pdev, &desc_params, &ts);
-		}
-
-		/* The flush barrier includes DMA unmap and mac80211 status. */
-		if (atomic_dec_and_test(&dp_pdev->num_tx_pending))
-			wake_up(&dp_pdev->tx_empty_waitq);
-	}
+	return count;
+}
+
+/* Return true on reaching the TX work limit; NAPI must then repoll even
+ * when RX has used less than its budget. The hardware ring retains any
+ * unconsumed entries, so no full-size software shadow is needed.
+ */
+bool ath12k_wifi7_dp_tx_completion_handler(struct ath12k_dp *dp, int ring_id,
+					   unsigned int budget)
+{
+	/* Half a normal NAPI budget is a 1 KiB batch of 32-byte WBM entries. */
+	struct hal_wbm_completion_ring_tx batch[NAPI_POLL_WEIGHT / 2];
+	struct dp_tx_ring *tx_ring = &dp->tx_ring[ring_id];
+	struct hal_srng *status_ring =
+		&dp->hal->srng_list[tx_ring->tcl_comp_ring.ring_id];
+	unsigned int count, limit, i;
+
+	while (budget) {
+		limit = min_t(unsigned int, budget, ARRAY_SIZE(batch));
+		count = ath12k_wifi7_dp_tx_read_batch(dp, status_ring, batch,
+						      limit);
+
+		for (i = 0; i < count; i++)
+			ath12k_wifi7_dp_tx_complete_record(dp, tx_ring, &batch[i]);
+
+		budget -= count;
+		if (count < limit)
+			return false;
+	}
+
+	return true;
 }
 
