+			      struct hal_wbm_completion_ring_tx *batch,
+			      unsigned int limit)
+{
+	struct ath12k_base *ab = dp->ab;
+	unsigned int count = 0;
+	void *desc;
+
 	spin_lock_bh(&status_ring->lock);
-
