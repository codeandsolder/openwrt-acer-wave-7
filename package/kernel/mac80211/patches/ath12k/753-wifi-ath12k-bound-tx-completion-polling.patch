-void ath12k_wifi7_dp_tx_completion_handler(struct ath12k_dp *dp, int ring_id)
+static void
+ath12k_wifi7_dp_tx_complete_record(struct ath12k_dp *dp,
+				   struct dp_tx_ring *tx_ring,
+				   struct hal_wbm_completion_ring_tx *tx_status)
 {
 	struct ath12k_base *ab = dp->ab;
-	struct ath12k_pdev_dp *dp_pdev;
-	int hal_ring_id = dp->tx_ring[ring_id].tcl_comp_ring.ring_id;
-	struct hal_srng *status_ring = &dp->hal->srng_list[hal_ring_id];
-	struct ath12k_tx_desc_info *tx_desc = NULL;
-	struct ath12k_tx_desc_params desc_params;
-	struct dp_tx_ring *tx_ring = &dp->tx_ring[ring_id];
 	struct ath12k_tx_completion_stats *stats =
 		&dp->device_stats.tx_completion[tx_ring->tcl_data_ring_id];
-	struct hal_wbm_release_ring *desc;
+	struct ath12k_tx_desc_params desc_params;
+	struct ath12k_tx_desc_info *tx_desc;
+	struct ath12k_pdev_dp *dp_pdev;
+	struct hal_tx_status ts = {};
+	u8 release_status;
+	u32 desc_id;
 	u64 desc_va;
 
+	ath12k_wifi7_dp_tx_status_parse(tx_status, &ts);
+	/* FW and TQM use the same four-bit field in the WBM entry. */
+	release_status = le32_get_bits(tx_status->info0,
+				       HAL_WBM_COMPL_TX_INFO0_TQM_RELEASE_REASON);
+	if (!ath12k_wifi7_tx_completion_is_release(dp, stats,
+						   ts.buf_rel_source,
+						   release_status))
+		return;
+
+	guard(rcu)();
+
+	if (le32_get_bits(tx_status->info0, HAL_WBM_COMPL_TX_INFO0_CC_DONE)) {
+		/* HW done cookie conversion */
+		desc_va = ((u64)le32_to_cpu(tx_status->buf_va_hi) << 32 |
+			   le32_to_cpu(tx_status->buf_va_lo));
+		tx_desc = (struct ath12k_tx_desc_info *)((unsigned long)desc_va);
+	} else {
+		/* SW does cookie conversion to VA */
+		desc_id = le32_get_bits(tx_status->buf_va_hi,
+					BUFFER_ADDR_INFO1_SW_COOKIE);
+
+		tx_desc = ath12k_dp_get_tx_desc(dp, desc_id);
+	}
+	if (!tx_desc) {
+		ath12k_warn(ab, "unable to retrieve tx_desc!");
+		return;
+	}
+
+	dp_pdev = ath12k_dp_tx_take_completed(dp, tx_desc, &desc_params);
+	if (!dp_pdev) {
+		ath12k_warn(ab, "TX completion without a live descriptor owner\n");
+		return;
+	}
+
+	ath12k_wifi7_tx_retire(dp_pdev, &desc_params,
+			       tx_ring->tcl_data_ring_id);
+
+	if (!rcu_dereference(ab->pdevs_active[dp_pdev->mac_id]) ||
+	    !ATH12K_SKB_CB(desc_params.skb)->vif) {
+		ieee80211_free_txskb(ath12k_pdev_dp_to_hw(dp_pdev),
+				     desc_params.skb);
+	} else if (ts.buf_rel_source == HAL_WBM_REL_SRC_MODULE_FW) {
+		ath12k_dp_tx_process_htt_tx_complete(dp_pdev, tx_status,
+						     &desc_params, release_status);
+	} else if (release_status >= MAX_TQM_RELEASE_REASON) {
+		ieee80211_free_txskb(ath12k_pdev_dp_to_hw(dp_pdev),
+				     desc_params.skb);
+	} else {
+		ath12k_wifi7_dp_tx_complete_msdu(dp_pdev, &desc_params, &ts);
+	}
+
+	/* The flush barrier includes DMA unmap and mac80211 status. */
+	if (atomic_dec_and_test(&dp_pdev->num_tx_pending))
+		wake_up(&dp_pdev->tx_empty_waitq);
+}
