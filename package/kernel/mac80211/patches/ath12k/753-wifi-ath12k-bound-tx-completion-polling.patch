From: Wave7 development <codeandsolder@gmail.com>
Subject: [PATCH] wifi: ath12k: bound TX completion polling

Consume completion records in small private batches, releasing the HAL
ring lock before DMA retirement and mac80211 status reporting. Keep
unconsumed records in the hardware ring rather than allocating a second
full-size ring per TX queue. Repoll NAPI on reaching the TX work limit,
even if RX has not consumed its budget. Service all mapped TX rings and
preserve the RX budget; zero-budget polls must not process RX.

---
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -1180,7 +1180,6 @@
 static void ath12k_dp_cleanup(struct ath12k_base *ab)
 {
 	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
-	int i;
 
 	ath12k_dp_link_peer_rhash_tbl_destroy(dp);
 
@@ -1197,11 +1196,6 @@
 	ath12k_dp_srng_common_cleanup(ab);
 
 	ath12k_dp_rx_reo_cmd_cleanup(ab);
-
-	for (i = 0; i < ab->hw_params->max_tx_ring; i++) {
-		kfree(dp->tx_ring[i].tx_status);
-		dp->tx_ring[i].tx_status = NULL;
-	}
 
 	ath12k_dp_rx_free(ab);
 	/* Deinit any SOC level resource */
@@ -1555,7 +1549,6 @@
 {
 	struct ath12k_dp *dp;
 	struct hal_srng *srng = NULL;
-	size_t size = 0;
 	u32 n_link_desc = 0;
 	int ret;
 	int i;
@@ -1613,29 +1606,14 @@
 	if (ret)
 		goto fail_dp_bank_profiles_cleanup;
 
-	size = ab->hal.hal_wbm_release_ring_tx_size *
-	       DP_TX_COMP_RING_SIZE(ab);
-
 	ret = ath12k_dp_reoq_lut_setup(ab);
 	if (ret) {
 		ath12k_warn(ab, "failed to setup reoq table %d\n", ret);
 		goto fail_cmn_srng_cleanup;
 	}
 
-	for (i = 0; i < ab->hw_params->max_tx_ring; i++) {
+	for (i = 0; i < ab->hw_params->max_tx_ring; i++)
 		dp->tx_ring[i].tcl_data_ring_id = i;
-
-		dp->tx_ring[i].tx_status_head = 0;
-		dp->tx_ring[i].tx_status_tail = DP_TX_COMP_RING_SIZE(ab) - 1;
-		dp->tx_ring[i].tx_status = kmalloc(size, GFP_KERNEL);
-		if (!dp->tx_ring[i].tx_status) {
-			ret = -ENOMEM;
-			/* FIXME: The allocated tx status is not freed
-			 * properly here
-			 */
-			goto fail_cmn_reoq_cleanup;
-		}
-	}
 
 	for (i = 0; i < HAL_DSCP_TID_MAP_TBL_NUM_ENTRIES_MAX; i++)
 		ath12k_hal_tx_set_dscp_tid_map(ab, i);
@@ -1652,7 +1630,6 @@
 fail_dp_rx_free:
 	ath12k_dp_rx_free(ab);
 
-fail_cmn_reoq_cleanup:
 	ath12k_dp_reoq_lut_cleanup(ab);
 
 fail_cmn_srng_cleanup:
--- a/drivers/net/wireless/ath/ath12k/dp.h
+++ b/drivers/net/wireless/ath/ath12k/dp.h
@@ -52,15 +52,10 @@
 	int bufs_max;
 };
 
-#define ATH12K_TX_COMPL_NEXT(ab, x)	(((x) + 1) % DP_TX_COMP_RING_SIZE(ab))
-
 struct dp_tx_ring {
 	u8 tcl_data_ring_id;
 	struct dp_srng tcl_data_ring;
 	struct dp_srng tcl_comp_ring;
-	struct hal_wbm_completion_ring_tx *tx_status;
-	int tx_status_head;
-	int tx_status_tail;
