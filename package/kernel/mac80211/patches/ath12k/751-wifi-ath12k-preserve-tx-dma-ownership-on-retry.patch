From: Wave7 development <codeandsolder@gmail.com>
Subject: [PATCH] wifi: ath12k: preserve TX DMA and descriptor ownership on retry

Prepare and map the packet once before trying the available TCL rings.
Unwind the original payload mapping independently from the optional
extension mapping, and use the extension skb rather than a DMA address
as the ownership marker. Keep unpublished descriptors empty and clear
both skb pointers when returning them to the free pool.

Align in place without freeing the skb still owned by the caller.

---
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -1092,7 +1092,7 @@
 				continue;
 
 			skb_cb = ATH12K_SKB_CB(skb);
-			if (skb_cb->paddr_ext_desc) {
+			if (tx_desc_info->skb_ext_desc) {
 				dma_unmap_single(ab->dev,
 						 skb_cb->paddr_ext_desc,
 						 tx_desc_info->skb_ext_desc->len,
--- a/drivers/net/wireless/ath/ath12k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_tx.c
@@ -87,6 +87,7 @@
 				u8 pool_id)
 {
 	spin_lock_bh(&dp->tx_desc_lock[pool_id]);
+	tx_desc->skb = NULL;
 	tx_desc->skb_ext_desc = NULL;
 	list_move_tail(&tx_desc->list, &dp->tx_desc_free_list[pool_id]);
 	spin_unlock_bh(&dp->tx_desc_lock[pool_id]);
@@ -146,40 +147,40 @@
 	}
 }
 
-int ath12k_dp_tx_align_payload(struct ath12k_dp *dp, struct sk_buff **pskb)
+int ath12k_dp_tx_align_payload(struct ath12k_dp *dp, struct sk_buff *skb)
 {
 	u32 iova_mask = dp->hw_params->iova_mask;
-	unsigned long offset, delta1, delta2;
-	struct sk_buff *skb2, *skb = *pskb;
-	unsigned int headroom = skb_headroom(skb);
-	int tailroom = skb_tailroom(skb);
-	int ret = 0;
-
-	offset = (unsigned long)skb->data & iova_mask;
-	delta1 = offset;
-	delta2 = iova_mask - offset + 1;
-
-	if (headroom >= delta1) {
-		ath12k_dp_tx_move_payload(skb, delta1, true);
-	} else if (tailroom >= delta2) {
-		ath12k_dp_tx_move_payload(skb, delta2, false);
+	unsigned long offset = (unsigned long)skb->data & iova_mask;
+	unsigned long tail_delta = iova_mask - offset + 1;
+	int ret;
+
+	if (!offset)
+		return 0;
+
+	/* Preserve the caller's skb identity, including on error. Ensure the
+	 * data is writable before moving it in either direction.
+	 */
+	if (skb_cloned(skb) ||
+	    (skb_headroom(skb) < offset && skb_tailroom(skb) < tail_delta)) {
+		ret = skb_cow(skb, iova_mask);
+		if (ret)
+			return ret;
+
+		offset = (unsigned long)skb->data & iova_mask;
+		if (!offset)
+			return 0;
+		tail_delta = iova_mask - offset + 1;
+	}
+
+	if (skb_headroom(skb) >= offset) {
+		ath12k_dp_tx_move_payload(skb, offset, true);
+		skb_headers_offset_update(skb, -(int)offset);
 	} else {
-		skb2 = skb_realloc_headroom(skb, iova_mask);
-		if (!skb2) {
-			ret = -ENOMEM;
-			goto out;
-		}
-
-		dev_kfree_skb_any(skb);
-
-		offset = (unsigned long)skb2->data & iova_mask;
-		if (offset)
-			ath12k_dp_tx_move_payload(skb2, offset, true);
-		*pskb = skb2;
-	}
-
-out:
-	return ret;
+		ath12k_dp_tx_move_payload(skb, tail_delta, false);
+		skb_headers_offset_update(skb, tail_delta);
+	}
+
+	return 0;
 }
 EXPORT_SYMBOL(ath12k_dp_tx_align_payload);
 
@@ -195,7 +196,7 @@
 	skb_cb = ATH12K_SKB_CB(msdu);
 
 	dma_unmap_single(dp->dev, skb_cb->paddr, msdu->len, DMA_TO_DEVICE);
-	if (skb_cb->paddr_ext_desc) {
+	if (desc_params->skb_ext_desc) {
 		dma_unmap_single(dp->dev, skb_cb->paddr_ext_desc,
 				 desc_params->skb_ext_desc->len, DMA_TO_DEVICE);
 		dev_kfree_skb_any(desc_params->skb_ext_desc);
--- a/drivers/net/wireless/ath/ath12k/dp_tx.h
+++ b/drivers/net/wireless/ath/ath12k/dp_tx.h
@@ -20,7 +20,7 @@
 void ath12k_dp_tx_encap_nwifi(struct sk_buff *skb);
 u8 ath12k_dp_tx_get_tid(struct sk_buff *skb);
