 				 params->skb_ext_desc->len, DMA_TO_DEVICE);
 		dev_kfree_skb_any(params->skb_ext_desc);
 	}
@@ -862,6 +862,7 @@
 
 	ath12k_wifi7_tx_retire(dp_pdev, &desc_params,
 			       tx_ring->tcl_data_ring_id);
+	ath12k_tx_aql_complete(ath12k_pdev_dp_to_hw(dp_pdev), desc_params.skb, true);
 
 	if (!rcu_dereference(ab->pdevs_active[dp_pdev->mac_id]) ||
 	    !ATH12K_SKB_CB(desc_params.skb)->vif) {
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -1094,24 +1094,24 @@
 			skb_cb = ATH12K_SKB_CB(skb);
 			if (tx_desc_info->skb_ext_desc) {
 				dma_unmap_single(ab->dev,
-						 skb_cb->paddr_ext_desc,
+						 ATH12K_SKB_CB(tx_desc_info->skb_ext_desc)->paddr,
 						 tx_desc_info->skb_ext_desc->len,
 						 DMA_TO_DEVICE);
 				dev_kfree_skb_any(tx_desc_info->skb_ext_desc);
 			}
 
-			/* if we are unregistering, hw would've been destroyed and
-			 * ar is no longer valid.
-			 */
-			if (!(test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags))) {
+			dma_unmap_single(ab->dev, skb_cb->paddr,
+					 skb->len, DMA_TO_DEVICE);
+			/* During unregister the hw and ar may already be gone. */
+			if (!test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags)) {
 				ar = skb_cb->ar;
+				ath12k_tx_aql_complete(ath12k_ar_to_hw(ar), skb, false);
 
 				if (atomic_dec_and_test(&ar->dp.num_tx_pending))
 					wake_up(&ar->dp.tx_empty_waitq);
+			} else {
+				ieee80211_tx_aql_put(skb_cb->aql_owner);
 			}
-
-			dma_unmap_single(ab->dev, ATH12K_SKB_CB(skb)->paddr,
-					 skb->len, DMA_TO_DEVICE);
 			dev_kfree_skb_any(skb);
 		}
 
