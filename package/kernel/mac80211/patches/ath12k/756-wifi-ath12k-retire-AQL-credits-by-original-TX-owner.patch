Subject: [PATCH] wifi: ath12k: retire AQL credits by original TX owner

Capture the original mac80211 queue owner rather than deriving it
from the completed firmware peer. Retire charges exactly once on TX
completion, failure, management cancellation and descriptor cleanup.
Charge each MLO multicast replica independently; keep the extension
descriptor DMA address in its own skb control block.

Enable AQL after the data and management paths use explicit ownership.

---
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -128,7 +128,7 @@
 	dma_addr_t paddr;
 	struct ath12k *ar;
 	struct ieee80211_vif *vif;
-	dma_addr_t paddr_ext_desc;
+	struct ieee80211_aql_owner *aql_owner;
 	u32 cipher;
 	u8 flags;
 	u8 link_id;
@@ -1360,6 +1360,25 @@
 	return (struct ath12k_skb_cb *)&IEEE80211_SKB_CB(skb)->driver_data;
 }
 
+static inline void ath12k_tx_aql_complete(struct ieee80211_hw *hw,
+					  struct sk_buff *skb, bool wake)
+{
+	struct ath12k_skb_cb *cb = ATH12K_SKB_CB(skb);
+
+	if (!ieee80211_info_get_tx_time_est(IEEE80211_SKB_CB(skb)))
+		return;
+
+	ieee80211_tx_aql_complete(hw, cb->aql_owner, skb, wake);
+	cb->aql_owner = NULL;
+}
+
+static inline void ath12k_free_txskb(struct ieee80211_hw *hw,
+				     struct sk_buff *skb)
+{
+	ath12k_tx_aql_complete(hw, skb, true);
+	ieee80211_free_txskb(hw, skb);
+}
+
 static inline struct ath12k_skb_rxcb *ATH12K_SKB_RXCB(struct sk_buff *skb)
 {
 	BUILD_BUG_ON(sizeof(struct ath12k_skb_rxcb) > sizeof(skb->cb));
--- a/drivers/net/wireless/ath/ath12k/wifi7/hw.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
@@ -1026,13 +1026,14 @@
 	int ret;
 	struct ath12k_dp *tmp_dp;
 
+	link_id = u32_get_bits(info->control.flags, IEEE80211_TX_CTRL_MLO_LINK);
+	memset(skb_cb, 0, sizeof(*skb_cb));
+	skb_cb->aql_owner = ieee80211_tx_aql_get(sta, skb);
+
 	if (ahvif->vdev_type == WMI_VDEV_TYPE_MONITOR) {
-		ieee80211_free_txskb(hw, skb);
+		ath12k_free_txskb(hw, skb);
 		return;
 	}
-
-	link_id = u32_get_bits(info->control.flags, IEEE80211_TX_CTRL_MLO_LINK);
-	memset(skb_cb, 0, sizeof(*skb_cb));
 	skb_cb->vif = vif;
 
 	if (key) {
@@ -1044,7 +1045,7 @@
 	if (ieee80211_vif_is_mld(vif)) {
 		link_id = ath12k_mac_get_tx_link(sta, vif, link_id, skb, info_flags);
 		if (link_id >= IEEE80211_MLD_MAX_NUM_LINKS) {
-			ieee80211_free_txskb(hw, skb);
+			ath12k_free_txskb(hw, skb);
 			return;
 		}
 	} else {
@@ -1058,7 +1059,7 @@
 	if (!arvif || !arvif->ar) {
 		ath12k_warn(ahvif->ah, "failed to find arvif link id %u for frame transmission",
 			    link_id);
-		ieee80211_free_txskb(hw, skb);
+		ath12k_free_txskb(hw, skb);
 		return;
 	}
 
@@ -1084,7 +1085,7 @@
 		if (ret) {
 			ath12k_warn(ar->ab, "failed to queue management frame %d\n",
 				    ret);
-			ieee80211_free_txskb(hw, skb);
+			ath12k_free_txskb(hw, skb);
 		}
 		return;
 	}
@@ -1104,7 +1105,7 @@
 
 	dp_pdev = ath12k_dp_to_pdev_dp(ar->ab->dp, ar->pdev_idx);
 	if (!dp_pdev) {
-		ieee80211_free_txskb(hw, skb);
+		ath12k_free_txskb(hw, skb);
 		return;
 	}
 
@@ -1121,7 +1122,7 @@
 		ret = ath12k_wifi7_dp_tx(dp_pdev, arvif, arsta, skb, false, 0, is_mcast);
 		if (unlikely(ret)) {
 			ath12k_warn(ar->ab, "failed to transmit frame %d\n", ret);
-			ieee80211_free_txskb(ar->ah->hw, skb);
+			ath12k_free_txskb(ar->ah->hw, skb);
 			return;
 		}
 	} else {
@@ -1192,6 +1193,7 @@
 			spin_unlock_bh(&tmp_dp->dp_lock);
 
 skip_peer_find:
+			ieee80211_tx_aql_clone(hw, skb_cb->aql_owner, msdu_copied);
 			ret = ath12k_wifi7_dp_tx(tmp_dp_pdev, tmp_arvif, arsta,
 						 msdu_copied, true, mcbc_gsn, is_mcast);
 			if (unlikely(ret)) {
@@ -1209,10 +1211,11 @@
 						    ret);
 				}
 
+				ath12k_tx_aql_complete(hw, msdu_copied, true);
 				dev_kfree_skb_any(msdu_copied);
 			}
 		}
-		ieee80211_free_txskb(ar->ah->hw, skb);
+		ath12k_free_txskb(ar->ah->hw, skb);
 	}
 }
 
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp_tx.c
