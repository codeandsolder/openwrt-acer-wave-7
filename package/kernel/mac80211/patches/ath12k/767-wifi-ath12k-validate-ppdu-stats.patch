Subject: [PATCH] wifi: ath12k: validate PPDU stats before publishing them

Use all eight configured user slots and propagate errors from the TLV
callback. Discard a malformed PPDU rather than publishing its partial
statistics during eviction. Validate the linear payload bounds before
reading the header or TLVs.

Reject inverted MPDU attempt/success counts instead of wrapping a
sixteen-bit failure count. Keep the queue depth within its configured
limit and reset the depth when the queue is cleared.

---
--- a/drivers/net/wireless/ath/ath12k/dp_htt.c
+++ b/drivers/net/wireless/ath/ath12k/dp_htt.c
@@ -46,7 +46,7 @@
 {
 	int i;
 
-	for (i = 0; i < HTT_PPDU_STATS_MAX_USERS - 1; i++) {
+	for (i = 0; i < ARRAY_SIZE(ppdu_stats->user_stats); i++) {
 		if (ppdu_stats->user_stats[i].is_valid_peer_id) {
 			if (peer_id == ppdu_stats->user_stats[i].peer_id)
 				return i;
@@ -154,7 +154,7 @@
 	const struct htt_tlv *tlv;
 	const void *begin = ptr;
 	u16 tlv_tag, tlv_len;
-	int ret = -EINVAL;
+	int ret;
 
 	while (len > 0) {
 		if (len < sizeof(*tlv)) {
@@ -174,7 +174,7 @@
 			return -EINVAL;
 		}
 		ret = iter(ab, tlv_tag, tlv_len, ptr, data);
-		if (ret == -ENOMEM)
+		if (ret)
 			return ret;
 
 		ptr += tlv_len;
@@ -183,6 +183,20 @@
 	return 0;
 }
 
+static bool
+ath12k_htt_ppdu_failed_mpdus(const struct htt_ppdu_stats_usr_cmpltn_cmn *completion,
+			     u16 *failed)
+{
+	u16 tried = le16_to_cpu(completion->mpdu_tried);
+	u16 success = le16_to_cpu(completion->mpdu_success);
+
+	if (success > tried)
+		return false;
+
+	*failed = tried - success;
+	return true;
+}
+
 static void
 ath12k_update_per_peer_tx_stats(struct ath12k_pdev_dp *dp_pdev,
 				struct htt_ppdu_stats *ppdu_stats, u8 user)
@@ -203,7 +217,8 @@
 	u16 tx_retry_failed = 0, tx_retry_count = 0;
 	bool is_ampdu = false, is_ofdma;
 
-	if (!(usr_stats->tlv_flags & BIT(HTT_PPDU_STATS_TAG_USR_RATE)))
+	if (!usr_stats->is_valid_peer_id ||
+	    !(usr_stats->tlv_flags & BIT(HTT_PPDU_STATS_TAG_USR_RATE)))
 		return;
 
 	if (usr_stats->tlv_flags & BIT(HTT_PPDU_STATS_TAG_USR_COMPLTN_COMMON))
@@ -219,9 +234,10 @@
 				    HTT_PPDU_STATS_ACK_BA_INFO_TID_NUM);
 
 		if (usr_stats->tlv_flags & BIT(HTT_PPDU_STATS_TAG_USR_COMPLTN_COMMON)) {
-			tx_retry_failed =
-				__le16_to_cpu(usr_stats->cmpltn_cmn.mpdu_tried) -
-				__le16_to_cpu(usr_stats->cmpltn_cmn.mpdu_success);
+			if (!ath12k_htt_ppdu_failed_mpdus(&usr_stats->cmpltn_cmn,
+							  &tx_retry_failed))
+				ath12k_warn(ab, "Invalid PPDU MPDU counts for peer %u\n",
+					    usr_stats->peer_id);
 			tx_retry_count =
 				HTT_USR_CMPLTN_LONG_RETRY(usr_stats->cmpltn_cmn.flags) +
 				HTT_USR_CMPLTN_SHORT_RETRY(usr_stats->cmpltn_cmn.flags);
@@ -362,7 +378,7 @@
 {
 	u8 user;
 
-	for (user = 0; user < HTT_PPDU_STATS_MAX_USERS - 1; user++)
+	for (user = 0; user < ARRAY_SIZE(ppdu_stats->user_stats); user++)
 		ath12k_update_per_peer_tx_stats(dp_pdev, ppdu_stats, user);
 }
 
@@ -379,7 +395,7 @@
 				return ppdu_info;
 		}
 
-		if (dp_pdev->ppdu_stat_list_depth > HTT_PPDU_DESC_MAX_DEPTH) {
+		if (dp_pdev->ppdu_stat_list_depth >= HTT_PPDU_DESC_MAX_DEPTH) {
 			ppdu_info = list_first_entry(&dp_pdev->ppdu_stats_info,
 						     typeof(*ppdu_info), list);
 			list_del(&ppdu_info->list);
@@ -443,12 +459,15 @@
 	u8 pdev_id, pdev_idx;
 	u32 ppdu_id, len;
 
+	if (skb_headlen(skb) < sizeof(*msg))
+		return -EINVAL;
+
 	msg = (struct ath12k_htt_ppdu_stats_msg *)skb->data;
 	len = le32_get_bits(msg->info, HTT_T2H_PPDU_STATS_INFO_PAYLOAD_SIZE);
-	if (len > (skb->len - struct_size(msg, data, 0))) {
+	if (len > skb_headlen(skb) - sizeof(*msg)) {
 		ath12k_warn(ab,
-			    "HTT PPDU STATS event has unexpected payload size %u, should be smaller than %u\n",
-			    len, skb->len);
+			    "HTT PPDU STATS event has unexpected payload size %u, available %zu\n",
+			    len, skb_headlen(skb) - sizeof(*msg));
 		return -EINVAL;
 	}
 
@@ -482,19 +501,17 @@
 				     ath12k_htt_tlv_ppdu_stats_parse,
 				     (void *)ppdu_info);
 	if (ret) {
-		spin_unlock_bh(&dp_pdev->ppdu_list_lock);
 		ath12k_warn(ab, "Failed to parse tlv %d\n", ret);
-		goto exit;
+		goto discard;
 	}
 
-	if (ppdu_info->ppdu_stats.common.num_users >= HTT_PPDU_STATS_MAX_USERS) {
-		spin_unlock_bh(&dp_pdev->ppdu_list_lock);
+	if (ppdu_info->ppdu_stats.common.num_users > HTT_PPDU_STATS_MAX_USERS) {
 		ath12k_warn(ab,
-			    "HTT PPDU STATS event has unexpected num_users %u, should be smaller than %u\n",
+			    "HTT PPDU STATS event has unexpected num_users %u, should not exceed %u\n",
 			    ppdu_info->ppdu_stats.common.num_users,
 			    HTT_PPDU_STATS_MAX_USERS);
 		ret = -EINVAL;
-		goto exit;
+		goto discard;
 	}
 
 	/* back up data rate tlv for all peers */
@@ -528,6 +545,13 @@
 		}
 	}
 
+	goto unlock;
+
+discard:
+	list_del(&ppdu_info->list);
+	dp_pdev->ppdu_stat_list_depth--;
+	kfree(ppdu_info);
+unlock:
 	spin_unlock_bh(&dp_pdev->ppdu_list_lock);
 
 exit:
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -10127,6 +10127,7 @@
 		list_del(&ppdu_stats->list);
 		kfree(ppdu_stats);
 	}
+	dp_pdev->ppdu_stat_list_depth = 0;
 	spin_unlock_bh(&dp_pdev->ppdu_list_lock);
 
 	spin_lock_bh(&ar->data_lock);
