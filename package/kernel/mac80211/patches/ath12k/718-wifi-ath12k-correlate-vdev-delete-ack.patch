From: Wave 7 bring-up <noreply@example.com>
Subject: [PATCH] wifi: ath12k: correlate vdev delete acknowledgements

A per-radio completion is reused by normal and monitor vdev deletes.
A late response to a timed-out request can therefore complete a different
request on the same radio, incorrectly freeing the new vdev ID while
firmware may still own it. Track the requested ID and only signal when
firmware acknowledges that ID. Recovery still wakes waiters, but that
wake is distinguished from a real acknowledgement. Also return an error
on delete timeout rather than returning stale success.

Do not free timed-out vdev IDs; their firmware ownership is unknown.
The larger recovery/host-vdev lifetime reconciliation remains separate.

---
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -702,6 +702,9 @@
 	int last_wmi_vdev_start_status;
 	struct completion vdev_setup_done;
 	struct completion vdev_delete_done;
+	/* Guarded by data_lock; one delete request at a time per radio. */
+	int vdev_delete_pending_id;
+	bool vdev_delete_acked;
 
 	int num_peers;
 	int max_num_peers;
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -1439,30 +1439,75 @@
 	return ret;
 }
 
+/* Match firmware replies by vdev ID, not merely by the radio completion.
+ * An old reply after a timeout must never satisfy a later delete request.
+ */
+static void ath12k_mac_vdev_delete_arm(struct ath12k *ar, u32 vdev_id)
+{
+	spin_lock_bh(&ar->data_lock);
+	reinit_completion(&ar->vdev_delete_done);
+	ar->vdev_delete_pending_id = vdev_id;
+	ar->vdev_delete_acked = false;
+	spin_unlock_bh(&ar->data_lock);
+}
+
+static void ath12k_mac_vdev_delete_disarm(struct ath12k *ar)
+{
+	spin_lock_bh(&ar->data_lock);
+	ar->vdev_delete_pending_id = -1;
+	ar->vdev_delete_acked = false;
+	spin_unlock_bh(&ar->data_lock);
+}
+
+static int ath12k_mac_vdev_delete_wait(struct ath12k *ar, u32 vdev_id)
+{
+	unsigned long time_left;
+	bool acked;
+
+	time_left = wait_for_completion_timeout(&ar->vdev_delete_done,
+						ATH12K_VDEV_DELETE_TIMEOUT_HZ);
+
+	spin_lock_bh(&ar->data_lock);
+	acked = ar->vdev_delete_acked;
+	ar->vdev_delete_pending_id = -1;
+	ar->vdev_delete_acked = false;
+	spin_unlock_bh(&ar->data_lock);
+
+	if (!time_left) {
+		ath12k_warn(ar->ab, "vdev %u delete response timed out\n",
+			    vdev_id);
+		return -ETIMEDOUT;
+	}
+	if (!acked) {
+		/* Recovery unblocks the completion without a firmware ACK. */
+		ath12k_warn(ar->ab, "vdev %u delete interrupted by recovery\n",
+			    vdev_id);
+		return -ESHUTDOWN;
+	}
+	return 0;
+}
+
 static int ath12k_mac_monitor_vdev_delete(struct ath12k *ar)
 {
 	int ret;
-	unsigned long time_left;
 
 	lockdep_assert_wiphy(ath12k_ar_to_hw(ar)->wiphy);
 
 	if (!ar->monitor_vdev_created)
 		return 0;
 
-	reinit_completion(&ar->vdev_delete_done);
+	ath12k_mac_vdev_delete_arm(ar, ar->monitor_vdev_id);
 
 	ret = ath12k_wmi_vdev_delete(ar, ar->monitor_vdev_id);
 	if (ret) {
+		ath12k_mac_vdev_delete_disarm(ar);
 		ath12k_warn(ar->ab, "failed to request wmi monitor vdev %i removal: %d\n",
 			    ar->monitor_vdev_id, ret);
 		return ret;
 	}
 
-	time_left = wait_for_completion_timeout(&ar->vdev_delete_done,
-						ATH12K_VDEV_DELETE_TIMEOUT_HZ);
-	if (time_left == 0) {
-		ath12k_warn(ar->ab, "Timeout in receiving vdev delete response\n");
-	} else {
+	ret = ath12k_mac_vdev_delete_wait(ar, ar->monitor_vdev_id);
+	if (!ret) {
 		ar->allocated_vdev_map &= ~(1LL << ar->monitor_vdev_id);
 		ar->ab->free_vdev_map |= 1LL << (ar->monitor_vdev_id);
 		ath12k_dbg(ar->ab, ATH12K_DBG_MAC, "mac monitor vdev %d deleted\n",
@@ -10910,26 +10955,23 @@
 	struct ieee80211_vif *vif = ath12k_ahvif_to_vif(ahvif);
 	struct ath12k_dp_link_vif *dp_link_vif;
 	struct ath12k_base *ab = ar->ab;
-	unsigned long time_left;
 	int ret;
 
 	lockdep_assert_wiphy(ath12k_ar_to_hw(ar)->wiphy);
 
-	reinit_completion(&ar->vdev_delete_done);
+	ath12k_mac_vdev_delete_arm(ar, arvif->vdev_id);
 
 	ret = ath12k_wmi_vdev_delete(ar, arvif->vdev_id);
 	if (ret) {
+		ath12k_mac_vdev_delete_disarm(ar);
 		ath12k_warn(ab, "failed to delete WMI vdev %d: %d\n",
 			    arvif->vdev_id, ret);
 		goto err_vdev_del;
 	}
 
-	time_left = wait_for_completion_timeout(&ar->vdev_delete_done,
-						ATH12K_VDEV_DELETE_TIMEOUT_HZ);
-	if (time_left == 0) {
-		ath12k_warn(ab, "Timeout in receiving vdev delete response\n");
+	ret = ath12k_mac_vdev_delete_wait(ar, arvif->vdev_id);
+	if (ret)
 		goto err_vdev_del;
-	}
 
 	ab->free_vdev_map |= 1LL << arvif->vdev_id;
 	ar->allocated_vdev_map &= ~(1LL << arvif->vdev_id);
@@ -15107,6 +15149,7 @@
 
 	init_completion(&ar->vdev_setup_done);
 	init_completion(&ar->vdev_delete_done);
+	ar->vdev_delete_pending_id = -1;
 	init_completion(&ar->peer_assoc_done);
 	init_completion(&ar->peer_delete_done);
 	init_completion(&ar->install_key_done);
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -7104,6 +7104,7 @@
 {
 	struct ath12k *ar;
 	u32 vdev_id = 0;
+	bool matched;
 
 	if (ath12k_pull_vdev_del_resp_ev(ab, skb, &vdev_id) != 0) {
 		ath12k_warn(ab, "failed to extract vdev delete resp");
@@ -7119,12 +7120,22 @@
 		return;
 	}
 
-	complete(&ar->vdev_delete_done);
+	spin_lock_bh(&ar->data_lock);
+	matched = ar->vdev_delete_pending_id == vdev_id;
+	if (matched) {
+		ar->vdev_delete_acked = true;
+		complete(&ar->vdev_delete_done);
+	}
+	spin_unlock_bh(&ar->data_lock);
 
 	rcu_read_unlock();
 
-	ath12k_dbg(ab, ATH12K_DBG_WMI, "vdev delete resp for vdev id %d\n",
-		   vdev_id);
+	if (!matched)
+		ath12k_warn(ab, "unexpected vdev delete response for id %u\n",
+			    vdev_id);
+	else
+		ath12k_dbg(ab, ATH12K_DBG_WMI, "vdev delete resp for vdev id %d\n",
+			   vdev_id);
 }
 
 static const char *ath12k_wmi_vdev_resp_print(u32 vdev_resp_status)
