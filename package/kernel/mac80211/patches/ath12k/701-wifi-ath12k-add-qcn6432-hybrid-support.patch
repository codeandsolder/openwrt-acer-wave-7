+static void ath12k_pcic_free_ext_irq(struct ath12k_base *ab)
+{
+	int i, j;
+
+	for (i = 0; i < ATH12K_EXT_IRQ_GRP_NUM_MAX; i++) {
+		struct ath12k_ext_irq_grp *irq_grp = &ab->ext_irq_grp[i];
+
+		for (j = 0; j < irq_grp->num_irq; j++) {
+			int irq_idx = irq_grp->irqs[j];
+
+			if (ab->irq_num[irq_idx] > 0) {
+				if (ab->hif.bus == ATH12K_BUS_HYBRID)
+					devm_free_irq(ab->dev, ab->irq_num[irq_idx], irq_grp);
+				else
+					free_irq(ab->irq_num[irq_idx], irq_grp);
+				ab->irq_num[irq_idx] = 0;
+			}
+		}
+
+		if (irq_grp->napi_ndev) {
+			netif_napi_del(&irq_grp->napi);
+			free_netdev(irq_grp->napi_ndev);
+			irq_grp->napi_ndev = NULL;
+		}
+		irq_grp->num_irq = 0;
+	}
+}
+
+void ath12k_pcic_free_irq(struct ath12k_base *ab)
+{
+	int i, irq_idx;
+
+	for (i = 0; i < ab->hw_params->ce_count; i++) {
+		if (ath12k_ce_get_attr_flags(ab, i) & CE_ATTR_DIS_INTR)
+			continue;
+
+		irq_idx = ATH12K_PCI_IRQ_CE0_OFFSET + i;
+		if (ab->irq_num[irq_idx] > 0) {
+			if (ab->hif.bus == ATH12K_BUS_HYBRID)
+				devm_free_irq(ab->dev, ab->irq_num[irq_idx],
+					      &ab->ce.ce_pipe[i]);
+			else
+				free_irq(ab->irq_num[irq_idx], &ab->ce.ce_pipe[i]);
+			ab->irq_num[irq_idx] = 0;
+		}
+	}
+
+	ath12k_pcic_free_ext_irq(ab);
+}
