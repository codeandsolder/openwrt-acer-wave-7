+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/* Management TX lifetime metadata, independent of payload tracing. */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM ath12k_mgmt
+
+#if !defined(ATH12K_MGMT_TRACE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define ATH12K_MGMT_TRACE_H
+
+#include <linux/tracepoint.h>
+#include <linux/unaligned.h>
+#include "core.h"
+
+TRACE_EVENT(ath12k_mgmt_lifetime,
+	TP_PROTO(struct ath12k *ar, const char *phase, struct sk_buff *skb,
+		 int desc, int vdev, s64 result, u32 freq, bool agnostic),
+	TP_ARGS(ar, phase, skb, desc, vdev, result, freq, agnostic),
+	TP_STRUCT__entry(
+		__string(device, dev_name(ar->ab->dev))
+		__string(wiphy, wiphy_name(ath12k_ar_to_hw(ar)->wiphy))
+		__string(phase, phase)
+		__field(u32, pdev)
+		__field(int, desc)
+		__field(int, vdev)
+		__field(s64, result)
+		__field(u32, freq)
+		__field(bool, agnostic)
+		__field(int, ack_id)
+		__field(int, link)
+		__field(u16, fc)
+		__field(u16, seq)
+		__field(u32, len)
+		__field(int, pending)
+	),
+	TP_fast_assign(
+		struct ieee80211_tx_info *info = skb ? IEEE80211_SKB_CB(skb) : NULL;
+
+		__assign_str(device);
+		__assign_str(wiphy);
+		__assign_str(phase);
+		__entry->pdev = ar->pdev->pdev_id;
+		__entry->desc = desc;
+		__entry->vdev = vdev;
+		__entry->result = result;
+		__entry->freq = freq;
+		__entry->agnostic = agnostic;
+		__entry->ack_id = info && info->status_data_idr ? info->status_data : -1;
+		__entry->link = skb ? ATH12K_SKB_CB(skb)->link_id : -1;
+		__entry->fc = skb && skb_headlen(skb) >= 2 ?
+			get_unaligned_le16(skb->data) : 0;
+		__entry->seq = skb && skb_headlen(skb) >= 24 ?
+			get_unaligned_le16(skb->data + 22) : 0;
+		__entry->len = skb ? skb->len : 0;
+		__entry->pending = atomic_read(&ar->num_pending_mgmt_tx);
+	),
+	TP_printk("device=%s wiphy=%s phase=%s pdev=%u desc=%d vdev=%d result=%lld freq=%u agnostic=%u ack_id=%d link=%d fc=0x%04x seq=0x%04x len=%u pending=%d",
+		  __get_str(device), __get_str(wiphy), __get_str(phase),
+		  __entry->pdev, __entry->desc, __entry->vdev, __entry->result,
+		  __entry->freq, __entry->agnostic, __entry->ack_id, __entry->link,
+		  __entry->fc, __entry->seq, __entry->len, __entry->pending)
+);
+
+#endif
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH .
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE mgmt_trace
+#include <trace/define_trace.h>
