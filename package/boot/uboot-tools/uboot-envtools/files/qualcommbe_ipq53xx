#!/bin/sh
# Acer Wave 7 stores its U-Boot environment in the Qualcomm APPSBLENV
# NAND partition. The size/sector layout matches the vendor's
# ubootenv_mtdinfo() configuration; resolve the MTD index by name.
[ -e /etc/config/ubootenv ] && [ -s /etc/fw_env.config ] && exit 0

. /lib/functions.sh
. /lib/uboot-envtools.sh

case "$(board_name)" in
	acer,wave7)
		if [ ! -e /etc/config/ubootenv ]; then
			touch /etc/config/ubootenv
			ubootenv_add_mtd "0:appsblenv" "0x0" "0x40000" "0x20000" "0x2"
		fi
		config_load ubootenv
		config_foreach ubootenv_add_app_config
		;;
esac

exit 0
